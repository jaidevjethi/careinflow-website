    "@fontsource-variable/manrope": "^5.2.5",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "potrace": "^2.1.8",
    "typescript": "^5.8.3"
  }
