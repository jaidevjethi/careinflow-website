{
  "name": "careinflow-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "CareInflow — healthcare-focused web design & digital growth studio. Websites, local SEO, and Google Business Profile management for clinics in North Gujarat.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
