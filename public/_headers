# Cloudflare Pages security and caching headers (ignored by GitHub Pages).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # script-src is 'self' with no 'unsafe-inline'. Both of the site's scripts
  # are emitted as files under /_astro (vite assetsInlineLimit: 0), and the
  # estimator reads its rates from an application/json block, which is inert
  # and needs no allowance. 'unsafe-inline' in script-src is the one grant
  # that makes a policy close to worthless, so it is worth the two requests.
  #
  # style-src keeps it: Astro inlines critical CSS and Tailwind emits a few
  # arbitrary-value styles as attributes, neither of which can be hashed from
  # a static build.
  # frame-src names the two frames this site will embed, and neither of them
  # loads eagerly. The Google Map is lazy — loading="lazy" at the bottom of the
  # footer, several screens below the fold, see MapPanel.astro — and the
  # Calendly calendar sits behind a button on /contact, see BookingPanel.astro.
  # (This comment used to say the map was on /contact and gated behind a button.
  # It is in the footer of every page, and it is not gated.)
  # Nothing else is framed, and frame-ancestors 'none' still means nothing may
  # frame us.
  #
  # *.clarity.ms and c.bing.com are Microsoft Clarity (heatmaps and session
  # replay). Our own loader is a bundled file under /_astro and needs nothing
  # here; the tag it fetches from www.clarity.ms does, and Clarity then posts
  # what it records back to a lettered subdomain it picks at runtime, which is
  # why this is a wildcard rather than a fixed host. c.bing.com carries one
  # image beacon. This is a real widening of the policy and it was a real
  # decision: the Cloudflare beacon was refused rather than admitted for the
  # same reason (docs/launch/pre-launch-audit.md), so /privacy now says so.
  #
  # assets.calendly.com and calendly.com are the booking calendar. Calendly's
  # own community threads say the widget needs 'unsafe-eval' and 'unsafe-inline'
  # in script-src. It does not, and that was worth checking rather than
  # believing: widget.js is under 12KB, calls neither eval() nor new Function(),
  # injects no stylesheet, and only ever sets inline style ATTRIBUTES, which the
  # 'unsafe-inline' already in style-src covers. One script host and one frame
  # host is the whole cost. Whatever the booking frame loads inside itself is
  # governed by calendly.com's policy rather than ours, so img-src is untouched.
  #
  # If Clarity ever logs a violation the console names a directive: replay
  # fonts arrive as data: URIs on some builds (font-src), and some versions
  # spawn a blob: worker (worker-src). Neither is admitted here until it is
  # actually seen, because a policy widened on speculation stops being one.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.clarity.ms https://assets.calendly.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://*.clarity.ms https://c.bing.com; frame-src https://www.google.com https://calendly.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed filenames, so these can never go stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: always revalidate. A price change should reach visitors immediately
# rather than sit behind a cached copy of the figure it replaced.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root assets keep their filename when the file behind them changes, so they
# get a day rather than a year.
/og-default.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/logo.svg
  Cache-Control: public, max-age=86400
/logo-light.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

# Generated text surfaces. Short cache — llms.txt carries the price list.
/llms.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600
