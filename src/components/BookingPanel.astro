---
import { BOOKING_URL } from '@/config/site';
import { ACCENTS } from '@/lib/accents';

/**
 * The booking control.
 *
 * Calendly opens in a tab of its own rather than in a frame on this page. It
 * was embedded, and at the width this section allows it measured 880x700 and
 * never sent the resize message its own widget listens for, so the booking UI
 * scrolled inside its own box. Calendly's page is responsive and gets the
 * whole viewport, which is the sizing a frame here could not give it.
 *
 * The useful side effect: nothing of Calendly's loads on this site at all. No
 * third-party script, no frame, and public/_headers keeps the CSP it had
 * before the embed — no script host and no frame host to grant. /privacy says
 * so, and can go on saying it.
 */

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-center gap-x-6 gap-y-3 rounded-2xl border border-line p-6 sm:p-7',
    ACCENTS.gbp.tint,
    className,
  ]}
>
  <a
    href={BOOKING_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-accent px-7 py-4 text-[17px]"
  >
    Open the calendar
  </a>
  <p class="text-[14px] leading-[1.6] text-body-deep">Opens Calendly in a new tab.</p>
</div>
