---
/**
 * The three monthly content packages, read straight from `pricing.ts`.
 *
 * Used twice — inside the healthcare content page's prose and in the #content
 * section of /pricing — so the figures, the counts and the introductory line
 * can only ever be written once. The counts are the product: so many reels, so
 * many posts, so many carousels. They get the site's one ornament, a large
 * tight numeral in the accent, because "8 reels" is the thing a doctor is
 * actually buying and should be the first thing their eye lands on.
 *
 * The regular price is always the headline figure. The introductory rate sits
 * under it as a sentence with both numbers in it, never alone and never as a
 * saving — the one reduced figure the site publishes, stated as a rule.
 *
 * Inside MDX this renders under `.prose-ci`, whose element rules (link colour,
 * heading and paragraph margins, list bullets) would otherwise restyle it.
 * Those rules live in the components layer and Tailwind's utilities layer
 * comes after it, so every element here sets the properties prose would touch
 * with a utility, and the cascade does the rest. No lists, for the same reason.
 */
import {
  CONTENT_BATCH_REASON,
  CONTENT_INTRO_RULE,
  CONTENT_PACKAGES,
  rupees,
  type ContentPackage,
} from '@/config/pricing';
import { whatsappWithMessage } from '@/config/site';
import { ACCENTS } from '@/lib/accents';

interface Props {
  /** h3 inside a section that already has its h2; h2 if it ever stands alone. */
  headingLevel?: 'h2' | 'h3';
  class?: string;
}
const { headingLevel = 'h3', class: className } = Astro.props;
const Heading = headingLevel;
const a = ACCENTS.social;

/** The opening names the package, so nobody has to explain which one. */
const askAbout = (name: string) =>
  whatsappWithMessage(
    `Hi CareInflow. I am looking at ${name} for my practice and would like to talk it through. Clinic name: `,
  );

const counts = (p: ContentPackage) =>
  [
    { n: p.reels, one: 'reel', many: 'reels' },
    { n: p.posts, one: 'post', many: 'posts' },
    { n: p.carousels, one: 'carousel', many: 'carousels' },
  ]
    .filter((c) => c.n > 0)
    .map((c) => ({ n: c.n, label: c.n === 1 ? c.one : c.many }));
---

<div class:list={['not-prose', className]}>
  {/* Three across from lg only. At tablet width two columns would strand the
      third package alone on a row, and three columns there leave ~190px, which
      the price line does not survive. Three into three divides evenly. */}
  <div class="grid items-stretch gap-5 lg:grid-cols-3">
    {CONTENT_PACKAGES.map((p) => (
      <article
        class:list={[
          'card-hover flex h-full flex-col overflow-hidden rounded-3xl border bg-surface',
          p.recommended ? 'border-surgical shadow-card' : 'border-line',
        ]}
      >
        <span class:list={['accent-bar block h-1 w-full', a.bar]} aria-hidden="true"></span>
        <div class="flex h-full flex-col p-6">
          <div class="lg:min-h-[26px]">
            {p.recommended && (
              <span class="chip bg-surgical-tint text-surgical">Our recommendation</span>
            )}
          </div>
          <Heading class="mb-0 mt-2.5 text-[19px] font-bold leading-[1.3] tracking-[-0.025em] text-ink">
            {p.name}
          </Heading>
          <p class="mb-0 mt-1.5 text-[14px] leading-[1.5] text-muted lg:min-h-[42px]">{p.suits}</p>

          {/* The month, as counts. A grid of three cells on every card, so the
              numbers line up across the row even where Starter has no carousel. */}
          <div class="mt-5 grid grid-cols-3 gap-2 border-t border-hairline pt-4">
            {counts(p).map((c) => (
              <p class="mb-0">
                <span class:list={['numeral block text-[34px] leading-none', a.text]}>{c.n}</span>
                <span class="mt-1.5 block font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
                  {c.label}
                </span>
              </p>
            ))}
          </div>

          <p class="mb-0 mt-5 flex items-baseline gap-2 border-t border-hairline pt-4">
            <span class="settle numeral text-[clamp(28px,2.6vw,34px)] text-ink">{rupees(p.monthly)}</span>
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">/ month</span>
          </p>
          <p class="mb-0 mt-2 grow text-[14px] leading-[1.5] text-body">
            {rupees(p.intro)} a month for your first three billed months, then {rupees(p.monthly)}.
          </p>

          <a
            href={askAbout(p.name)}
            rel="noopener"
            class:list={[
              'mt-5 w-full justify-center px-5 py-3 text-[15px] no-underline hover:no-underline',
              p.recommended ? 'btn-primary text-surface' : 'btn-secondary text-ink',
            ]}
          >
            Start with this
          </a>
        </div>
      </article>
    ))}
  </div>
  <p class="mb-0 mt-6 max-w-[760px] text-[15px] leading-[1.6] text-muted">
    {CONTENT_INTRO_RULE} {CONTENT_BATCH_REASON}
  </p>
</div>
