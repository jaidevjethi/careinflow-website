---
import { BUSINESS, whatsappFor, type PrefillKey } from '@/config/site';
import { href } from '@/lib/url';

/**
 * The closing CTA card — used word for word across pages, as the design
 * system specifies ("the same white CTA card as the homepage").
 * `prefill` tailors the WhatsApp opening message to the page's context;
 * `nextStep` chains the funnel to the page a convinced visitor reads next.
 */
interface Props {
  prefill?: PrefillKey;
  nextStep?: { label: string; href: string };
}
const { prefill = 'default', nextStep } = Astro.props;
const whatsappHref = whatsappFor(prefill);

const reviewCovers = [
  'Listing accuracy',
  'Mobile load time',
  'Treatment page coverage',
  'Review handling',
  'AI answer readiness',
  'The three clinics above you',
];
---

<section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 sm:py-[120px] xl:px-20" aria-labelledby="cta-heading">
  <div class="grid items-center gap-10 rounded-[28px] border border-line bg-surface p-8 shadow-card-lg sm:p-12 lg:grid-cols-[1fr_380px] lg:gap-16 lg:p-16">
    <div>
      <h2 id="cta-heading" class="text-[clamp(32px,4.8vw,52px)] font-extrabold leading-[1.04] tracking-[-0.045em] text-ink">
        Send your clinic's name. We reply with what a patient sees.
      </h2>
      <p class="mt-5 max-w-[560px] text-lg leading-[1.62] text-body">
        One WhatsApp message — no form, no call, no deck. You get a written
        review of the specific things costing you patients, and if the answer
        is "change nothing", we will say that.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4.5">
        <a href={whatsappHref} rel="noopener" class="btn-primary px-7 py-4 text-[17px]">
          WhatsApp {BUSINESS.phoneDisplay}
        </a>
        <p class="text-[14.5px] leading-normal text-faint">
          Usually answered<br />the same day.
        </p>
      </div>
      {nextStep && (
        <p class="mt-6 text-[14.5px] text-muted">
          Still reading first? <a href={href(nextStep.href)} class="prose-link">{nextStep.label} →</a>
        </p>
      )}
    </div>
    <div class="rounded-[20px] border border-line bg-canvas p-7">
      <h3 class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">The review covers</h3>
      <ul class="text-[14.5px] leading-[2.05] text-body-deep">
        {reviewCovers.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="mt-4 border-t border-line pt-3.5 font-mono text-[11px] uppercase tracking-[0.08em] text-surgical">
        Free · 2 working days
      </p>
    </div>
  </div>
</section>
