---
import { BUSINESS, FOOTER_GROUPS, WHATSAPP_URL } from '@/config/site';
import { href } from '@/lib/url';

const year = new Date().getFullYear();

/** Towns with a page of their own. The rest stay as plain text — a link that
    goes nowhere reads worse than no link. */
const AREA_PAGES: Record<string, string> = {
  Mehsana: '/areas/mehsana',
  Ahmedabad: '/areas/ahmedabad',
  Gandhinagar: '/areas/gandhinagar',
};
---

<footer class="panel-depth">
  <div class="section shell">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,320px)_1fr] lg:gap-20">
      <div class="max-w-sm">
        <div class="mb-4 flex items-center gap-2.5">
          <img
            src={href('/logo-light.svg')}
            alt=""
            width="28"
            height="26"
            loading="lazy"
            decoding="async"
            class="block h-6 w-auto"
          />
          <span class="text-lg font-extrabold tracking-[-0.03em] text-surface">CareInflow</span>
        </div>
        <p class="text-sm leading-[1.7] text-panel-text-faint">
          Websites, local SEO, and Google Business Profile management, for
          healthcare practices and nothing else.
        </p>
        <address class="mt-5 text-sm not-italic leading-[1.7] text-panel-text-faint">
          {BUSINESS.address.street},<br />
          {BUSINESS.address.locality}, {BUSINESS.address.region}, India<br />
          <a href={WHATSAPP_URL} rel="noopener" class="link-whatsapp-dark inline-block py-1">
            WhatsApp {BUSINESS.phoneDisplay}
          </a>
          ·
          <a href={`tel:${BUSINESS.phone}`} class="inline-block py-1 text-panel-text-dim hover:text-surface">Call</a>
        </address>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-10 sm:grid-cols-3 sm:gap-x-14 xl:grid-cols-5 xl:gap-x-12">
        {FOOTER_GROUPS.map((group) => (
          <div>
            <h2 class="label-mono mb-4 text-panel-text-faint">{group.title}</h2>
            <ul class="flex flex-col gap-1.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={href(link.href)}
                    class="inline-flex min-h-[24px] items-center text-sm text-panel-text-dim hover:text-surface"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="mt-14 border-t border-panel-divider pt-7">
      <p class="font-mono text-[11px] uppercase tracking-[0.1em] leading-[1.8] text-panel-text-faint">
        Based in Mehsana, Gujarat, working with healthcare practices across{' '}
        {BUSINESS.serviceAreas.map((city, i) => (
          <>
            {i > 0 && ' · '}
            {AREA_PAGES[city] ? (
              <a href={href(AREA_PAGES[city]!)} class="inline-block py-1.5 text-panel-text-dim hover:text-surface">{city}</a>
            ) : (
              city
            )}
          </>
        ))}
        {' '}and beyond
      </p>
      <p class="mt-3 text-[14px] text-panel-text-faint">
        © {year} {BUSINESS.name}. Built by hand in Mehsana, this site is our own best evidence.
      </p>
    </div>
  </div>
</footer>
