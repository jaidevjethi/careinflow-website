---
import { BUSINESS, FOOTER_GROUPS, WHATSAPP_URL } from '@/config/site';
import { href } from '@/lib/url';

const year = new Date().getFullYear();
---

<footer class="panel-depth">
  <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-10 sm:py-20 xl:px-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:gap-24">
      <div class="max-w-md">
        <div class="mb-4 flex items-center gap-2.5">
          <img
            src={href('/logo-light.svg')}
            alt=""
            width="28"
            height="26"
            loading="lazy"
            decoding="async"
            class="block h-6 w-auto"
          />
          <span class="text-lg font-extrabold tracking-[-0.03em] text-surface">CareInflow</span>
        </div>
        <p class="text-sm leading-[1.7] text-panel-text-faint">
          Websites, local SEO, and Google Business Profile management — for
          healthcare practices and nothing else.
        </p>
        <address class="mt-5 text-sm not-italic leading-[1.7] text-panel-text-faint">
          {BUSINESS.address.street},<br />
          {BUSINESS.address.locality}, {BUSINESS.address.region}, India<br />
          <a href={WHATSAPP_URL} rel="noopener" class="text-panel-text-dim hover:text-surface">{BUSINESS.phoneDisplay}</a>
          ·
          <a href={`mailto:${BUSINESS.email}`} class="text-panel-text-dim hover:text-surface">{BUSINESS.email}</a>
        </address>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-10 sm:grid-cols-3 sm:gap-16">
        {FOOTER_GROUPS.map((group) => (
          <div>
            <h2 class="label-mono mb-4 text-panel-text-faint">{group.title}</h2>
            <ul class="flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a href={href(link.href)} class="text-sm text-panel-text-dim hover:text-surface">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="mt-14 border-t border-panel-divider pt-7">
      <p class="font-mono text-[10.5px] uppercase tracking-[0.1em] leading-[1.8] text-panel-text-faint">
        Based in Mehsana, Gujarat — working with healthcare practices across {BUSINESS.serviceAreas.join(' · ')} and beyond
      </p>
      <p class="mt-3 text-[13px] text-panel-text-faint">
        © {year} {BUSINESS.name}. Built by hand in Mehsana — this site is our own best evidence.
      </p>
    </div>
  </div>
</footer>
