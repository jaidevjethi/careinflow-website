---
import { NAV_ITEMS } from '@/config/site';
import { href } from '@/lib/url';

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (itemHref: string) => currentPath === itemHref || currentPath.startsWith(`${itemHref}/`);
---

<header class="sticky top-0 z-50 border-b border-panel-line bg-panel">
  <div class="shell flex h-[72px] items-center justify-between">
    <a
      href={href('/')}
      id="site-home"
      class="flex items-center gap-2.5 hover:no-underline"
      aria-label="CareInflow, home"
    >
      <img
        src={href('/logo-light.svg')}
        alt=""
        width="30"
        height="28"
        decoding="async"
        class="block h-7 w-auto"
      />
      <span class="text-[19px] font-extrabold tracking-[-0.03em] text-surface">CareInflow</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1.5 lg:flex">
      {NAV_ITEMS.map((item) => (
        <a
          href={href(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-[10px] px-3.5 py-2 text-[15px] font-semibold transition-colors duration-200 hover:bg-panel-card hover:text-surface hover:no-underline',
            isActive(item.href) ? 'text-panel-accent' : 'text-panel-text',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={href('/contact')} class="btn-cta ml-2.5 px-5 py-[11px] text-sm">
        Contact us
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="flex size-11 items-center justify-center rounded-[10px] border border-panel-line text-surface lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Menu</span>
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main menu" class="hidden border-t border-panel-line bg-panel px-5 pb-6 pt-3 lg:hidden!">
    <ul class="flex flex-col">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="block rounded-[10px] px-3 py-3 text-[16px] font-semibold text-surface hover:bg-panel-card hover:no-underline"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-3">
        <a href={href('/contact')} class="btn-cta w-full px-5 py-3.5 text-[16px]">
          Contact us
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });

  /**
   * On the homepage the logo returns you to the top rather than reloading the
   * page you are already on. Everywhere else it stays an ordinary link, so
   * middle-click, ctrl-click and "open in new tab" all keep working — which is
   * why this is a click handler on a real href rather than a button.
   *
   * `scrollTo` is called without a `behavior`, so it inherits the CSS
   * `scroll-behavior` on :root. That is `smooth` normally and `auto` under
   * prefers-reduced-motion, so the motion rule is honoured without this script
   * knowing anything about it.
   */
  const home = document.getElementById('site-home') as HTMLAnchorElement | null;
  const trim = (p: string) => p.replace(/\/+$/, '') || '/';
  home?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    if (trim(location.pathname) !== trim(new URL(home.href).pathname)) return;
    event.preventDefault();
    window.scrollTo({ top: 0, left: 0 });
  });
</script>
