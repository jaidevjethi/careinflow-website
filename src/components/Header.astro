---
import { NAV_ITEMS } from '@/config/site';
import { href } from '@/lib/url';

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (itemHref: string) => currentPath === itemHref || currentPath.startsWith(`${itemHref}/`);
---

<header class="sticky top-0 z-50 border-b border-hairline bg-surface">
  <div class="mx-auto flex h-[72px] max-w-[1440px] items-center justify-between px-5 sm:px-10 xl:px-20">
    <a href={href('/')} class="flex items-center gap-2.5 hover:no-underline" aria-label="CareInflow — home">
      <img
        src={href('/logo.svg')}
        alt=""
        width="30"
        height="28"
        decoding="async"
        class="block h-7 w-auto"
      />
      <span class="text-[19px] font-extrabold tracking-[-0.03em] text-ink">CareInflow</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1.5 lg:flex">
      {NAV_ITEMS.map((item) => (
        <a
          href={href(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-[10px] px-3.5 py-2 text-[14.5px] font-semibold transition-colors duration-200 hover:bg-canvas hover:text-ink hover:no-underline',
            isActive(item.href) ? 'text-ink' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={href('/free-review')} class="btn-primary ml-2.5 px-5 py-[11px] text-sm">
        Free website review
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="flex size-11 items-center justify-center rounded-[10px] border border-line text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Menu</span>
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main menu" class="hidden border-t border-hairline bg-surface px-5 pb-6 pt-3 lg:hidden!">
    <ul class="flex flex-col">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="block rounded-[10px] px-3 py-3 text-[16px] font-semibold text-ink hover:bg-canvas hover:no-underline"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-3">
        <a href={href('/free-review')} class="btn-primary w-full px-5 py-3.5 text-[15px]">
          Free website review
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
</script>
