---
import { NAV_ITEMS, SERVICE_MENU } from '@/config/site';
import { href } from '@/lib/url';

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (itemHref: string) => currentPath === itemHref || currentPath.startsWith(`${itemHref}/`);

/** The phone menu lists the services flat, in the same order as the panel. */
type ServiceLink = { label: string; href: string; note: string };
const serviceLinks: ServiceLink[] = SERVICE_MENU.flatMap((g): ServiceLink[] => [...g.items]);
---

<header class="sticky top-0 z-50 border-b border-panel-line bg-panel">
  <div class="shell flex h-[72px] items-center justify-between">
    <a
      href={href('/')}
      id="site-home"
      class="flex items-center gap-2.5 hover:no-underline"
      aria-label="CareInflow, home"
    >
      <img
        src={href('/logo-light.svg')}
        alt=""
        width="30"
        height="28"
        decoding="async"
        class="block h-7 w-auto"
      />
      <span class="text-[19px] font-extrabold tracking-[-0.03em] text-surface">CareInflow</span>
    </a>

    <nav aria-label="Main" class="relative hidden items-center gap-1.5 lg:flex">
      {NAV_ITEMS.map((item) =>
        item.href === '/services' ? (
          /*
            The one disclosure menu on the site. A button, not a link: it opens
            on click or Enter and never on hover, because a menu that appears
            under a passing cursor covers the page by accident and a phone has
            no hover at all. The last row links to /services itself, so the
            index is still one click away.

            The panel hangs from the right edge of the whole nav rather than
            from the button, so at the narrowest desktop width it still ends at
            the content edge instead of past the window.
          */
          <div data-services>
            <button
              type="button"
              id="services-toggle"
              aria-expanded="false"
              aria-controls="services-menu"
              class:list={[
                'group inline-flex items-center gap-1.5 rounded-[10px] px-3.5 py-2 text-[15px] font-semibold transition-colors duration-200 hover:bg-panel-card hover:text-surface aria-expanded:bg-panel-card aria-expanded:text-surface',
                isActive(item.href) ? 'text-panel-accent' : 'text-panel-text',
              ]}
            >
              {item.label}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="transition-transform duration-200 ease-instrument group-aria-expanded:rotate-180">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div
              id="services-menu"
              hidden
              class="absolute right-0 top-[calc(100%+24px)] w-[720px] animate-rise rounded-2xl border border-panel-line bg-panel p-3 shadow-card-lg"
            >
              <div class="grid grid-cols-3 gap-2">
                {SERVICE_MENU.map((g) => (
                  <div>
                    <p class="label-mono px-3.5 pb-1.5 pt-2.5 text-panel-text-faint">{g.group}</p>
                    <ul>
                      {g.items.map((s) => (
                        <li>
                          <a
                            href={href(s.href)}
                            aria-current={isActive(s.href) ? 'page' : undefined}
                            class="block rounded-xl px-3.5 py-2.5 transition-colors duration-200 hover:bg-panel-card hover:no-underline aria-[current=page]:bg-panel-card"
                          >
                            <span class="block text-[15px] font-semibold leading-[1.35] text-surface">{s.label}</span>
                            <span class="mt-0.5 block text-[13.5px] leading-[1.45] text-panel-text-dim">{s.note}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <a
                href={href('/services')}
                class="mt-2 flex items-center justify-between gap-4 rounded-xl border-t border-panel-divider px-3.5 py-3 text-[14px] font-semibold text-panel-accent hover:bg-panel-card hover:no-underline"
              >
                All services, and where to start
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ) : (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-[10px] px-3.5 py-2 text-[15px] font-semibold transition-colors duration-200 hover:bg-panel-card hover:text-surface hover:no-underline',
              isActive(item.href) ? 'text-panel-accent' : 'text-panel-text',
            ]}
          >
            {item.label}
          </a>
        ),
      )}
      <a href={href('/contact')} class="btn-cta ml-2.5 px-5 py-[11px] text-sm">
        Contact us
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="flex size-11 items-center justify-center rounded-[10px] border border-panel-line text-surface lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only" id="nav-toggle-label">Menu</span>
      {/* Two icons, one shown at a time, so the control's state is visible and
          not only announced. Toggled with the `hidden` class alongside
          aria-expanded — the same mechanism the menu itself uses. */}
      <svg
        data-nav-icon="closed"
        width="18"
        height="14"
        viewBox="0 0 18 14"
        fill="none"
        aria-hidden="true"
      >
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg
        data-nav-icon="open"
        width="18"
        height="14"
        viewBox="0 0 18 14"
        fill="none"
        aria-hidden="true"
        class="hidden"
      >
        <path d="M2 1l14 12M16 1L2 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  {/* Scrolls inside itself: with the services listed it is taller than a
      small phone's screen, and the header it hangs from is sticky, so without
      this the last links could never be scrolled into view. */}
  <nav id="mobile-nav" aria-label="Main menu" class="hidden max-h-[calc(100dvh-72px)] overflow-y-auto overscroll-contain border-t border-panel-line bg-panel px-5 pb-6 pt-3 lg:hidden!">
    <ul class="flex flex-col">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="block rounded-[10px] px-3 py-3 text-[16px] font-semibold text-surface hover:bg-panel-card hover:no-underline"
          >
            {item.label}
          </a>
          {/* On a phone the services sit open under their heading, indented,
              rather than behind a second toggle inside the first. */}
          {item.href === '/services' && (
            <ul class="mb-2 ml-3 border-l border-panel-line pl-2">
              {serviceLinks.map((s) => (
                <li>
                  <a
                    href={href(s.href)}
                    aria-current={isActive(s.href) ? 'page' : undefined}
                    class="block rounded-[10px] px-3 py-2.5 text-[15px] font-medium text-panel-text hover:bg-panel-card hover:text-surface hover:no-underline aria-[current=page]:text-panel-accent"
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="mt-3">
        <a href={href('/contact')} class="btn-cta w-full px-5 py-3.5 text-[16px]">
          Contact us
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const label = document.getElementById('nav-toggle-label');
  const icons = toggle?.querySelectorAll<SVGElement>('[data-nav-icon]');

  /**
   * The menu opens over the page on a phone, so it needs the three things any
   * disclosure needs and this one did not have: a state you can see as well as
   * hear, Escape to leave, and focus put back where it came from rather than
   * stranded on a control that is no longer there.
   */
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    if (label) label.textContent = open ? 'Close menu' : 'Menu';
    icons?.forEach((icon) => {
      icon.classList.toggle('hidden', (icon.dataset.navIcon === 'open') !== open);
    });
  };

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  // Escape closes it and returns focus to the button that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  // Following a link to the page you are already on leaves the menu covering
  // it, because nothing navigates. Close on activation rather than on unload.
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element | null)?.closest('a')) setOpen(false);
  });

  /**
   * The Services menu. A disclosure, so it needs exactly what the mobile menu
   * above needs: a visible state, Escape to leave with focus returned to the
   * button, and closing when the visitor's attention goes elsewhere: a click
   * outside it, or focus moving past its last link.
   */
  const servicesWrap = document.querySelector<HTMLElement>('[data-services]');
  const servicesToggle = document.getElementById('services-toggle');
  const servicesMenu = document.getElementById('services-menu');

  const setServices = (open: boolean) => {
    if (!servicesToggle || !servicesMenu) return;
    servicesToggle.setAttribute('aria-expanded', String(open));
    servicesMenu.hidden = !open;
  };
  const servicesOpen = () => servicesToggle?.getAttribute('aria-expanded') === 'true';

  servicesToggle?.addEventListener('click', () => setServices(!servicesOpen()));

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !servicesOpen()) return;
    setServices(false);
    servicesToggle?.focus();
  });

  document.addEventListener('click', (event) => {
    if (servicesOpen() && !servicesWrap?.contains(event.target as Node)) setServices(false);
  });

  servicesWrap?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null;
    if (next && !servicesWrap.contains(next)) setServices(false);
  });

  /**
   * On the homepage the logo returns you to the top rather than reloading the
   * page you are already on. Everywhere else it stays an ordinary link, so
   * middle-click, ctrl-click and "open in new tab" all keep working — which is
   * why this is a click handler on a real href rather than a button.
   *
   * `scrollTo` is called without a `behavior`, so it inherits the CSS
   * `scroll-behavior` on :root. That is `smooth` normally and `auto` under
   * prefers-reduced-motion, so the motion rule is honoured without this script
   * knowing anything about it.
   */
  const home = document.getElementById('site-home') as HTMLAnchorElement | null;
  const trim = (p: string) => p.replace(/\/+$/, '') || '/';
  home?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    if (trim(location.pathname) !== trim(new URL(home.href).pathname)) return;
    event.preventDefault();
    window.scrollTo({ top: 0, left: 0 });
  });
</script>
