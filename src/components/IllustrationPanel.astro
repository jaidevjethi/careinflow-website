---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Illustration on a tinted panel. The artwork ships on a white background;
 * `mix-blend-multiply` lets the panel's tint replace that white while the ink
 * line work stays dark, so there is no second frame and no pale rectangle
 * floating inside a border.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Tint utility from lib/accents, e.g. "bg-a-amber-tint". */
  tint: string;
  /** Hero illustrations only — everything else stays lazy. */
  eager?: boolean;
  /** Cap on the artwork width inside the panel. */
  maxWidth?: number;
  class?: string;
}

const {
  src,
  alt,
  tint,
  eager = false,
  maxWidth = 620,
  class: className,
} = Astro.props;
---

<figure
  class:list={[
    'm-0 flex items-center justify-center overflow-hidden rounded-3xl px-5 py-8 sm:px-8 sm:py-10',
    tint,
    className,
  ]}
>
  <Image
    {src}
    {alt}
    widths={[maxWidth, maxWidth * 1.5, maxWidth * 2]}
    sizes={`(min-width: 1024px) ${maxWidth}px, 88vw`}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    style={`max-width:${maxWidth}px`}
    class="h-auto w-full mix-blend-multiply"
  />
</figure>
