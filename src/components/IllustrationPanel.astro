---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Imagery container for the photographic 3D mockups.
 *
 * The render fills the container edge-to-edge inside a thin border. It carries
 * its own studio backdrop, so colour comes from the surrounding section rather
 * than from a tint behind the image.
 *
 * There used to be a second `blend` mode here for flat vector art on white,
 * tinted with `mix-blend-multiply`. Every illustration moved to the mockups,
 * no caller ever passed the prop, and the branch was unreachable.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Hero images only — everything else stays lazy. */
  eager?: boolean;
  /** Cap on the rendered width. */
  maxWidth?: number;
  class?: string;
}

const { src, alt, eager = false, maxWidth = 620, class: className } = Astro.props;
---

<!--
  `w-full` is what stops this shifting layout, and it has to stay. The figure
  used to take its width from its content, so a caller that made it a centred
  or end-aligned grid item turned it into a shrink-to-fit box that resolved to
  nothing until the lazy image arrived: it measured 0 tall, then snapped open
  and shoved the rest of the section down (0.219 CLS on /pricing). A definite
  width lets the browser reserve height from the img's own width/height
  attributes immediately, so alignment now belongs on the margins rather than
  on justify-self. Do not add an aspect-ratio here to "help" — it rounds
  against the image's natural height and overflow-hidden then clips a hairline
  off every illustration.
-->
<figure
  class:list={['m-0 w-full overflow-hidden rounded-3xl border border-line', className]}
  style={`max-width:${maxWidth}px`}
>
  <Image
    {src}
    {alt}
    widths={[maxWidth, maxWidth * 1.5, Math.min(maxWidth * 2, 1400)]}
    sizes={`(min-width: 1024px) ${maxWidth}px, 92vw`}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="block h-auto w-full"
  />
</figure>
