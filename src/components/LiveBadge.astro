---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p class="inline-flex max-w-full items-center gap-2.5 rounded-full border border-line bg-surface px-3.5 py-2">
  <span class="inline-block size-[7px] shrink-0 animate-live rounded-full bg-pass" aria-hidden="true"></span>
  <span class="min-w-0 font-mono text-[10px] uppercase tracking-[0.08em] text-body-deep sm:text-[11px] sm:tracking-[0.1em]">
    {text}
  </span>
</p>
