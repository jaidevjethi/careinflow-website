---
import { BUSINESS, GBP_URL, HOURS_LABEL } from '@/config/site';

/**
 * The studio on Google Maps.
 *
 * Shown by default rather than behind a button, which is a deliberate trade
 * and worth stating. A Maps iframe is third-party: it sets Google cookies and
 * pulls script and tiles from Google when it loads. Two things keep the cost
 * near zero anyway:
 *
 * - `loading="lazy"`. This sits at the bottom of the footer, several screens
 *   below the fold on every page. Nothing is requested until a visitor scrolls
 *   near it, so a reader who never reaches the footer pays nothing at all.
 * - A fixed aspect ratio rather than a fixed height, so the frame reserves its
 *   space before it loads and cannot shift the page. CLS stays at 0.
 *
 * Everything the map is for also exists as plain HTML beside it — the address,
 * directions, the listing — so the panel still works with the frame blocked,
 * failed, or never scrolled into view.
 *
 * The embed URL is the `pb=` form Google's own share dialog produces, pinned
 * to the place feature id so it survives the studio being re-pinned.
 */
const EMBED_SRC =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3655.6348323816474!2d72.3491067!3d23.6174258!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395c43110e8cd923%3A0x435194ce449cea4b!2sCareinflow!5e0!3m2!1sen!2sin!4v1786336292268!5m2!1sen!2sin';

/** Directions to the pin itself, not to a text search for the name. */
const DIRECTIONS = `https://www.google.com/maps/dir/?api=1&destination=${BUSINESS.geo.latitude},${BUSINESS.geo.longitude}&destination_place_id=ChIJI9mMDhFDXDkRS-qcRM6UUUM`;

interface Props {
  class?: string;
  /** Dark surroundings (the footer) need the light link treatment. */
  onPanel?: boolean;
}
const { class: className, onPanel = false } = Astro.props;
---

<figure class:list={['m-0', className]}>
  <div
    class:list={[
      'overflow-hidden rounded-2xl border',
      onPanel ? 'border-panel-line bg-panel-card' : 'border-line bg-canvas',
    ]}
  >
    <iframe
      src={EMBED_SRC}
      title="Google Map showing the CareInflow studio on Radhanpur Road, Mehsana"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      class="block aspect-[4/3] w-full border-0 sm:aspect-[16/10]"
    ></iframe>
  </div>

  <figcaption
    class:list={[
      'mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] leading-[1.6]',
      onPanel ? 'text-panel-text-faint' : 'text-muted',
    ]}
  >
    <span>{BUSINESS.address.locality} {BUSINESS.address.postalCode} · {HOURS_LABEL}</span>
    <a
      href={DIRECTIONS}
      rel="noopener"
      class:list={[
        'inline-flex min-h-[24px] items-center',
        onPanel ? 'text-panel-text-dim hover:text-surface' : 'prose-link',
      ]}
    >
      Get directions →
    </a>
    <a
      href={GBP_URL}
      rel="noopener"
      class:list={[
        'inline-flex min-h-[24px] items-center',
        onPanel ? 'text-panel-text-dim hover:text-surface' : 'prose-link',
      ]}
    >
      See the listing →
    </a>
  </figcaption>
</figure>
