---
import { CANONICAL_HOST, IS_CANONICAL_HOST, BUSINESS } from '@/config/site';
import { canonicalUrl } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  /** Site-relative path without base, e.g. "/services/local-seo". */
  path: string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  /**
   * Absolute URL of a page-specific share image. Case studies and articles
   * pass their own cover; everything else falls back to the default card.
   */
  image?: string;
  imageAlt?: string;
  /**
   * Pixel size of `image`. Only meaningful alongside it — a page that passes a
   * cover without dimensions gets no dimension tags rather than the default
   * card's, which would describe a different picture.
   */
  imageWidth?: number;
  imageHeight?: number;
  /** Keep the page out of the index (the 404, which is otherwise a soft 404). */
  noindex?: boolean;
}

/** public/og-default.png, as generated by scripts/generate-assets.mjs. */
const DEFAULT_OG = { width: 2500, height: 1313 };

const {
  title,
  description,
  path,
  ogType = 'website',
  publishDate,
  updatedDate,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noindex = false,
} = Astro.props;
const canonical = canonicalUrl(path);
const ogImage = image ?? `${CANONICAL_HOST}/og-default.png`;
const ogImageAlt =
  imageAlt ?? 'CareInflow, healthcare-focused web design and digital growth studio';
const ogSize = image
  ? imageWidth && imageHeight
    ? { width: imageWidth, height: imageHeight }
    : null
  : DEFAULT_OG;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/*
  max-image-preview:large is what lets Google use the full-width thumbnail, and
  max-snippet:-1 lets answer engines quote a whole answer rather than a clipped
  one, both matter more here than they would on a site with less to quote.

  `follow` either way, including on the mirror: the pages should still be
  crawled through so the canonicals on them are read, they just must not be
  indexed as a second copy of the site.
*/}
<meta
  name="robots"
  content={noindex || !IS_CANONICAL_HOST
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{/* Dimensions let a scraper lay the card out from the markup alone, instead
    of holding the render until it has fetched and decoded the image. */}
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="en_IN" />
{ogType === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{ogType === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
