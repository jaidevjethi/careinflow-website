---
interface Props {
  /** Plain-language mono label above the rule, e.g. "Where patients look". */
  label: string;
  title: string;
  lede?: string;
  dark?: boolean;
  /**
   * Set on the mid-tone bands (`band-sage`, `band-slate`). There, `body` reads
   * 4.35 against the ground and fails AA, while `ink` reads 7.85 — so the lede
   * has to come up to ink rather than sit in the usual text grey. Not needed on
   * `stone` or `mist`, where every text token still passes.
   */
  onBand?: boolean;
  /**
   * Heading level. Defaults to h2 — every page's h1 is written inline in its
   * own opener, so this has never needed to be anything else, but the prop
   * keeps the component honest if a section ever nests deeper.
   */
  as?: 'h2' | 'h3';
  /** Goes on the heading, for a section's aria-labelledby. */
  id?: string;
}
const { label, title, lede, dark = false, onBand = false, as: Tag = 'h2', id } = Astro.props;
---

<div class="max-w-[700px]">
  <div class:list={['tick-rule mb-3.5', dark && 'tick-rule-dark']} aria-hidden="true"></div>
  <p class:list={['label-mono mb-5', dark ? 'text-panel-accent' : 'text-surgical']}>{label}</p>
  <!-- id sits on the heading, not the wrapper: a section pointing at it with
       aria-labelledby should be named by the title, not by label + title + lede. -->
  <Tag
    {id}
    class:list={[
      'text-[clamp(30px,4.5vw,46px)] font-extrabold leading-[1.06] tracking-[-0.04em]',
      dark ? 'text-surface' : 'text-ink',
    ]}
  >
    {title}
  </Tag>
  {lede && (
    <p
      class:list={[
        'mt-4.5 text-lg leading-[1.62]',
        dark ? 'text-panel-text' : onBand ? 'text-ink/90' : 'text-body',
      ]}
    >
      {lede}
    </p>
  )}
</div>
