---
interface Props {
  /** Record-vocabulary label, e.g. "01 · TRIAGE — THE THREE SURFACES". */
  label: string;
  title: string;
  lede?: string;
  dark?: boolean;
  /** Heading level for the title (default h2). */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}
const { label, title, lede, dark = false, as: Tag = 'h2', id } = Astro.props as Props;
---

<div class="max-w-[700px]" {id}>
  <div class:list={['tick-rule mb-3.5', dark && 'tick-rule-dark']} aria-hidden="true"></div>
  <p class:list={['label-mono mb-5', dark ? 'text-panel-accent' : 'text-surgical']}>{label}</p>
  <Tag
    class:list={[
      'text-[clamp(30px,4.5vw,46px)] font-extrabold leading-[1.06] tracking-[-0.04em]',
      dark ? 'text-surface' : 'text-ink',
    ]}
  >
    {title}
  </Tag>
  {lede && (
    <p class:list={['mt-4.5 text-lg leading-[1.62]', dark ? 'text-panel-text' : 'text-body']}>
      {lede}
    </p>
  )}
</div>
