---
import { GOOGLE_CARE, WEBSITE_CARE, rupees } from '@/config/pricing';
import { ACCENTS } from '@/lib/accents';

/**
 * The two monthly plans, side by side, read straight from pricing.ts.
 *
 * This replaced a weekly / monthly / quarterly cadence that promised uptime
 * monitoring and a quarterly written review. Neither is in either plan's
 * published scope, so the diagram now shows exactly what each plan covers and
 * nothing it does not — which is also the question a practice reading the
 * website-care page is actually asking: which of these do I need?
 */
const plans = [
  {
    plan: WEBSITE_CARE,
    accent: ACCENTS.care,
    price: 'Custom monthly plan',
    lead: 'Your website, kept current and working.',
  },
  {
    plan: GOOGLE_CARE,
    accent: ACCENTS.seo,
    price: `${rupees(GOOGLE_CARE.monthly)} a month`,
    lead: 'Your Google listing, your local search and your website.',
  },
];
---

<div class="grid gap-3 sm:grid-cols-2">
  {plans.map(({ plan, accent, price, lead }) => (
    <div class="flex flex-col rounded-2xl border border-line bg-canvas p-5">
      <p class:list={['label-mono', accent.text]}>{price}</p>
      <p class="mt-2.5 text-[16px] font-bold tracking-[-0.02em] text-ink">{plan.name}</p>
      <p class="mt-1 text-[13.5px] leading-[1.5] text-muted">{lead}</p>
      <ul class="mt-3 grid list-none gap-1.5 border-t border-hairline p-0 pt-3">
        {plan.includes.map((item) => (
          <li class="flex gap-2.5 text-[14px] leading-[1.45] text-body">
            <span class:list={['mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full', accent.bar]} aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
<p class="mt-5 border-t border-hairline pt-4 text-[13.5px] leading-[1.55] text-muted">
  Most clinic websites are abandoned the day they go live. Either plan stops
  that; the difference is whether your Google listing and local search are
  looked after too.
</p>
