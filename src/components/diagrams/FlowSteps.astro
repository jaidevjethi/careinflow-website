---
import type { AccentName } from '@/lib/accents';
import { ACCENTS } from '@/lib/accents';

/**
 * A left-to-right sequence that stacks on a phone. The connector lives inside
 * its own list item (an <ol> may only contain <li>) and rotates with the
 * layout, so the arrow points along the reading direction at every width
 * rather than pointing sideways at a stacked column.
 */
interface Step {
  title: string;
  text: string;
  /** Optional short outcome, shown in the pass colour like a deliverable. */
  out?: string;
}
interface Props {
  steps: Step[];
  accent: AccentName;
  /** Marks the last step as the one the whole sequence exists to reach. */
  emphasiseLast?: boolean;
}
const { steps, accent, emphasiseLast = false } = Astro.props;
const a = ACCENTS[accent];
---

<ol class="flex list-none flex-col gap-3 p-0 sm:flex-row sm:items-stretch">
  {steps.map((s, i) => (
    <li class="flex flex-1 flex-col gap-3 sm:flex-row sm:items-center">
      <div
        class:list={[
          'flex h-full flex-1 flex-col rounded-2xl border p-4.5',
          emphasiseLast && i === steps.length - 1
            ? ['border-transparent', a.tint]
            : 'border-line bg-canvas',
        ]}
      >
        <p class="flex items-center gap-2">
          <span class:list={['label-mono', a.text]}>{String(i + 1).padStart(2, '0')}</span>
          <span class:list={['h-px flex-1', a.bar]} aria-hidden="true"></span>
        </p>
        <p class="mt-3 text-[15px] font-bold leading-[1.35] tracking-[-0.01em] text-ink">{s.title}</p>
        <p class="mt-1.5 text-[13.5px] leading-[1.5] text-muted">{s.text}</p>
        {s.out && (
          <p class="mt-auto pt-3 font-mono text-[10.5px] uppercase leading-[1.4] tracking-[0.06em] text-pass">
            {s.out}
          </p>
        )}
      </div>
      {i < steps.length - 1 && (
        <span class="mx-auto rotate-90 text-line-strong sm:mx-0 sm:rotate-0" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path
              d="M3 9h11M10 5l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      )}
    </li>
  ))}
</ol>
