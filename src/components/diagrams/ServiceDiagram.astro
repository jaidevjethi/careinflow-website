---
import DiagramFigure from './DiagramFigure.astro';
import FlowSteps from './FlowSteps.astro';
import ThreeFactors from './ThreeFactors.astro';
import ListingScan from './ListingScan.astro';
import CarePlans from './CarePlans.astro';
import ContentFanout from './ContentFanout.astro';

/**
 * One explanatory diagram per service, chosen by slug. Each restates something
 * the page's own prose already argues, so the diagram is a second reading of
 * the page rather than decoration bolted onto it. A service with nothing worth
 * diagramming renders nothing at all.
 */
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className } = Astro.props;

const FRAMES: Record<string, { label: string; title: string }> = {
  'healthcare-websites': {
    label: 'How it works',
    title: 'The path a worried patient takes, and the three jobs the site has along it.',
  },
  'local-seo': {
    label: 'How it works',
    title: 'What Google weighs when it decides which clinics appear.',
  },
  'google-business-profile': {
    label: 'How it works',
    title: 'The fixed order a patient reads your listing in, in about ten seconds.',
  },
  'website-care': {
    label: 'Two plans',
    title: 'What each monthly plan looks after, side by side.',
  },
  'social-media': {
    label: 'One recording',
    title: 'One eight-to-ten-minute explanation of gum disease, and what it can become.',
  },
  'reel-editing': {
    label: 'How it works',
    title: 'From your phone to a publish-ready reel, usually in one or two working days.',
  },
};

const frame = FRAMES[slug];

const websiteSteps = [
  {
    title: 'A search, at night',
    text: '"Dentist near me", on a mid-range Android, from someone a little worried.',
  },
  {
    title: 'Your treatment page',
    text: 'Not a services list. The page about the one thing they searched for.',
    out: 'Look professional',
  },
  {
    title: 'The question answered',
    text: 'What it involves, what affects the cost, what recovery feels like.',
    out: 'Answer the real question',
  },
  {
    title: 'One tap to you',
    text: 'A WhatsApp message already half-written, or tap to call.',
    out: 'Make the next step obvious',
  },
];

/*
 * The reel, as the four things that actually happen — four, like the website
 * diagram, because a row of five steps leaves ~100px a step at tablet width.
 * The doctor's part is the first step and the third; everything that needs an
 * editor is ours. The last step is theirs on purpose: we do not post, and the
 * diagram does not pretend otherwise.
 */
const reelSteps = [
  {
    title: 'You record and send',
    text: 'One question patients ask you, on your phone. The clip and the topic, on WhatsApp.',
  },
  {
    title: 'We edit',
    text: 'Pacing, captions, audio, colour, graphics, an end card, a cover and the caption written.',
    out: 'Usually 1–2 working days',
  },
  {
    title: 'You approve',
    text: 'You check it is medically right. One round of changes is included.',
    out: 'One revision',
  },
  {
    title: 'You publish',
    text: 'On your own account, when it suits you. The reel and the caption are ready to go.',
    out: 'Ready to post',
  },
];
---

{frame && (
  <DiagramFigure label={frame.label} title={frame.title} class={className}>
    {slug === 'healthcare-websites' && <FlowSteps steps={websiteSteps} accent="web" emphasiseLast />}
    {slug === 'local-seo' && <ThreeFactors />}
    {slug === 'google-business-profile' && <ListingScan />}
    {slug === 'website-care' && <CarePlans />}
    {slug === 'social-media' && <ContentFanout />}
    {slug === 'reel-editing' && <FlowSteps steps={reelSteps} accent="social" emphasiseLast />}
  </DiagramFigure>
)}
