---
/**
 * What the invoice bills, one row per line, grouped into one-time charges and
 * monthly plans so the two can never be read as one kind of money.
 *
 * A line shows its full price first. Each discount on it follows as its own
 * row, in the order it was applied, with what it is for and how it was
 * worked out ("₹300 each instead of the regular ₹699", "5 × ₹300"). A
 * reader can follow the figure down from the regular price to what is owed,
 * and nothing about a reduction is hidden inside a unit price.
 *
 * Discount rows are highlighted, because the owner wants every client to see
 * what they were given: a band of the brand's pale blue with a periwinkle
 * edge, and the label and figure in bold brand blue. Colour is never the only
 * signal: the band and the weight survive a grayscale print.
 */
import { ACCENTS } from '@/lib/accents';
import { formatMoney, unitSuffix, type ComputedInvoice, type ResolvedLine } from '@/lib/invoice';

interface Props {
  inv: ComputedInvoice;
}

const { inv } = Astro.props;
const money = (paise: number) => formatMoney(paise, inv.decimals);

const groups = [
  { label: 'One-time', lines: inv.lines.filter((l) => l.billing === 'once') },
  { label: 'Monthly, billed in advance', lines: inv.lines.filter((l) => l.billing === 'monthly') },
].filter((g) => g.lines.length > 0);

const quantity = (l: ResolvedLine): string =>
  l.instalment ? `${l.instalment.part} of ${l.instalment.of}` : String(Number(l.quantity.toFixed(2)));

const detail = (l: ResolvedLine): string | undefined => {
  const instalment = l.instalment
    ? `Instalment ${l.instalment.part} of ${l.instalment.of}${l.instalment.label ? `, ${l.instalment.label}` : ''}`
    : undefined;
  return [l.detail, instalment].filter(Boolean).join('. ') || undefined;
};

const th = 'label-mono pb-[2mm] align-bottom text-[7pt] font-medium text-muted';
---

<table class="inv-table mt-[4.5mm] w-full border-collapse text-left">
  <caption class="sr-only">Services billed on this invoice</caption>
  <thead>
    <tr class="border-b-[1.2pt] border-ink">
      <th scope="col" class={th}>Service</th>
      <th scope="col" class:list={[th, 'w-[16mm] text-right']}>Qty</th>
      <th scope="col" class:list={[th, 'w-[30mm] text-right']}>Unit price</th>
      <th scope="col" class:list={[th, 'w-[27mm] text-right']}>Amount</th>
    </tr>
  </thead>
  {groups.map((g) => (
    <>
      <tbody>
        <tr class="inv-group">
          <th scope="rowgroup" colspan="4" class="label-mono pb-[0.3mm] pt-[3mm] text-[7pt] font-medium text-surgical">
            {g.label}
          </th>
        </tr>
      </tbody>
      {g.lines.map((l) => (
        <tbody class="inv-item border-b border-hairline">
          <tr class="inv-line">
            <td class:list={['inv-desc pr-[4mm] pt-[1.9mm] align-top', l.discounts.length ? 'pb-[1mm]' : 'pb-[1.9mm]']}>
              <span class="flex items-start gap-[2.2mm]">
                <span
                  aria-hidden="true"
                  class:list={['mt-[1.35mm] size-[1.8mm] shrink-0 rounded-full', l.accent ? ACCENTS[l.accent].vivid : 'bg-rule']}
                ></span>
                <span class="min-w-0">
                  <span class="block font-semibold leading-[1.3] text-ink">{l.description}</span>
                  {detail(l) && <span class="mt-[0.4mm] block text-[8pt] leading-[1.4] text-body">{detail(l)}</span>}
                </span>
              </span>
            </td>
            <td class="inv-num inv-qty pt-[1.9mm] align-top" data-label="Qty">{quantity(l)}</td>
            <td class="inv-num inv-unit pt-[1.9mm] align-top" data-label="Unit price">
              {money(l.unitPrice)}
              {(l.instalment || unitSuffix(l.unit)) && (
                <span class="block text-[7pt] text-muted">{l.instalment ? 'project fee' : unitSuffix(l.unit)}</span>
              )}
            </td>
            <td class="inv-num inv-amt pt-[1.9mm] align-top font-semibold text-ink">{money(l.gross)}</td>
          </tr>
          {l.discounts.map((d, i) => (
            <tr class:list={['inv-adj bg-surgical-tint', i === l.discounts.length - 1 && 'inv-adj-last']}>
              <td
                colspan="3"
                class:list={[
                  // A border, not an inset shadow: a shadow is painted per cell and left
                  // a hairline seam between two discount rows in the PDF.
                  'border-l-[0.9mm] border-vivid pl-[3.1mm] pr-[4mm] align-top text-[8.5pt] leading-[1.35]',
                  i === 0 ? 'pt-[1.3mm]' : 'pt-[0.5mm]',
                  i === l.discounts.length - 1 ? 'pb-[1.3mm]' : 'pb-[0.5mm]',
                ]}
              >
                <span class="font-bold text-surgical">{d.label}</span>
                {d.note && <span class="text-body"> · {d.note}</span>}
              </td>
              <td
                class:list={[
                  'inv-num pr-[2mm] align-top text-[8.5pt] font-bold text-surgical',
                  i === 0 ? 'pt-[1.3mm]' : 'pt-[0.5mm]',
                  i === l.discounts.length - 1 ? 'pb-[1.3mm]' : 'pb-[0.5mm]',
                ]}
              >
                {money(-d.amount)}
              </td>
            </tr>
          ))}
        </tbody>
      ))}
    </>
  ))}
</table>
