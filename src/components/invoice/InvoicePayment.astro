---
/**
 * How to pay, and who to ask. The panel that turns the invoice into money, so
 * it carries the most direct copy on the page and nothing else.
 *
 * Every payment detail comes from the gitignored invoices/settings.json. When
 * one is missing, a dashed box says so in plain words. It is never filled with
 * an example: a placeholder that looks like a working UPI ID is a payment sent
 * to nobody.
 *
 * The WhatsApp code is real. Its number is the verified one in site.ts, the
 * same one every page of the website opens.
 */
import QrCode from './QrCode.astro';
import { BUSINESS } from '@/config/site';
import { invoiceWhatsapp, upiQrDataUri } from '@/config/invoice';
import { formatMoney, upiUri, type InvoiceSettings } from '@/lib/invoice';

interface Props {
  number: string;
  /** What is still owed, in paise. */
  balance: number;
  decimals: boolean;
  /** This invoice's own payment link, if it has one. */
  paymentLink?: string;
  settings: InvoiceSettings;
}

const { number, balance, decimals, paymentLink, settings } = Astro.props;

const qrImage = upiQrDataUri(settings);
const upiValue =
  !qrImage && settings.upiId
    ? upiUri({
        upiId: settings.upiId,
        payee: settings.payeeName ?? BUSINESS.name,
        note: `Invoice ${number}`,
        amountPaise: settings.upiIncludeAmount ? balance : undefined,
      })
    : undefined;
const link = paymentLink ?? settings.paymentLink;
const bank = settings.bank;
const whatsapp = invoiceWhatsapp(number);
const amount = formatMoney(balance, decimals);

const title = 'text-[9pt] font-bold leading-[1.3] text-ink';
const small = 'text-[8pt] leading-[1.45] text-body';
const placeholder =
  'flex items-center justify-center rounded-[2mm] border-[0.8pt] border-dashed border-line-strong bg-surface text-center label-mono text-[6.5pt] leading-[1.5] text-muted';
---

<section
  class="inv-avoid mt-[4.5mm] rounded-[3.5mm] border border-line bg-canvas px-[5mm] pb-[4mm] pt-[3mm]"
  aria-labelledby="inv-pay"
>
  <h2 id="inv-pay" class="label-mono text-[7pt] font-medium text-muted">How to pay</h2>

  <div class="inv-cols mt-[2.5mm] grid grid-cols-[30mm_minmax(0,1fr)_62mm] gap-[5.5mm]">
    <!-- UPI -->
    <div>
      {qrImage ? (
        <img src={qrImage} alt="UPI QR code to pay CareInflow" class="block size-[30mm] rounded-[1.5mm] bg-surface object-contain" />
      ) : upiValue ? (
        <QrCode value={upiValue} label="UPI QR code to pay CareInflow" class="size-[30mm] rounded-[1.5mm]" />
      ) : (
        <div class:list={[placeholder, 'size-[30mm] px-[2mm]']}>UPI QR code<br />to be added</div>
      )}
    </div>

    <!-- UPI words, the link, the bank, the reference -->
    <div class="flex flex-col gap-[2.5mm]">
      <div>
        <p class={title}>Pay by UPI</p>
        <p class={small}>Scan the code with Google Pay, PhonePe, Paytm or any UPI app.</p>
        {settings.upiId && (
          <p class="mt-[0.5mm] text-[8pt] text-body">
            UPI ID <span class="font-mono font-semibold text-ink">{settings.upiId}</span>
          </p>
        )}
      </div>

      <div>
        <p class={title}>Pay online</p>
        {link ? (
          <>
            <a
              href={link}
              rel="noopener"
              class="mt-[1mm] inline-flex items-center gap-[1.5mm] rounded-[2mm] bg-vivid px-[3mm] py-[1.5mm] text-[8.5pt] font-bold text-ink"
            >
              Pay {amount} online <span aria-hidden="true">→</span>
            </a>
            <p class="mt-[0.8mm] break-all font-mono text-[7pt] text-muted">{link.replace(/^https?:\/\//, '')}</p>
          </>
        ) : (
          <p class:list={[placeholder, 'mt-[1mm] h-[7mm] max-w-[58mm]']}>Payment link to be added</p>
        )}
      </div>

      <p class="text-[8pt] text-body">
        Payment note: <span class="font-mono font-semibold text-ink">{number}</span>
      </p>
    </div>

    <!-- WhatsApp -->
    <div class="border-l border-line pl-[5mm]">
      <p class={title}>Questions about this invoice?</p>
      <div class="mt-[2mm] flex items-start gap-[3mm]">
        <a href={whatsapp} rel="noopener" class="block shrink-0" aria-label="Message CareInflow on WhatsApp about this invoice">
          <QrCode value={whatsapp} label="QR code: message CareInflow on WhatsApp" class="size-[23mm] rounded-[1.5mm]" />
        </a>
        <p class={small}>
          Scan to message us on WhatsApp, or write to
          <a href={whatsapp} rel="noopener" class="block font-semibold whitespace-nowrap text-whatsapp-deep">{BUSINESS.phoneDisplay}</a>
        </p>
      </div>
    </div>
  </div>

  {bank && (
    <div class="mt-[3mm] border-t border-line pt-[2mm] text-[8pt] leading-[1.5] text-body">
      <span class="font-bold text-ink">Bank transfer</span>
      <dl class="inline">
        <dt class="ml-[2mm] inline text-muted">Name</dt> <dd class="inline text-ink">{bank.accountName}</dd>
        <dt class="ml-[3mm] inline text-muted">Account</dt> <dd class="inline font-mono text-ink">{bank.accountNumber}</dd>
        <dt class="ml-[3mm] inline text-muted">IFSC</dt> <dd class="inline font-mono text-ink">{bank.ifsc}</dd>
        <dt class="ml-[3mm] inline text-muted">Bank</dt> <dd class="inline text-ink">{bank.bankName}{bank.branch && `, ${bank.branch}`}</dd>
      </dl>
    </div>
  )}
</section>
