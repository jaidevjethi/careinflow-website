---
/**
 * The three places a patient meets a practice, layered the way they meet them
 * — the website behind, the Google listing in front of it, and the doctor's
 * reel on the phone in their hand. Three kinds of practice, not one: a skin
 * clinic, a pathology lab and a physiotherapist, each in Gujarati, because
 * healthcare is the category here, not dentistry.
 *
 * It opened the homepage hero for an afternoon (2026-10-08) and now opens the
 * homepage's "Where patients look" section instead: heroes take photographs,
 * and a drawing that explains three surfaces belongs where the page is
 * explaining them ("Pictures: what goes where", design skill). It has no
 * background panel of its own; the section frames it.
 */
import BrowserSite from './parts/BrowserSite.astro';
import ListingCard from './parts/ListingCard.astro';
import PhoneReel from './parts/PhoneReel.astro';

interface Props {
  class?: string;
  /** The ground it sits on, which decides the colour of its label. */
  tone?: 'dark' | 'light';
}
const { class: className, tone = 'dark' } = Astro.props;
const id = 'visual-hero';
const labelClass = tone === 'light' ? 'fill-faint' : 'fill-panel-text-faint';
---

<svg viewBox="0 0 560 470" role="img" aria-labelledby={id} class:list={['block h-auto w-full', className]} style="font-family: var(--font-sans)">
  <title id={id}>Illustration: a skin clinic's website in Gujarati, a pathology lab's Google listing in front of it, and a physiotherapist's reel with Gujarati captions on a phone.</title>
  <BrowserSite x={0} y={0} width={430} height={322.5} />
  <ListingCard x={20} y={262} width={286} height={195} />
  <PhoneReel x={384} y={98} width={168} height={348} />
  <text x="556" y="466" text-anchor="end" font-size="8.5" font-weight="700" letter-spacing="0.14em" class={labelClass} style="font-family: var(--font-mono)">ILLUSTRATIVE</text>
</svg>
