---
/**
 * A pathology lab's listing as a patient sees it in local search, with the
 * phone set to Gujarati: photographs, name, category, hours, the call /
 * directions / website buttons, services, and a review with the lab's reply
 * under it.
 *
 * Recognisable, deliberately not Google's: no logo, no Google colours, no
 * star rating. Stars would be a number, and a number on an illustration is
 * still an invented number. The reply bubble is the point instead — answering
 * reviews is part of the work.
 */
import { GU } from '../fonts';

interface Props {
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { x = 0, y = 0, width = 440, height = 300 } = Astro.props;

const photos = [
  { x: 16, w: 128 },
  { x: 152, w: 128 },
  { x: 288, w: 136 },
];

const actions = [
  { cx: 36, label: 'કૉલ' },
  { cx: 98, label: 'દિશા' },
  { cx: 160, label: 'વેબસાઇટ' },
];

const services = [
  { x: 232, y: 128, w: 74, label: 'બ્લડ ટેસ્ટ' },
  { x: 312, y: 128, w: 64, label: 'થાઇરોઇડ' },
  { x: 232, y: 156, w: 70, label: 'ડાયાબિટીસ' },
  { x: 308, y: 156, w: 92, label: 'ઘરેથી સેમ્પલ' },
];
---

<svg {x} {y} {width} {height} viewBox="0 0 440 300">
  <rect x="0.75" y="0.75" width="438.5" height="298.5" rx="16" class="fill-surface stroke-line" stroke-width="1.5" />

  {photos.map((p) => (
    <g>
      <rect x={p.x} y="16" width={p.w} height="72" rx="10" class="fill-powder" />
      <circle cx={p.x + p.w - 26} cy="36" r="7" class="stroke-line-strong" fill="none" stroke-width="2" />
      <path
        d={`M${p.x + 14} 76 L${p.x + 44} 48 L${p.x + 66} 66 L${p.x + 82} 55 L${p.x + p.w - 14} 76`}
        class="stroke-line-strong"
        fill="none"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"
      />
    </g>
  ))}

  <text x="16" y="118" font-size="18" font-weight="800" letter-spacing="-0.02em" class="fill-ink">Your Lab</text>
  <text x="16" y="137" font-size="11" class="fill-muted" font-family={GU}>પેથોલોજી લેબ · મહેસાણા</text>
  <text x="16" y="158" font-size="11" font-family={GU}><tspan font-weight="700" class="fill-a-gbp">ખુલ્લું</tspan><tspan class="fill-muted"> · સાંજે ૮ વાગ્યે બંધ</tspan></text>

  {actions.map((a, i) => (
    <g>
      <circle cx={a.cx} cy="190" r="16" class="fill-a-gbp-tint" />
      {i === 0 && <rect x={a.cx - 4.5} y="182" width="9" height="16" rx="2.5" class="stroke-a-gbp" fill="none" stroke-width="1.8" />}
      {i === 1 && (
        <path
          d={`M${a.cx} 181 L${a.cx + 9} 190 L${a.cx} 199 L${a.cx - 9} 190 Z M${a.cx - 3} 193 V189 H${a.cx + 3} M${a.cx + 1} 187 L${a.cx + 3} 189 L${a.cx + 1} 191`}
          class="stroke-a-gbp"
          fill="none"
          stroke-width="1.6"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      )}
      {i === 2 && (
        <g class="stroke-a-gbp" fill="none" stroke-width="1.6">
          <circle cx={a.cx} cy="190" r="8" />
          <ellipse cx={a.cx} cy="190" rx="3.5" ry="8" />
          <line x1={a.cx - 8} y1="190" x2={a.cx + 8} y2="190" />
        </g>
      )}
      <text x={a.cx} y="222" text-anchor="middle" font-size="9.5" font-weight="700" class="fill-muted" font-family={GU}>{a.label}</text>
    </g>
  ))}

  <!-- The details that have to match the website -->
  {[248, 266, 284].map((ry, i) => (
    <g>
      <circle cx="22" cy={ry - 3} r="5" class="fill-a-gbp-tint" />
      <rect x="34" y={ry - 6} width={[132, 104, 118][i]} height="5" rx="2.5" class="fill-line" />
    </g>
  ))}

  <text x="232" y="116" font-size="9.5" font-weight="700" class="fill-faint" font-family={GU}>સેવાઓ</text>
  {services.map((s) => (
    <g>
      <rect x={s.x} y={s.y} width={s.w} height="22" rx="11" class="fill-canvas stroke-line" stroke-width="1" />
      <text x={s.x + s.w / 2} y={s.y + 15} text-anchor="middle" font-size="9.5" font-weight="700" class="fill-ink" font-family={GU}>{s.label}</text>
    </g>
  ))}

  <text x="232" y="200" font-size="9.5" font-weight="700" class="fill-faint" font-family={GU}>રિવ્યૂ</text>
  <circle cx="242" cy="218" r="9" class="fill-line" />
  <rect x="258" y="212" width="120" height="5" rx="2.5" class="fill-line" />
  <rect x="258" y="222" width="88" height="5" rx="2.5" class="fill-line" />
  <rect x="232" y="236" width="192" height="48" rx="10" class="fill-a-gbp-tint" />
  <text x="244" y="255" font-size="10" font-weight="700" class="fill-a-gbp" font-family={GU}>લેબ તરફથી જવાબ</text>
  <rect x="244" y="263" width="150" height="5" rx="2.5" class="fill-line-strong" />
  <rect x="244" y="272" width="108" height="5" rx="2.5" class="fill-line-strong" />
</svg>
