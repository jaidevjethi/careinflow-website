---
/**
 * A local map: Mehsana's grid, Radhanpur Road running across it, other
 * clinics as grey pins, and one practice marked with the area it can draw
 * patients from. Relevance, distance and prominence, drawn as a place.
 */
interface Props {
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { x = 0, y = 0, width = 320, height = 356 } = Astro.props;

const blocks = [
  [24, 24, 72, 80],
  [124, 24, 84, 80],
  [236, 24, 60, 80],
  [24, 136, 72, 100],
  [236, 136, 60, 100],
  [24, 266, 72, 66],
  [124, 266, 84, 66],
  [236, 266, 60, 66],
];
const others = [
  [58, 188],
  [266, 302],
  [268, 82],
  [90, 72],
];
---

<svg {x} {y} {width} {height} viewBox="0 0 320 356">
  <rect x="0.75" y="0.75" width="318.5" height="354.5" rx="16" class="fill-surface stroke-line" stroke-width="1.5" />
  <rect x="10" y="10" width="300" height="336" rx="10" class="fill-canvas" />
  {blocks.map(([bx, by, bw, bh]) => (
    <rect x={bx} y={by} width={bw} height={bh} rx="6" class="fill-powder" />
  ))}

  <!-- Roads -->
  <g class="stroke-surface" stroke-linecap="round">
    <line x1="10" y1="120" x2="310" y2="120" stroke-width="12" />
    <line x1="10" y1="250" x2="310" y2="250" stroke-width="12" />
    <line x1="110" y1="10" x2="110" y2="346" stroke-width="12" />
    <line x1="222" y1="10" x2="222" y2="346" stroke-width="8" />
    <line x1="10" y1="312" x2="310" y2="62" stroke-width="10" />
  </g>
  <text
    x="0"
    y="0"
    font-size="7.5"
    font-weight="800"
    letter-spacing="0.14em"
    class="fill-faint"
    transform="translate(52 286) rotate(-39.8)"
  >RADHANPUR RD</text>

  <rect x="20" y="20" width="80" height="20" rx="10" class="fill-surface" />
  <text x="31" y="33.5" font-size="8" font-weight="800" letter-spacing="0.14em" class="fill-muted">MEHSANA</text>

  {others.map(([px, py]) => (
    <g>
      <circle cx={px} cy={py} r="6" class="fill-line-strong" />
      <circle cx={px} cy={py} r="2.2" class="fill-surface" />
    </g>
  ))}

  <!-- The practice, and the area it can reach -->
  <circle cx="170" cy="186" r="58" class="fill-a-seo-tint stroke-a-seo-vivid" stroke-width="1.5" stroke-dasharray="4 5" fill-opacity="0.75" />
  <path d="M170 202 C163 192 154 184 154 172 A16 16 0 1 1 186 172 C186 184 177 192 170 202 Z" class="fill-a-seo" />
  <circle cx="170" cy="172" r="6" class="fill-surface" />
  <rect x="190" y="194" width="98" height="22" rx="11" class="fill-surface stroke-line" stroke-width="1" />
  <text x="239" y="208.5" text-anchor="middle" font-size="9" font-weight="800" class="fill-ink">Your Practice</text>
</svg>
