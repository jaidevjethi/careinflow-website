---
/**
 * The same clinic website on a phone, with the call and WhatsApp bar fixed
 * along the bottom: the shape every CareInflow site takes on the phone most
 * patients hold.
 */
interface Props {
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { x = 0, y = 0, width = 144, height = 250 } = Astro.props;
---

<svg {x} {y} {width} {height} viewBox="0 0 144 250">
  <rect x="0.75" y="0.75" width="142.5" height="248.5" rx="22" class="fill-ink stroke-panel-line-alt" stroke-width="1.5" />
  <rect x="7" y="7" width="130" height="236" rx="16" class="fill-surface" />
  <rect x="56" y="12" width="32" height="5" rx="2.5" class="fill-ink" />

  <text x="17" y="37" font-size="9.5" font-weight="800" letter-spacing="-0.02em" class="fill-ink">Your Practice</text>
  <rect x="110" y="29" width="17" height="2.5" rx="1.25" class="fill-ink" />
  <rect x="110" y="34" width="17" height="2.5" rx="1.25" class="fill-ink" />

  <rect x="14" y="46" width="116" height="62" rx="8" class="fill-a-web-tint" />
  <rect x="22" y="56" width="84" height="8" rx="3" class="fill-ink" />
  <rect x="22" y="69" width="60" height="8" rx="3" class="fill-ink" />
  <rect x="22" y="84" width="90" height="4" rx="2" class="fill-line-strong" />
  <rect x="22" y="93" width="68" height="4" rx="2" class="fill-line-strong" />

  <rect x="14" y="117" width="116" height="56" rx="8" class="fill-canvas stroke-hairline" stroke-width="1" />
  <circle cx="30" cy="133" r="8" class="fill-a-web-tint" />
  <text x="44" y="136" font-size="8.5" font-weight="800" class="fill-ink">Root canal</text>
  <rect x="22" y="150" width="96" height="4" rx="2" class="fill-line" />
  <rect x="22" y="159" width="70" height="4" rx="2" class="fill-line" />
  <rect x="14" y="181" width="116" height="20" rx="8" class="fill-canvas stroke-hairline" stroke-width="1" />

  <!-- The bar that never scrolls away -->
  <path d="M7 209 H137 V227 A16 16 0 0 1 121 243 H23 A16 16 0 0 1 7 227 Z" class="fill-panel" />
  <rect x="15" y="215" width="64" height="20" rx="10" class="fill-whatsapp" />
  <text x="47" y="228.5" text-anchor="middle" font-size="7.5" font-weight="800" class="fill-ink">WhatsApp</text>
  <rect x="85" y="215" width="44" height="20" rx="10" class="fill-panel-card" />
  <text x="107" y="228.5" text-anchor="middle" font-size="7.5" font-weight="800" class="fill-surface">Call</text>
</svg>
