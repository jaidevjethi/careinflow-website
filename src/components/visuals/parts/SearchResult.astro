---
/**
 * One search, and the treatment page that answers it. The query is the kind a
 * parent types — a need and a town, in Gujarati — not a brand name, and the
 * result is the page written to answer exactly that.
 */
import { GU } from '../fonts';

interface Props {
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { x = 0, y = 0, width = 304, height = 104 } = Astro.props;
---

<svg {x} {y} {width} {height} viewBox="0 0 304 104">
  <rect x="0.75" y="0.75" width="302.5" height="102.5" rx="14" class="fill-surface stroke-line" stroke-width="1.5" />
  <circle cx="22" cy="21" r="6" class="stroke-faint" fill="none" stroke-width="1.6" />
  <line x1="26.5" y1="25.5" x2="30.5" y2="29.5" class="stroke-faint" stroke-width="1.6" stroke-linecap="round" />
  <text x="38" y="25.5" font-size="11.5" font-weight="700" class="fill-ink" font-family={GU}>મહેસાણામાં બાળકોના ડૉક્ટર</text>
  <line x1="14" y1="38" x2="290" y2="38" class="stroke-hairline" stroke-width="1" />
  <circle cx="22" cy="54" r="6" class="fill-a-seo-tint" />
  <text x="34" y="57" font-size="8" class="fill-muted">yourpractice.in › vaccination</text>
  <text x="16" y="75" font-size="12" font-weight="700" class="fill-a-seo" font-family={GU}>બાળકોનું રસીકરણ · મહેસાણા</text>
  <rect x="16" y="83" width="230" height="4.5" rx="2" class="fill-line" />
  <rect x="16" y="92" width="176" height="4.5" rx="2" class="fill-line" />
</svg>
