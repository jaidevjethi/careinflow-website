---
/**
 * A treatment page: the page a search lands on. Cost, recovery and questions
 * answered, and the WhatsApp button under them.
 */
interface Props {
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { x = 0, y = 0, width = 176, height = 206 } = Astro.props;

const chips = [
  { x: 14, w: 38, label: 'Cost' },
  { x: 58, w: 58, label: 'Recovery' },
  { x: 122, w: 38, label: 'FAQ' },
];
---

<svg {x} {y} {width} {height} viewBox="0 0 176 206">
  <rect x="0.75" y="0.75" width="174.5" height="204.5" rx="14" class="fill-surface stroke-line" stroke-width="1.5" />
  <path d="M14 0.75 H162 A13.25 13.25 0 0 1 175.25 14 V20 H0.75 V14 A13.25 13.25 0 0 1 14 0.75 Z" class="fill-canvas" />
  <circle cx="14" cy="11" r="3" class="fill-line-strong" />
  <circle cx="24" cy="11" r="3" class="fill-line-strong" />
  <circle cx="34" cy="11" r="3" class="fill-line-strong" />
  <text x="14" y="42" font-size="7" font-weight="800" letter-spacing="0.14em" class="fill-faint">TREATMENT</text>
  <text x="14" y="61" font-size="15" font-weight="800" letter-spacing="-0.02em" class="fill-ink">Root canal</text>
  {chips.map((c) => (
    <g>
      <rect x={c.x} y="71" width={c.w} height="18" rx="9" class="fill-a-seo-tint" />
      <text x={c.x + c.w / 2} y="83" text-anchor="middle" font-size="8" font-weight="800" class="fill-a-seo">{c.label}</text>
    </g>
  ))}
  <rect x="14" y="102" width="148" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="112" width="132" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="122" width="140" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="132" width="96" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="146" width="148" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="156" width="110" height="4.5" rx="2" class="fill-line" />
  <rect x="14" y="172" width="86" height="21" rx="10.5" class="fill-whatsapp" />
  <text x="57" y="185.5" text-anchor="middle" font-size="8" font-weight="800" class="fill-ink">WhatsApp</text>
</svg>
