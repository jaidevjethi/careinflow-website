---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { whatsappFor } from '@/config/site';
import { href } from '@/lib/url';
// Hashed URLs so the fonts can be preloaded — otherwise the browser only
// discovers them after the stylesheet has parsed.
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Site-relative path without base, e.g. "/services/local-seo". */
  path: string;
  /** Composed JSON-LD document (graph(...)); rendered once per page. */
  schema?: object;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  /** Absolute URL of a page-specific share image (case studies, articles). */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  schema,
  ogType,
  publishDate,
  updatedDate,
  image,
  imageAlt,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Matches --color-panel. This is the browser chrome around the page on a
         phone, so it has to be the same navy the header is, or the app frame
         and the site are two different colours. It was still #0A1628, from two
         palettes ago, which nothing else on the site had used in months. -->
    <meta name="theme-color" content="#0B2440" />
    <link rel="preload" as="font" type="font/woff2" href={manropeWoff2} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={monoWoff2} crossorigin="anonymous" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="CareInflow, guides for clinic owners"
      href={href('/rss.xml')}
    />
    <SEO {title} {description} {path} {ogType} {publishDate} {updatedDate} {image} {imageAlt} {noindex} />
    {schema && <JsonLd data={schema} />}
  </head>
  <body class="pb-[60px] sm:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-[10px] focus:bg-vivid focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Mobile-only sticky CTA bar. A labelled landmark, not a bare div, so it
         is reachable and named rather than floating outside the page structure. -->
    <nav
      aria-label="Quick contact"
      class="fixed inset-x-0 bottom-0 z-40 flex h-[60px] items-center justify-between gap-3 border-t border-panel-line bg-panel px-4 sm:hidden"
    >
      <a
        href={href('/free-review')}
        class="flex min-h-[24px] min-w-0 items-center truncate text-[14px] font-semibold text-surface"
      >
        Free written review · 2 days
      </a>
      <a href={whatsappFor('default')} rel="noopener" class="btn-accent shrink-0 px-4.5 py-2.5 text-[14px]">
        WhatsApp us
      </a>
    </nav>
  </body>
</html>
