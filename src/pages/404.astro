---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/url';

const title = 'Page not found | CareInflow';
const description = 'This page does not exist. Here are the ones that do.';

const links = [
  { label: 'Services', href: '/services', note: 'The four things we do' },
  { label: 'Work', href: '/work', note: 'Real projects, shown honestly' },
  { label: 'Method', href: '/process', note: 'How a four-week build runs' },
  { label: 'Contact', href: '/contact', note: 'One WhatsApp message starts it' },
];
---

<BaseLayout {title} {description} path="/404">
  <section class="mx-auto max-w-[1440px] px-5 py-24 sm:px-10 sm:py-32 xl:px-20">
    <p class="label-mono mb-5 text-surgical">Status — 404</p>
    <h1 class="max-w-[760px] text-[clamp(34px,5vw,62px)] font-extrabold leading-[1.04] tracking-[-0.045em] text-ink">
      This page does not exist. No harm done.
    </h1>
    <p class="mt-6 max-w-[560px] text-lg leading-[1.62] text-body">
      The link was wrong or the page has moved. Everything worth finding is
      one click below.
    </p>
    <div class="mt-10 grid max-w-[720px] gap-4 sm:grid-cols-2">
      {links.map((l) => (
        <a href={href(l.href)} class="card-hover block rounded-[18px] border border-line bg-surface p-6 hover:no-underline">
          <h2 class="text-lg font-bold tracking-[-0.02em] text-ink">{l.label} →</h2>
          <p class="mt-1.5 text-[14.5px] text-muted">{l.note}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
