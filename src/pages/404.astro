---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { href } from '@/lib/url';

const title = 'Page not found | CareInflow';
const description = 'This page does not exist. Here are the ones that do.';

const links = [
  { label: 'Services', href: '/services', note: 'The four things we do' },
  { label: 'Work', href: '/work', note: 'Real projects, shown honestly' },
  { label: 'Method', href: '/process', note: 'How a four-week build runs' },
  { label: 'Contact', href: '/contact', note: 'One WhatsApp message starts it' },
];
---

<BaseLayout {title} {description} path="/404" noindex>
  <PageHero
    label="Page not found"
    title="This page does not exist. No harm done."
    lede="The link was wrong or the page has moved. Everything worth finding is one click below."
  />

  <section class="border-t border-hairline bg-surface" aria-label="Where to go instead">
    <div class="section shell">
      <div class="grid max-w-[880px] gap-4 sm:grid-cols-2">
        {links.map((l) => (
          <a href={href(l.href)} class="card-hover block rounded-[18px] border border-line bg-canvas p-6 hover:no-underline">
            <h2 class="text-lg font-bold tracking-[-0.02em] text-ink">{l.label} →</h2>
            <p class="mt-1.5 text-[14.5px] text-muted">{l.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
