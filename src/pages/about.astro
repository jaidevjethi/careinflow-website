---
import { getFaqsFor } from '@/lib/faqs';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import studioImage from '@/assets/editorial/founder-working.webp';
import founderImage from '@/assets/jaidev-jethi.jpg';
import SectionHead from '@/components/SectionHead.astro';
import Figure from '@/components/Figure.astro';
import consultImage from '@/assets/editorial/hero-founder-consult.webp';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { BUSINESS, CANONICAL_HOST } from '@/config/site';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  founderSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'About: a healthcare-only web studio in Mehsana | CareInflow';
const description =
  'Who is behind CareInflow: founder Jaidev Jethi, and why a studio in Mehsana works with healthcare practices and nothing else.';

const faqs = await getFaqsFor('about');

const schema = graph(
  organizationSchema(),
  founderSchema(new URL(founderImage.src, CANONICAL_HOST).href),
  webSiteSchema(),
  webPageSchema({ path: '/about', title, description, type: 'AboutPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
  faqSchema(faqs),
);

/**
 * Four numbers a practice owner can actually check against us later. These
 * were load references and an accessibility grade, which are things we owe
 * the build, not promises the person reading has any way to judge.
 */
const standards = [
  { value: 'Only', caption: 'healthcare, nothing else' },
  { value: 'Yours', caption: 'accounts, from day one' },
  { value: 'Fixed', caption: 'price, agreed in writing' },
  { value: 'Never', caption: 'a template sold as bespoke' },
];

const notList = [
  'an advertising agency',
  'a branding or creative agency',
  'an app development company',
  'an IT consultancy',
];
---

<BaseLayout {title} {description} path="/about" {schema}>
  <PageHero
    label="About the studio"
    title="A small studio in Mehsana that does one thing for one kind of client."
    lede="CareInflow exists because good clinics are routinely represented by bad websites. We build the online presence a healthcare practice actually deserves, with the same professionalism patients experience inside it."
    stats={standards.map((s) => ({ value: s.value, caption: s.caption }))}
  >
    <figure slot="aside" class="m-0">
      <Image
        src={studioImage}
        alt="Jaidev Jethi working at a wooden desk in the Mehsana studio, laptop open and a printed page beside it."
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 400px, 92vw"
        loading="eager"
        fetchpriority="high"
        class="h-[260px] w-full rounded-3xl border border-panel-line object-cover"
      />
      <figcaption class="mt-3 font-mono text-[11px] uppercase leading-[1.6] tracking-[0.06em] text-panel-text-faint">
        The studio in Mehsana, where every build is made.
      </figcaption>
    </figure>
  </PageHero>

  <section class="band-mist" aria-labelledby="founder-title">
    <div class="section shell grid items-start gap-14 lg:grid-cols-[1fr_400px] lg:gap-20">
      <div>
        <div class="mb-10 grid gap-7 sm:grid-cols-[260px_1fr] sm:items-center">
          <figure class="m-0">
            <Image
              src={founderImage}
              alt="Jaidev Jethi, founder of CareInflow, holding a tablet in a clinic corridor."
              widths={[260, 520]}
              sizes="(min-width: 640px) 260px, 70vw"
              loading="lazy"
              class="w-full rounded-3xl border border-line bg-surface"
            />
          </figure>
          <div>
            <p class="label-mono text-faint" style="letter-spacing:0.12em">Founder</p>
            <p class="mt-2 text-[24px] font-extrabold tracking-[-0.03em] text-ink">{BUSINESS.founder}</p>
            <p class="mt-3 text-[16px] leading-[1.65] text-body">
              Web developer, then cybersecurity student in Canada, then more
              than a year at Microsoft. Now building websites for clinics in
              Gujarat: the work he came home to do.
            </p>
          </div>
        </div>

        <div class="prose-ci">
          <h2 id="founder-title">Who runs CareInflow?</h2>
          <p>
            CareInflow was started by <strong>{BUSINESS.founder}</strong>. He
            studied information technology and web development in Gujarat.
            He then studied cybersecurity in Canada, and worked at Microsoft
            for more than a year. That is where he learned what professional
            engineering standards look like from the inside.
          </p>
          <p>
            He could have stayed abroad. He came back to Gujarat to build
            something of his own instead.
          </p>
          <p>
            The problem he chose is easy to see. Many practices here give
            excellent care, but their websites are old, generic or broken.
            Patients notice that gap before they ever meet the doctor.
          </p>
          <p>
            So he kept CareInflow to healthcare only, instead of opening one
            more general web agency. Doing one kind of work again and again is
            how the work gets genuinely good: the same reason specialists
            exist in medicine.
          </p>
          <h2>What we promise, and what we refuse</h2>
          <p>
            Our standards are published, because published standards are
            harder to quietly drop: speed measured against a stated reference,
            accessibility on every build, every account registered in your
            name, and honest answers even when they cost us the project. The
            <a href={href('/process')}>method page</a> shows how a build runs week
            by week. The <a href={href('/work')}>work page</a> shows what we have
            shipped so far, short, because we are new, and honest for the same
            reason.
          </p>
        </div>
      </div>

      <aside class="top-24 grid gap-4 lg:sticky">
        <div class="rounded-3xl border border-line bg-canvas p-7">
          <h2 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">Standards held</h2>
          <dl class="grid gap-5">
            {standards.map((s) => (
              <div class="border-b border-hairline pb-4 last:border-b-0 last:pb-0">
                <dd class="text-[24px] font-extrabold tracking-[-0.04em] text-ink">{s.value}</dd>
                <dt class="mt-0.5 text-[14px] text-muted">{s.caption}</dt>
              </div>
            ))}
          </dl>
        </div>
        <div class="rounded-3xl border border-line bg-canvas p-7">
          <h2 class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What CareInflow is not</h2>
          <ul class="grid gap-2 text-[15px] leading-[1.6] text-muted">
            {notList.map((n) => (
              <li>· not {n}</li>
            ))}
          </ul>
          <p class="mt-4 border-t border-hairline pt-4 text-[14px] leading-[1.6] text-muted">
            Websites, local SEO, Google Business Profile, ongoing care, for
            healthcare practices. That is the whole list.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {/* This section closed the page on a heading, a paragraph and a button, at
      the tail of the longest prose run on /about (1.5 screens). The photograph
      is the section's own subject — the visit, and the person you actually
      deal with — so it earns the slot rather than filling it. */}
  <section class="section shell">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_460px] lg:gap-16">
      <div>
        <SectionHead
          label="Where we are today"
          title="Based in Mehsana. Working with clinics anywhere."
          lede="Every practice gets fixed terms in writing and direct access to the person doing the work. We are near enough to visit clinics across Gujarat and photograph them properly, and everything except the photography works just as well at a distance."
        />
        <p class="mt-7">
          <a href={href('/free-review')} class="btn-secondary px-6 py-3.5 text-[16px]">Start with a free review</a>
        </p>
      </div>
      <Figure
        src={consultImage}
        alt="A doctor and a web designer sitting together at a desk, going through a clinic website on a laptop."
        caption="No account manager in between"
        maxWidth={460}
      />
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions about the studio"
    title="Questions about the studio"
  />

  <CtaPanel nextStep={{ label: 'See the work', href: '/work' }} />
</BaseLayout>
