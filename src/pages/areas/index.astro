---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import areasMap from '@/assets/editorial/areas-map.webp';
import CtaPanel from '@/components/CtaPanel.astro';
import { ACCENTS } from '@/lib/accents';
import { BUSINESS } from '@/config/site';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  itemListSchema,
} from '@/lib/schema';

const title = 'Clinic web design across Gujarat: 9 towns | CareInflow';
const description =
  "Gujarat's healthcare-only web studio works with clinics in Mehsana, Ahmedabad, Gandhinagar, Patan, Palanpur and four more towns. Served, not staffed.";

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const written = new Set(areas.map((a) => a.data.city));
const alsoServed = BUSINESS.serviceAreas.filter((city) => !written.has(city));

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/areas', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Service areas', path: '/areas' },
  ]),
  itemListSchema({
    path: '/areas',
    name: 'Towns CareInflow serves',
    items: areas.map((a) => ({ name: a.data.title, path: `/areas/${a.id}` })),
  }),
);
---

<BaseLayout {title} {description} path="/areas" {schema}>
  <PageHero
    label="Where we work"
    title="Clinic website design across Gujarat, from one studio in Mehsana."
    lede="Plenty of agencies list a dozen cities and staff exactly one of them. We have one studio, on Radhanpur Road in Mehsana, and no branches anywhere. These are places we work in: not places we sit."
    stats={[
      { value: '1', caption: 'studio, in Mehsana' },
      { value: '0', caption: 'branch offices anywhere' },
      { value: String(BUSINESS.serviceAreas.length), caption: 'towns served, and beyond' },
    ]}
  >
    <p class="mt-6 max-w-[660px] text-[16px] leading-[1.62] text-panel-text-dim">
      Everything except photography runs the same at a distance: the writing,
      the build, the Google listing, the monthly upkeep and the quarterly
      review. For photographs we come to you.
    </p>
    {/* An abstract map, and the alt text says so. The pins mark places served
        rather than anything staffed, which is the distinction this page opens
        with, and the illustration carries no place names it could get wrong. */}
    <IllustrationPanel
      slot="aside"
      src={areasMap}
      alt="An illustrated dark map with glowing pins scattered across it, marking the towns served from one studio."
      eager
      maxWidth={400}
    />
  </PageHero>

  <section class="band-powder" aria-label="Areas with a full page">
    <div class="section shell">
      <div class="reveal-group grid gap-5 lg:grid-cols-3">
        {areas.map((a) => (
          <a
            href={href(`/areas/${a.id}`)}
            class:list={[
              'card-hover flex flex-col overflow-hidden rounded-3xl border border-line hover:no-underline',
              ACCENTS[a.data.accent].tint,
            ]}
          >
            {a.data.image && (
              <Image
                src={a.data.image}
                alt={a.data.imageAlt ?? ''}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 400px, 92vw"
                loading="lazy"
                class="h-[190px] w-full border-b border-line object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-8">
            <p class="mb-3">
              <span class="chip bg-surface/70 text-muted">
                {a.data.isHomeBase ? 'Our studio is here' : 'A place we serve'}
              </span>
            </p>
            <h2 class="text-[24px] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
              {a.data.city}
            </h2>
            <p class="mt-3 flex-1 text-[16px] leading-[1.6] text-body">{a.data.summary}</p>
            <span class:list={['prose-link mt-6 inline-block text-[16px]', ACCENTS[a.data.accent].text]}>
              Working in {a.data.city} →
            </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* This section used to be headed "The towns without a page yet" above a
      list of them. Once the ninth page shipped that list was empty, and the
      heading stayed — a page arguing we do not overstate where we work,
      describing towns that were not there. What is still true is the broader
      point, so the section now makes that instead, and the list below appears
      only on the day it has something in it again. */}
  <section
    class="section shell"
    aria-labelledby="beyond-the-list-title"
  >
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_440px] lg:gap-20">
      <div>
        <div class="tick-rule mb-3.5" aria-hidden="true"></div>
        <p class="label-mono mb-5 text-surgical">Beyond the list</p>
        <h2
          id="beyond-the-list-title"
          class="max-w-[620px] text-[clamp(26px,3.4vw,38px)] font-extrabold leading-[1.1] tracking-[-0.035em] text-ink"
        >
          Where we work most, not where we stop.
        </h2>
        <p class="mt-5 max-w-[620px] text-[16px] leading-[1.62] text-body">
          These are the towns we know well enough to write a page about. A page
          that says nothing specific about a place helps nobody in it, so we
          would rather write them properly than quickly.
        </p>
        <p class="mt-5 max-w-[620px] text-[16px] leading-[1.62] text-body">
          They are not the limit of where we work. Being outside North Gujarat
          is not a reason we would turn a practice away, and if distance ever
          did change what we could do for you, we would say so before you paid
          anything.
        </p>
      </div>
      <div class="rounded-3xl border border-line bg-surface p-7">
        <h3 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">
          Somewhere else in Gujarat?
        </h3>
        <p class="text-[16px] leading-[1.62] text-body">
          Send your clinic's name and we will tell you honestly whether the
          distance changes anything. Usually it does not.
        </p>
        {alsoServed.length > 0 && (
          <>
            <p class="mt-5 border-t border-line pt-4 text-[14px] leading-[1.6] text-muted">
              Towns we work in that do not have a page here yet:
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {alsoServed.map((city) => (
                <li class="chip border border-line bg-canvas text-body-deep">{city}</li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
  </section>

  <CtaPanel nextStep={{ label: 'See the method', href: '/process' }} />
</BaseLayout>
