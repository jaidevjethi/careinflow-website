---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '@/components/PageHero.astro';
import studioImage from '@/assets/editorial/founder-working.webp';
import Figure from '@/components/Figure.astro';
import deskImage from '@/assets/about-studio.jpg';
import FaqSection from '@/components/FaqSection.astro';
import { BUSINESS, WHATSAPP_URL, whatsappWithMessage } from '@/config/site';
import { cycleAccent, ACCENTS } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Contact CareInflow, send your clinic\'s name on WhatsApp';
const description =
  'Send your clinic\'s name on WhatsApp or call. A free written review of what patients see, in two working days. Based in Mehsana.';

const faqs = await getFaqsFor('contact');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/contact', title, description, type: 'ContactPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
  faqSchema(faqs),
);

const whatsappHref = whatsappWithMessage(
  "Hi CareInflow, I'd like a free written review of my practice's online presence. Clinic name: ",
);

const reviewCovers = [
  'Listing accuracy',
  'Mobile load time',
  'Treatment page coverage',
  'Review handling',
  'AI answer readiness',
  'The three clinics above you',
];

const steps = [
  { step: '01', text: 'Send your clinic\'s name, the pre-written message needs only that.' },
  { step: '02', text: 'Within two working days you get the written review, free.' },
  { step: '03', text: 'If work is worth doing, the review becomes the plan we quote against, fixed, in writing.' },
];
---

<BaseLayout {title} {description} path="/contact" {schema}>
  <PageHero
    label="Contact"
    title="Send your clinic's name. We reply with what a patient sees."
    lede={'No form, no discovery call, no slide deck. One WhatsApp message starts it, and if the honest answer is "change nothing", that is the answer you will get.'}
  >
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a href={whatsappHref} rel="noopener" class="btn-accent px-7 py-4 text-[17px]">
        WhatsApp {BUSINESS.phoneDisplay}
      </a>
      <a href={`tel:${BUSINESS.phone}`} class="btn-on-dark px-6 py-[15px] text-base">
        Or call {BUSINESS.phoneDisplay}
      </a>
    </div>
    <p class="mt-5 text-[15px] leading-[1.6] text-panel-text-dim">
      Usually answered the same day. Calls are answered between
      {' '}{BUSINESS.hours.opens} and {BUSINESS.hours.closes}, Monday to Saturday.
    </p>

    <Image
      slot="aside"
      src={studioImage}
      alt="The CareInflow studio desk in Mehsana, a laptop open beside a printed page."
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 400px, 92vw"
      loading="eager"
      fetchpriority="high"
      class="h-[260px] w-full rounded-3xl border border-panel-line object-cover"
    />
  </PageHero>

  <section class="band-powder" aria-label="What happens next">
    <div class="section shell grid items-start gap-10 lg:grid-cols-[1fr_380px] lg:gap-20">
      <div>
        <h2 class="text-[clamp(24px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink">
          What happens after you press send
        </h2>
        <ol class="reveal-group mt-8 grid max-w-[640px] gap-4">
          {steps.map((s, i) => (
            <li class:list={['grid grid-cols-[74px_1fr] items-center gap-4 rounded-2xl border border-line p-6', cycleAccent(i).tint]}>
              <span class:list={['numeral text-[clamp(34px,4vw,46px)]', cycleAccent(i).text]}>{s.step}</span>
              <p class="text-[16px] leading-[1.6] text-body">{s.text}</p>
            </li>
          ))}
        </ol>

        <h2 class="mt-14 text-[clamp(24px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink">
          Where we are
        </h2>
        <address class="mt-5 max-w-[640px] text-[16px] not-italic leading-[1.7] text-body">
          {BUSINESS.name} · {BUSINESS.address.street},<br />
          {BUSINESS.address.locality}, {BUSINESS.address.region}, India<br />
          <a href={WHATSAPP_URL} rel="noopener" class="prose-link">WhatsApp {BUSINESS.phoneDisplay}</a> ·
          <a href={`tel:${BUSINESS.phone}`} class="prose-link">Call the studio</a>
        </address>
        <p class="mt-5 max-w-[640px] text-[15px] leading-[1.65] text-muted">
          We are based in Mehsana and work with clinics across
          {BUSINESS.serviceAreas.slice(0, -1).join(', ')} and
          {BUSINESS.serviceAreas.at(-1)}, and further afield where the work
          suits it. Close enough to visit and photograph your practice
          properly; everything else works just as well at a distance.
        </p>
      </div>

      <div class="top-24 grid gap-6 lg:sticky">
        <aside class:list={["rounded-3xl border border-line p-7", ACCENTS.care.tint]}>
          <h2 class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">The review covers</h2>
          <ul class="text-[15px] leading-[2.05] text-body-deep">
            {reviewCovers.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="mt-4 border-t border-line pt-3.5 font-mono text-[11px] uppercase tracking-[0.08em] text-surgical">
            Free · 2 working days
          </p>
        </aside>
        {/* The page had nothing to look at below the hero. The caption talks
            about how the work runs rather than about the room: this is a
            photograph of a working setup, not of the Mehsana studio, and it
            sits directly under an address, where the difference matters. */}
        <Figure
          src={deskImage}
          alt="A laptop and a notebook on a plain wooden desk in a quiet, whitewashed room lit by a single window."
          caption="One studio, one person, nobody in between"
          maxWidth={380}
        />
      </div>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Before you message"
    title="Two things people check first"
  />
</BaseLayout>
