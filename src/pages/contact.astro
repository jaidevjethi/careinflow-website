---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '@/components/PageHero.astro';
import consultImage from '@/assets/editorial/contact-consult.webp';
import Figure from '@/components/Figure.astro';
import waImage from '@/assets/mockups/contact-whatsapp.webp';
import reportImage from '@/assets/mockups/review-report.webp';
import studioExterior from '@/assets/editorial/studio-exterior.webp';
import SectionHead from '@/components/SectionHead.astro';
import FaqSection from '@/components/FaqSection.astro';
import BookingPanel from '@/components/BookingPanel.astro';
import { BUSINESS, BOOKING_URL, HOURS_LABEL, WHATSAPP_URL, whatsappFor } from '@/config/site';
import { BUILDS, GOOGLE_CARE, rupees } from '@/config/pricing';
import { PRICE_TOKENS } from '@/lib/prices';
import { href } from '@/lib/url';
import { cycleAccent, ACCENTS } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Contact CareInflow | Free Digital Review in 2 Days';
const description =
  'Send your clinic\'s name on WhatsApp. A healthcare-only studio in Mehsana replies with a free digital review of what patients see, in two working days.';

const faqs = await getFaqsFor('contact');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/contact', title, description, type: 'ContactPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
  faqSchema(faqs),
);

/*
 * The default prefill, not a copy of it. This page had its own hardcoded
 * wording that differed from PREFILLS.default in a comma, a contraction and a
 * full stop — two openings for the same conversation, and the only one on the
 * site using a contraction. Prefills live in site.ts (see careinflow-funnel).
 */
const whatsappHref = whatsappFor('default');

/*
 * The free review used to be a page of its own, competing with this one for
 * the same conversion. It is the offer this page exists to earn, so it lives
 * here now in full rather than a click away. The old URL redirects here.
 */
const reviewCovers = [
  {
    item: 'Listing accuracy',
    detail: 'Your Google Business Profile checked line by line, categories, services, hours, photos, against what a patient actually needs.',
  },
  {
    item: 'Mobile load time',
    detail: 'Your website measured on a mid-range Android over mobile data, with the numbers and their reference ranges.',
  },
  {
    item: 'Treatment page coverage',
    detail: 'Which of the searches patients type can your site answer today, and which send them to a competitor.',
  },
  {
    item: 'Review handling',
    detail: 'What your recent reviews say, whether anyone replies, and what that pattern signals to the next patient.',
  },
  {
    item: 'AI answer readiness',
    detail: 'What Google writes above the results when someone searches a treatment you offer nearby, and whether your practice appears in it at all.',
  },
  {
    item: 'The three clinics above you',
    detail: 'What the practices ranking above you are doing differently, specifically.',
  },
];

const outline = [
  { n: '01', line: 'Where patients find you today, the searches and surfaces that matter in your area' },
  { n: '02', line: 'What they currently see: screenshots of your listing, your site, and the answer Google writes above both' },
  { n: '03', line: 'The gaps costing you patients, ranked by impact' },
  { n: '04', line: 'What to fix first, useful with or without us' },
  { n: '05', line: 'What it would cost, fixed, in writing, only if work is worth doing' },
];

/*
 * Four steps, not three. The third used to jump straight from the review to a
 * quote, which skipped the part that actually happens: we talk it through
 * before anything is scoped. That conversation is week one of the method and
 * it was documented there but nowhere near the enquiry, which made the site
 * read as though a price arrived without anyone speaking.
 */
/*
 * The sample-video route, in the three steps it actually takes. Nothing in it
 * is a review of the practice; it is one clip, one reply, and a decision that
 * stays the doctor's.
 */
const contentSteps = [
  'Record a question patients ask you, or pick a clip you already have.',
  'Send it on WhatsApp with the topic. The message is already started for you.',
  'We reply with what the edit involves, the turnaround and the price, usually the same day.',
];

const steps = [
  { step: '01', text: 'Send your clinic\'s name, the pre-written message needs only that.' },
  { step: '02', text: 'Within two working days you get the written review, free.' },
  { step: '03', text: 'We talk it through, about an hour, on WhatsApp or a call or a booked meeting, whichever suits you. You have already read the review by then, so it is a conversation rather than a pitch.' },
  { step: '04', text: 'If work is worth doing, the review becomes the plan we quote against, fixed, in writing.' },
];
---

<BaseLayout {title} {description} path="/contact" {schema}>
  <PageHero
    label="Contact"
    title="Get a free digital review. Send your clinic's name."
    lede={'No slide deck. One WhatsApp message starts it, the written review comes back before anyone asks for an hour of your time, and if the honest answer is "change nothing", that is the answer you will get.'}
  >
    {/* Three routes at three weights: the green fill is the one we push, the
        periwinkle fill is the meeting, the outline is the phone. Booking used
        to be a link in the fine print below, which is not where a route
        belongs. The meeting opens on Calendly's own page, in a new tab, where
        it gets the whole viewport — see BookingPanel. */}
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a href={whatsappHref} rel="noopener" class="btn-whatsapp px-7 py-4 text-[17px]">
        WhatsApp {BUSINESS.phoneDisplay}
      </a>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-accent px-7 py-4 text-[17px]"
      >
        Book a meeting
      </a>
      <a href={`tel:${BUSINESS.phone}`} class="btn-on-dark px-6 py-[15px] text-base">
        Or call
      </a>
    </div>
    <p class="mt-5 text-[15px] leading-[1.6] text-panel-text-dim">
      Messages are usually answered the same day. Calls are answered {HOURS_LABEL}.
    </p>
    {/* The second offer, pointed to rather than repeated. Someone here about
        reels does not want the review, and the section that is for them sits
        further down; one line in the hero saves them reading past it. */}
    <p class="mt-3 text-[15px] leading-[1.6] text-panel-text-dim">
      Here about reels or posts?
      {' '}<a href="#content" class="link-accent">Send one sample video instead ↓</a>
    </p>

    {/* Uncropped at desktop. On a phone the band is wider than the source
        allows and takes 18% off the width — centred, that clipped the
        doctor's head at the right edge. Off-centre keeps both faces. */}
    <Image
      slot="aside"
      src={consultImage}
      alt="Two people either side of a desk going through a clinic website design on a laptop between them."
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 400px, 92vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[3/2] w-full rounded-3xl border border-panel-line object-cover"
    />
  </PageHero>

  {/* One job per section, which this band did not have. It used to carry the
      four steps, the phone mockup, the studio address and the service areas
      at once, with the review outline in a sticky column beside all of it —
      four subjects and two asides under a single heading. The mockup stays
      here because it shows the conversation the steps describe; the address
      and the outline moved to sections of their own below. */}
  <section class="band-powder" aria-labelledby="steps-title">
    <div class="section shell grid items-start gap-10 lg:grid-cols-[1fr_380px] lg:gap-20">
      <div>
        <h2
          id="steps-title"
          class="text-[clamp(24px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink"
        >
          What happens after you press send?
        </h2>
        <ol class="reveal-group mt-8 grid gap-4">
          {steps.map((s, i) => (
            <li class:list={['grid grid-cols-[74px_1fr] items-center gap-4 rounded-2xl border border-line p-6', cycleAccent(i).tint]}>
              <span class:list={['numeral text-[clamp(34px,4vw,46px)]', cycleAccent(i).text]}>{s.step}</span>
              <p class="text-[16px] leading-[1.6] text-body">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <Figure
        src={waImage}
        alt="A WhatsApp conversation on a phone: a doctor sending their clinic name, and a reply from the studio confirming the review will follow."
        caption="The whole enquiry, start to finish"
        maxWidth={380}
      />
    </div>
  </section>

  <section class="border-t border-hairline bg-surface" aria-labelledby="covers-title">
    <div class="section shell">
      <SectionHead
        id="covers-title"
        label="What it covers"
        title="What does the free review check?"
        lede="Six things, written in plain language and specific to your practice. Useful whether or not you ever hire us."
      />
      <div class="reveal-group mt-11 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {reviewCovers.map((c, i) => (
          <article class="card-hover rounded-2xl border border-line bg-canvas p-6">
            <p class:list={['numeral mb-2 text-[clamp(34px,3.6vw,46px)]', cycleAccent(i).text]}>
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="text-lg font-bold tracking-[-0.02em] text-ink">{c.item}</h3>
            <p class="mt-2 text-[15px] leading-[1.6] text-muted">{c.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* The outline card sits here now rather than three sections earlier. What
      the review contains and why it costs nothing are the same subject, and
      splitting them meant the review was explained in three separate places
      on one page. */}
  <section class="band-mist" aria-labelledby="why-free-title">
    <div class="section shell grid items-start gap-12 lg:grid-cols-[1fr_420px] lg:gap-20">
      <div>
        <SectionHead
          id="why-free-title"
          label="What you receive"
          title="What do you get, and why does it cost nothing?"
          lede="Most reviews run three to five pages. You keep it either way."
        />
        <p class="mt-6 max-w-[620px] text-lg leading-[1.62] text-body">
          It is free because it is the fastest way to show you we see what
          other studios miss, before you pay anything and before you have given
          us an hour of your day. We do talk it through afterwards, properly,
          because nothing sensible gets scoped without that conversation. The
          difference is the order: you read first, then we talk. Some reviews
          end with "your presence is healthy". Those practices remember us
          anyway.
        </p>
        <p class="mt-5 max-w-[620px] text-[16px] leading-[1.65] text-muted">
          You can see the scale before you message:
          {' '}<a href={href('/pricing')} class="prose-link">our prices are published</a>.
          Websites from {rupees(BUILDS[0]!.from)}, healthcare reels from
          {' '}{rupees(PRICE_TOKENS.reel)}, and monthly Google care at
          {' '}{rupees(GOOGLE_CARE.monthly)}. The review tells you which of
          those your practice actually needs, and sometimes the answer is none
          of them.
        </p>
      </div>

      <div class="grid gap-6">
        <aside class:list={['rounded-3xl border border-line p-7', ACCENTS.care.tint]}>
          <h2 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">The review, in outline</h2>
          <ol>
            {outline.map((o, i) => (
              <li
                class:list={[
                  'grid grid-cols-[32px_1fr] gap-3 py-3 text-[15px] leading-[1.55] text-body-deep',
                  i < outline.length - 1 && 'border-b border-line',
                ]}
              >
                <span class="font-mono text-[12px] text-surgical">{o.n}</span>
                {o.line}
              </li>
            ))}
          </ol>
          <p class="mt-4 border-t border-line pt-3.5 font-mono text-[11px] uppercase tracking-[0.08em] text-surgical">
            Free · 2 working days · yours to keep
          </p>
        </aside>
        <Figure
          src={reportImage}
          alt="A printed clinic website audit report fanned across a desk, showing a performance scorecard, load-time dials and pages of written findings."
          caption="What arrives, before anyone has paid anything"
          maxWidth={420}
        />
      </div>
    </div>
  </section>

  {/* THE SAMPLE-VIDEO OFFER
      The content route, with its own WhatsApp opening. It sits after the
      review because the review is still the page's main job, and before
      booking because it is the faster, free thing for the visitor it serves.
      The reply is free; the edit is not, and the copy says so plainly, since
      "send us your video" otherwise reads as a free edit. */}
  <section id="content" class="border-t border-hairline bg-canvas" aria-labelledby="content-title">
    <div class="section-tight shell grid items-start gap-10 lg:grid-cols-[1fr_380px] lg:gap-20">
      <div>
        <SectionHead
          id="content-title"
          label="Reels and posts"
          title="Have a doctor's video already recorded?"
          lede="Send the topic and one clip. We tell you how we would turn it into a publish-ready reel, how long it would take and what it would cost."
        />
        <ol class="mt-8 grid max-w-[620px] gap-3">
          {contentSteps.map((s, i) => (
            <li class="grid grid-cols-[44px_1fr] items-baseline gap-3 border-b border-hairline pb-3 last:border-0">
              <span class:list={['numeral text-[26px]', ACCENTS.social.text]}>{String(i + 1).padStart(2, '0')}</span>
              <p class="text-[16px] leading-[1.6] text-body">{s}</p>
            </li>
          ))}
        </ol>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={whatsappFor('reel')} rel="noopener" class="btn-whatsapp px-7 py-4 text-[17px]">
            Send one sample video
          </a>
          <a href={href('/services/reel-editing')} class="prose-link text-[16px]">What a reel includes →</a>
        </div>
      </div>
      <aside class:list={['rounded-3xl border border-line p-7', ACCENTS.social.tint]}>
        <p class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">Worth knowing</p>
        <ul class="grid gap-3 text-[15px] leading-[1.55] text-body-deep">
          <li>A standard reel is {rupees(PRICE_TOKENS.reel)}, usually ready in one or two working days.</li>
          <li>Monthly packages start at {rupees(PRICE_TOKENS.contentStarter)} a month.</li>
          <li>The reply is free. We do not edit it for free, and there is no obligation.</li>
        </ul>
      </aside>
    </div>
  </section>

  {/* Booking sits below the review, so the free, faster route is offered
      first to anyone reading down the page. Nothing of Calendly's loads here;
      the control opens their page in a new tab — see BookingPanel. Tight
      padding because this section is a heading and a button, not a widget. */}
  <section id="book" class="border-t border-hairline bg-surface" aria-labelledby="book-title">
    <div class="section-tight shell">
      <SectionHead
        id="book-title"
        label="Book a time"
        title="Would you rather just talk?"
        lede="If a conversation is how you would rather start, pick a time that suits you."
      />
      <BookingPanel class="mt-10 lg:max-w-[620px]" />
    </div>
  </section>

  {/* The address, in a section of its own. It used to sit under a second h2
      halfway through the steps band, which is not where anyone looks for it. */}
  <section class="band-powder" aria-labelledby="where-title">
    <div class="section-tight shell grid items-start gap-10 lg:grid-cols-[1fr_380px] lg:gap-20">
      <div>
        <h2
          id="where-title"
          class="text-[clamp(24px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink"
        >
          Where we are
        </h2>
        <address class="mt-5 max-w-[620px] text-[16px] not-italic leading-[1.7] text-body">
          {BUSINESS.name} · {BUSINESS.address.street},<br />
          {BUSINESS.address.locality}, {BUSINESS.address.region}
          {' '}{BUSINESS.address.postalCode}, India<br />
          <a href={WHATSAPP_URL} rel="noopener" class="link-whatsapp">WhatsApp {BUSINESS.phoneDisplay}</a> ·
          <a href={`tel:${BUSINESS.phone}`} class="prose-link">Call the studio</a>
        </address>
        <p class="mt-5 max-w-[620px] text-[15px] leading-[1.65] text-muted">
          We are based in Mehsana and work with clinics across
          {BUSINESS.serviceAreas.slice(0, -1).join(', ')} and
          {BUSINESS.serviceAreas.at(-1)}, and further afield where the work
          suits it. Close enough to visit and photograph your practice
          properly; everything else works just as well at a distance.
        </p>

        {/* No map here. The footer carries one on every page, including this
            one, and two maps on a single page is one map too many. */}
      </div>
      <Figure
        src={studioExterior}
        alt="The glass entrance to the CareInflow studio, reception desk and seating visible inside."
        caption="One studio, one person, nobody in between"
        maxWidth={380}
      />
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Before you message"
    title="Questions people ask first"
  />
</BaseLayout>
