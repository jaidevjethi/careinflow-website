---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import faqImage from '@/assets/mockups/free-review.jpg';
import CtaPanel from '@/components/CtaPanel.astro';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Clinic Website FAQs: Cost, Timeline, Ownership';
const description =
  'Straight answers on cost, timelines, ranking promises we will not make, what happens after launch, and who owns your website (you do).';

const faqs = await getFaqsFor('faq');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/faq', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Questions', path: '/faq' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout {title} {description} path="/faq" {schema}>
  <PageHero
    label="Common questions"
    title="Clinic website questions, answered before you ask them."
    lede="These are real questions from real conversations with clinic owners. If yours is missing, one WhatsApp message gets it answered, and probably added here."
    stats={[
      { value: String(faqs.length), caption: 'questions answered in full' },
      { value: '0', caption: 'answers that dodge the question' },
      { value: '2 days', caption: 'to a written reply on anything else' },
    ]}
  >
    <IllustrationPanel
      slot="aside"
      src={faqImage}
      alt="A tablet on a desk showing a document laid out as a list of questions and answers."
      eager
      maxWidth={400}
    />
  </PageHero>

  <div class="band-mist mt-6">
    <div class="section shell">
      <div class="reveal-group grid gap-3.5 lg:max-w-[880px]">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-line bg-surface open:shadow-card">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold tracking-[-0.01em] text-ink [&::-webkit-details-marker]:hidden">
              {faq.question}
              <svg
                class="shrink-0 text-faint transition-transform duration-200 ease-instrument group-open:rotate-45"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="px-6 pb-6 text-[16px] leading-[1.65] text-body">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>

  <CtaPanel />
</BaseLayout>
