---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import { cycleAccent } from '@/lib/accents';
import reviewImage from '@/assets/mockups/free-review.jpg';
import SectionHead from '@/components/SectionHead.astro';
import FaqSection from '@/components/FaqSection.astro';
import { BUSINESS, whatsappFor } from '@/config/site';
import { href } from '@/lib/url';
import { BUILDS, STANDALONE_MONTHLY, rupees } from '@/config/pricing';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Free written review for your clinic | CareInflow';
const description =
  'Send your clinic\'s name on WhatsApp. In two working days: your Google listing, load time, treatment coverage, reviews, and the clinics above you.';

const faqs = await getFaqsFor('free-review');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/free-review', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Free review', path: '/free-review' },
  ]),
  faqSchema(faqs),
);

const whatsappHref = whatsappFor('default');

const covers = [
  {
    item: 'Listing accuracy',
    detail: 'Your Google Business Profile checked line by line — categories, services, hours, photos — against what a patient actually needs.',
  },
  {
    item: 'Mobile load time',
    detail: 'Your website measured on a mid-range Android over mobile data, with the numbers and their reference ranges.',
  },
  {
    item: 'Treatment page coverage',
    detail: 'Which of the searches patients type can your site answer today — and which send them to a competitor.',
  },
  {
    item: 'Review handling',
    detail: 'What your recent reviews say, whether anyone replies, and what that pattern signals to the next patient.',
  },
  {
    item: 'AI answer readiness',
    detail: 'What ChatGPT and Google\'s AI answers currently say when asked about clinics like yours nearby — and whether you exist there at all.',
  },
  {
    item: 'The three clinics above you',
    detail: 'What the practices ranking above you are doing differently, specifically.',
  },
];

const outline = [
  { n: '01', line: 'Where patients find you today — the searches and surfaces that matter in your area' },
  { n: '02', line: 'What they currently see — screenshots of your listing, site and AI answers' },
  { n: '03', line: 'The gaps costing you patients, ranked by impact' },
  { n: '04', line: 'What to fix first — useful with or without us' },
  { n: '05', line: 'What it would cost, fixed, in writing — only if work is worth doing' },
];
---

<BaseLayout {title} {description} path="/free-review" {schema}>
  <section class="mx-auto max-w-[1440px] px-5 pb-16 pt-14 sm:px-10 sm:pb-20 sm:pt-20 xl:px-20">
    <div class="tick-rule mb-3.5" aria-hidden="true"></div>
    <p class="label-mono mb-5 text-surgical">Free review</p>
    <h1 class="max-w-[880px] text-[clamp(34px,5vw,62px)] font-extrabold leading-[1.04] tracking-[-0.045em] text-ink">
      A written review of what patients see. Free, in two working days.
    </h1>
    <p class="mt-6 max-w-[660px] text-lg leading-[1.62] text-body">
      One WhatsApp message with your clinic's name is all it takes. No form,
      no discovery call, no obligation — and if the honest answer is "change
      nothing", that is what the review will say.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={whatsappHref} rel="noopener" class="btn-primary px-7 py-4 text-[17px]">
        WhatsApp {BUSINESS.phoneDisplay}
      </a>
      <p class="text-[14.5px] leading-normal text-faint">
        Free · 2 working days<br />Usually answered the same day.
      </p>
    </div>

    <IllustrationPanel
      src={reviewImage}
      alt="A tablet on a desk beside a stethoscope and a notebook, showing a report layout with one teal highlighted row."
      eager
      maxWidth={760}
      class="mt-12"
    />
  </section>

  <section class="border-t border-hairline bg-surface" aria-labelledby="covers-title">
    <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-10 sm:py-20 xl:px-20">
      <SectionHead
        id="covers-title"
        label="What it covers"
        title="What does the free review check?"
      />
      <div class="mt-11 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {covers.map((c, i) => (
          <article class="card-hover rounded-[18px] border border-line bg-canvas p-6.5">
            <p class:list={['numeral mb-2 text-[clamp(38px,4vw,52px)]', cycleAccent(i).text]}>
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="text-lg font-bold tracking-[-0.02em] text-ink">{c.item}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-muted">{c.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 sm:py-[110px] xl:px-20" aria-labelledby="outline-title">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_460px] lg:gap-20">
      <div>
        <SectionHead
          id="outline-title"
          label="What you receive"
          title="What you get, and why it is free"
          lede="Written in plain language, specific to your practice, and useful whether or not you ever hire us. Most reviews run three to five pages."
        />
        <p class="mt-6 max-w-[620px] text-lg leading-[1.62] text-body">
          Why free? Because it is how we prove we see what others miss —
          before you pay anything, and before anyone asks you to sit through a
          call. Some reviews end with "your presence is healthy". Those
          practices remember us anyway.
        </p>
      </div>
      <div class="rounded-3xl border border-line bg-surface p-7 shadow-card">
        <h3 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">The review, in outline</h3>
        <ol>
          {outline.map((o, i) => (
            <li
              class:list={[
                'grid grid-cols-[32px_1fr] gap-3 py-3.5 text-[14.5px] leading-[1.55] text-body-deep',
                i < outline.length - 1 && 'border-b border-hairline',
              ]}
            >
              <span class="font-mono text-[12px] text-surgical">{o.n}</span>
              {o.line}
            </li>
          ))}
        </ol>
        <p class="mt-4 border-t border-line pt-4 font-mono text-[11px] uppercase tracking-[0.08em] text-surgical">
          Free · no obligation · yours to keep
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline bg-surface" aria-labelledby="after-review-title">
    <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-10 sm:py-20 xl:px-20">
      <SectionHead
        id="after-review-title"
        label="What happens next"
        title="What happens after the review?"
        lede="You get one fixed number in writing against a defined scope. If you would rather fix things yourself, the review tells you where to start — and we part as professionals."
      />
      <p class="mt-6 max-w-[680px] text-[15.5px] leading-[1.65] text-muted">
        You can see the scale before you message us: our
        <a href={href('/pricing')} class="prose-link">prices are published</a> —
        websites from {rupees(BUILDS[0]!.from)}, monthly care from
        {' '}{rupees(STANDALONE_MONTHLY.care)}. The review tells you
        which of those your practice actually needs, and occasionally the answer
        is none of them.
      </p>
      <p class="mt-7 flex flex-wrap gap-4">
        <a href={whatsappHref} rel="noopener" class="btn-primary px-6 py-3.5 text-[15px]">
          Send your clinic's name
        </a>
        <a href={href('/process')} class="btn-secondary px-6 py-3.5 text-[15px]">
          See the full method
        </a>
      </p>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions about the review"
    title="Questions about the free review"
  />
</BaseLayout>
