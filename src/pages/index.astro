---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import HeroVisual from '@/components/visuals/HeroVisual.astro';
import ServiceVisual from '@/components/visuals/ServiceVisual.astro';
import founderImage from '@/assets/jaidev-jethi.jpg';
import { getFaqsFor } from '@/lib/faqs';
import { BUSINESS } from '@/config/site';
import { CLIENTS } from '@/config/clients';
import { href } from '@/lib/url';
import { BUILDS, GOOGLE_CARE, rupees } from '@/config/pricing';
import { PRICE_TOKENS } from '@/lib/prices';
import { ACCENTS, cycleAccent, topicAccent } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  founderSchema,
  webSiteSchema,
  webPageSchema,
  faqSchema,
} from '@/lib/schema';

/**
 * What the studio does and where it is, in the words a doctor in Mehsana
 * types. It used to open "Gujarat's Best Healthcare Websites", which was
 * withdrawn on 2026-10-08 along with every other superlative: a claim nobody
 * can check is weaker in a search result than a place name and a service.
 */
const title = 'Clinic Websites, Content & Local SEO in Mehsana | CareInflow';
/**
 * Built from pricing.ts so the figures in the search result can never drift
 * from the figures on the page. A published number is the one thing no
 * competing result shows.
 */
const description =
  `A healthcare-only studio in Mehsana. Clinic websites from ${rupees(BUILDS[0]!.from)}, healthcare reels from ${rupees(PRICE_TOKENS.reel)}, and Google and local search care.`;

const faqs = await getFaqsFor('home');

const schema = graph(
  organizationSchema(),
  founderSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/', title, description }),
  faqSchema(faqs),
);

/*
 * THE PAGE, rebuilt 2026-10-08 around one question a doctor should be able to
 * answer in ten seconds: what does this studio do for a practice like mine?
 *
 *   hero → the five services → the practices that already trust us → the one
 *   real website, in full → how it works → why us → guides → questions → ask
 *
 * The page it replaced explained before it showed: three patient surfaces, nine
 * capability cards, a price strip, a cost-of-delay band and an outcomes grid,
 * all before a visitor could see the services as five things with five prices.
 * The services now come straight after the hero, each with a picture of the
 * work and its price, and everything after them is evidence.
 */

/**
 * The five services, as the brief for this page put them: a name, one
 * sentence, a picture of the work, a price, and a door. No bullet lists — the
 * detail lives on each service's own page, which is where the card sends you.
 * Prices come from pricing.ts; the wording of each is the service's own unit.
 */
const serviceCards = [
  {
    slug: 'healthcare-content',
    name: 'Healthcare content',
    text: 'Reels, Instagram posts, carousels and clinic creatives, made from your own videos and captioned in Gujarati or English.',
    price: `From ${rupees(PRICE_TOKENS.reel)}`,
    unit: '/ reel',
    cta: 'Explore healthcare content',
    accent: ACCENTS.social,
  },
  {
    slug: 'healthcare-websites',
    name: 'Healthcare websites',
    text: 'Patient-focused websites built around your doctors, your treatments and your clinic.',
    price: `From ${rupees(BUILDS[0]!.from)}`,
    unit: 'one-time',
    cta: 'Explore websites',
    accent: ACCENTS.web,
  },
  {
    slug: 'google-business-profile',
    name: 'Google Business Profile',
    text: 'Improve and maintain how your clinic appears on Google: hours, services, photos and replies to reviews.',
    price: `From ${rupees(PRICE_TOKENS.gbpRebuild)}`,
    unit: 'one-time',
    cta: 'Explore Google profile',
    accent: ACCENTS.gbp,
  },
  {
    slug: 'local-seo',
    name: 'Local SEO',
    text: 'Build stronger local search visibility around your treatments and the areas you serve.',
    price: `From ${rupees(GOOGLE_CARE.monthly)}`,
    unit: '/ month',
    cta: 'Explore local SEO',
    accent: ACCENTS.seo,
  },
  {
    slug: 'website-care',
    name: 'Website care',
    text: 'Keep your website updated, secure and useful after launch.',
    price: 'Custom monthly plan',
    unit: '',
    cta: 'Explore website care',
    accent: ACCENTS.care,
  },
];

/** Three things about the studio a buyer can check, not three things we promise. */
const credibility = [
  { value: 'Healthcare only', caption: 'we take no other kind of client' },
  { value: 'Mehsana', caption: 'one studio, working across Gujarat' },
  { value: 'Ex-Microsoft', caption: 'the person who does the work' },
];

/** The one real website, shown in full rather than as one of four thumbnails. */
const caseStudy = (await getEntry('caseStudies', 'pramukh-dental'))!;

/**
 * Four steps, true for every service: the content route and the website route
 * only differ in what the second step reviews.
 */
const steps = [
  {
    title: 'Tell us what you need',
    text: "A WhatsApp message with your clinic's name and what you want to improve, a call, or a booked meeting.",
  },
  {
    title: 'We review where you stand',
    text: 'A free digital review of your website and Google listing, or a reply on one sample video. Useful whether or not you hire us.',
  },
  {
    title: 'We build, create or improve',
    text: 'One fixed price in writing first. Then the website, the listing or the month of content, made by the person you spoke to.',
  },
  {
    title: 'You get a clear deliverable',
    text: 'A site you own, a listing that is right, reels ready to post, and monthly care where you want it.',
  },
];

/**
 * Why a doctor would choose this studio, as six things they can hold it to.
 * Each is a description of how the studio works, none a claim about results.
 */
const why = [
  {
    title: 'Healthcare only',
    text: 'Doctors and clinics are the only clients we take, so every page and every reel is shaped around patients.',
  },
  {
    title: 'Clear scope',
    text: 'Every package says what is included and what is not, in the same plain words, before you pay.',
  },
  {
    title: 'Direct communication',
    text: 'You work with the founder, usually on WhatsApp, not with an account manager.',
  },
  {
    title: 'Fast, practical delivery',
    text: 'A reel usually in one or two working days, the free review in two, and a website on a timeline agreed at the start.',
  },
  {
    title: 'Published prices',
    text: 'Every figure is on the pricing page, and yours is fixed in writing before any work starts.',
  },
  {
    title: 'No fake guarantees',
    text: 'No promised rankings, patients or followers, and no bought reviews. Nobody can honestly promise those.',
  },
];

/**
 * Specialties we build for. Every one links to the page on what changes for
 * it; cosmetic points at dermatology rather than competing with it.
 */
const SPECIALTIES: Array<{ label: string; href: string }> = [
  { label: 'Dental', href: '/specialties/dental-clinics' },
  { label: 'Dermatology', href: '/specialties/dermatology-clinics' },
  { label: 'Physiotherapy', href: '/specialties/physiotherapy-clinics' },
  { label: 'Ophthalmology', href: '/specialties/ophthalmology-clinics' },
  { label: 'Orthopaedics', href: '/specialties/orthopaedic-clinics' },
  { label: 'Paediatrics', href: '/specialties/paediatric-clinics' },
  { label: 'Gynaecology', href: '/specialties/gynaecology-clinics' },
  { label: 'Cosmetic', href: '/specialties/dermatology-clinics' },
  { label: 'Mental health', href: '/specialties/mental-health-clinics' },
  { label: 'ENT', href: '/specialties/ent-clinics' },
  { label: 'Cardiology', href: '/specialties/cardiology-clinics' },
  { label: 'Diagnostic centres', href: '/specialties/diagnostic-centres' },
  { label: 'Multi-specialty', href: '/specialties/multi-specialty-hospitals' },
];

/**
 * Three guides, one per thing a practice gets judged on: the patient's
 * decision, the website, and the listing. Named by id so the strip does not
 * change shape when a new guide is published.
 */
const GUIDE_IDS = [
  'how-patients-choose-a-clinic-online',
  'what-a-clinic-website-actually-needs',
  'google-business-profile-for-clinics',
];
const allGuides = await getCollection('resources');
const guides = GUIDE_IDS.map((id) => allGuides.find((g) => g.id === id)).filter(
  (g): g is NonNullable<typeof g> => Boolean(g),
);
const topicLabels: Record<string, string> = {
  patients: 'Patient behaviour',
  'google-business-profile': 'Google Business Profile',
  websites: 'Websites',
  'local-seo': 'Local SEO',
  performance: 'Performance',
};
---

<BaseLayout {title} {description} path="/" {schema}>
  <!-- HERO : the site's first midnight moment. It is allowed to be the
       tallest hero on the site, never taller than the viewport. -->
  <section class="panel-depth hero-pad">
    <div class="shell">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_520px] lg:gap-14">
        <div class="animate-rise">
          <p class="inline-flex max-w-full items-center gap-2.5 rounded-full border border-panel-line bg-panel-card px-3.5 py-2">
            <span class="inline-block size-[7px] shrink-0 animate-live rounded-full bg-panel-accent" aria-hidden="true"></span>
            <span class="min-w-0 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text sm:tracking-[0.1em]">
              Healthcare practices only · Mehsana, Gujarat
            </span>
          </p>
          {/*
            The category first, then the three things in it. "Gujarat's best
            healthcare websites" stood here until 2026-10-08: an opinion nobody
            could check, describing one of the three things the studio does.
          */}
          <h1 class="mt-6 text-[clamp(36px,4.6vw,62px)] font-extrabold leading-[1.02] tracking-[-0.05em] text-surface">
            Digital growth for <span class="text-panel-accent">doctors and clinics.</span>
          </h1>
          <p class="mt-5 max-w-[620px] text-[17px] leading-[1.6] text-panel-text">
            From patient-friendly websites and Gujarati healthcare content to
            your Google Business Profile and local SEO, CareInflow helps
            healthcare practices build a stronger digital presence. One studio
            in Mehsana, and you work directly with the founder.
          </p>
          {/* One primary action. "Explore services" is the quieter second,
              for the visitor who wants to see the five before asking. */}
          <div class="mt-7 flex flex-wrap items-center gap-3.5">
            <a href={href('/contact')} class="btn-accent px-6 py-3.5 text-base sm:px-7 sm:py-4">
              Get a free digital review
            </a>
            <a href="#services" class="btn-on-dark px-6 py-[13px] text-base sm:py-[15px]">
              Explore services
            </a>
          </div>
          <dl class="mt-9 grid max-w-[620px] gap-x-8 gap-y-5 border-t border-panel-line pt-5 sm:grid-cols-3">
            {credibility.map((c) => (
              <div>
                <dt class="sr-only">{c.caption}</dt>
                <dd class="numeral whitespace-nowrap text-[clamp(20px,2vw,26px)] text-surface">{c.value}</dd>
                <dd class="mt-1.5 font-mono text-[11px] uppercase leading-[1.5] tracking-[0.08em] text-panel-text-dim">
                  {c.caption}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        {/*
          Hidden on a phone, on purpose. The five service cards directly below
          carry a picture each, so on a 375px screen this would be the same
          pictures twice, pushing the services a full screen down. From sm up
          there is room for both, and this is the one image that shows all
          three pillars at once.
        */}
        <div class="hidden animate-fade sm:block">
          <HeroVisual class="mx-auto max-w-[520px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · WHAT WE DO : the five services, each a door -->
  <section id="services" class="bg-canvas" aria-labelledby="services-title">
    <div class="section shell">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="services-title"
          label="What we do"
          title="How CareInflow helps your practice"
          lede="Five services, for healthcare practices only. Start with whichever you need: one is enough, and the free review says which."
        />
        <a href={href('/services')} class="prose-link whitespace-nowrap text-base">All services →</a>
      </div>

      {/*
        FIVE CARDS, AND A GRID THAT DIVIDES THEM. Five never divides into two or
        three columns, so the grid is six columns wide at lg: the first three
        cards take two each, the last two take three each and turn sideways,
        picture beside words, so the second row is not twice as tall as the
        first. At sm it is two columns and the fifth card spans both. On a
        phone they stack, picture first, because the picture is the fastest way
        to say what each service is.
      */}
      <div class="reveal-group grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
        {serviceCards.map((c, i) => {
          const wide = i >= 3;
          return (
            <article
              class:list={[
                'group card-hover card-link flex flex-col overflow-hidden rounded-3xl border border-line bg-surface',
                wide ? 'lg:col-span-3 lg:flex-row' : 'lg:col-span-2',
                i === 4 && 'sm:col-span-2',
              ]}
            >
              <div
                class:list={[
                  'shrink-0 border-b border-line p-2.5 sm:p-3',
                  wide && 'lg:flex lg:w-[52%] lg:items-center lg:border-b-0 lg:border-r',
                ]}
              >
                <ServiceVisual
                  slug={c.slug}
                  class="rounded-2xl transition-transform duration-200 ease-instrument group-hover:-translate-y-0.5"
                />
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <p class="flex items-center gap-2.5">
                  <span class:list={['accent-bar block h-1 w-6 rounded-full', c.accent.bar]} aria-hidden="true"></span>
                  <span class:list={['font-mono text-[11px] font-semibold uppercase tracking-[0.12em]', c.accent.text]}>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </p>
                <h3 class="mt-3 text-[clamp(21px,1.8vw,24px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
                  {c.name}
                </h3>
                <p class="mt-2.5 text-[16px] leading-[1.6] text-body">{c.text}</p>
                <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <span class="text-[22px] font-extrabold leading-none tracking-[-0.04em] text-ink">{c.price}</span>
                  {c.unit && (
                    <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{c.unit}</span>
                  )}
                </p>
                <p class="mt-auto pt-5">
                  <a href={href(`/services/${c.slug}`)} class="prose-link inline-flex items-center gap-1.5 text-[16px]">
                    {c.cta}
                    <span aria-hidden="true" class="inline-block transition-transform duration-200 ease-instrument group-hover:translate-x-1">→</span>
                  </a>
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 02 · TRUSTED BY : the real practices, named, with what each trusted us with
       Text marks, not logos: a logo goes up only once a practice supplies it
       for that use, and a monogram tile would read as their logo. Permission
       is secured off the page and never mentioned on it. -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="clients-title">
    <div class="section-tight shell">
      <SectionHead
        id="clients-title"
        label="Trusted by healthcare practices in Mehsana"
        title="Practices in Mehsana already work with CareInflow."
        lede="Each one trusted us with something different: a website and a Google listing, a steady run of content, a series of reels. Every card links to the work itself."
      />

      {/* Three across from lg; stacked below it, where three columns would
          wrap "Pramukh Multispeciality Dental Clinic" to four lines. */}
      <ul class="reveal-group mt-10 grid gap-4 lg:grid-cols-3 lg:gap-6">
        {CLIENTS.map((c) => (
          <li class="flex flex-col overflow-hidden rounded-3xl border border-line bg-canvas">
            <span class:list={['accent-bar block h-1 w-full', ACCENTS[c.accent].bar]} aria-hidden="true"></span>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="flex flex-wrap gap-1.5">
                <span class="chip bg-ink text-surface">Client work</span>
                <span class:list={['chip', ACCENTS[c.accent].chip]}>{c.pillar}</span>
              </p>
              <h3 class="mt-4 text-[clamp(19px,1.6vw,22px)] font-extrabold leading-[1.2] tracking-[-0.025em] text-ink">
                {c.name}
              </h3>
              <p class="mt-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{c.place}</p>
              <p class="mt-4 text-[15px] leading-[1.6] text-body">{c.work}</p>
              <p class="mt-auto flex flex-wrap gap-x-5 gap-y-1.5 pt-5">
                <a href={c.url} rel="noopener" class="prose-link text-[15px]">{c.linkText} →</a>
                {c.caseStudy && (
                  <a href={href(c.caseStudy)} class="prose-link text-[15px]">Read the case study →</a>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 · REAL WORK : the one live website built for a paying practice, in full
       It used to be one of four equal thumbnails, three of them samples. The
       samples are still on /work, labelled; here the real build gets the room,
       and nothing beside it is a sample. -->
  <section class="band-powder" aria-labelledby="case-title">
    <div class="section shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <figure class="relative m-0 pb-10 sm:pb-14">
          <Image
            src={caseStudy.data.cover}
            alt={caseStudy.data.coverAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1440px) 620px, (min-width: 1024px) 46vw, 92vw"
            loading="lazy"
            class="aspect-[16/10] w-full rounded-2xl border border-line bg-surface object-cover object-top shadow-card"
          />
          {caseStudy.data.coverMobile && (
            <Image
              src={caseStudy.data.coverMobile}
              alt={caseStudy.data.coverMobileAlt ?? ''}
              widths={[160, 240, 320]}
              sizes="(min-width: 640px) 160px, 110px"
              loading="lazy"
              class="absolute bottom-0 right-3 w-[110px] rounded-2xl border border-line bg-surface shadow-card-lg sm:right-6 sm:w-[160px]"
            />
          )}
        </figure>

        <div>
          <p class="flex flex-wrap gap-1.5">
            <span class="chip bg-ink text-surface">Real client project</span>
            <span class="chip border border-line bg-surface text-body-deep">{caseStudy.data.sector} · Mehsana</span>
          </p>
          <h2
            id="case-title"
            class="mt-5 text-[clamp(26px,3.2vw,38px)] font-extrabold leading-[1.1] tracking-[-0.035em] text-ink"
          >
            {caseStudy.data.client}
          </h2>
          <p class="mt-4 max-w-[560px] text-[17px] leading-[1.62] text-body">{caseStudy.data.summary}</p>
          <dl class="mt-7 grid max-w-[560px] grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6">
            {caseStudy.data.highlights.map((h) => (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-[20px] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 text-[14px] leading-[1.45] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
          <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={href('/work/pramukh-dental')} class="btn-primary px-6 py-3.5 text-[16px]">Read the case study</a>
            {caseStudy.data.url && (
              <a href={caseStudy.data.url} rel="noopener" class="prose-link text-[16px]">Open the live site →</a>
            )}
          </p>
          <p class="mt-6 max-w-[560px] text-[15px] leading-[1.6] text-muted">
            The portfolio also has three sample websites, each clearly labelled
            as a sample. <a href={href('/work')} class="prose-link">See the portfolio →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · HOW IT WORKS : the page's one dark section
       Dark because it is the section that asks, and the design rule is to
       spend the dark weight on what you want clicked. -->
  <section class="band-panel" aria-labelledby="how-title">
    <div class="section shell">
      <SectionHead
        id="how-title"
        dark
        label="How it works"
        title="Four steps, and you always know which one you are on."
        lede="The same for every service. Nothing is built, edited or charged before the price and the scope are in writing."
      />
      <ol class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="flex flex-col gap-3 border-t-2 border-panel-line-alt pt-6">
            <span class="numeral text-[44px] leading-none text-panel-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[19px] font-bold leading-[1.25] tracking-[-0.02em] text-surface">{s.title}</h3>
            <p class="text-[16px] leading-[1.62] text-panel-text-dim">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-2xl border border-panel-line-alt bg-panel-card px-6 py-6 sm:px-8">
        <p class="max-w-[600px] flex-1 text-[16px] leading-[1.6] text-panel-text">
          Not sure where to start? The free digital review tells you, in two
          working days, and if the answer is "change nothing", we will say that.
        </p>
        <a href={href('/contact')} class="btn-accent shrink-0 px-6 py-3 text-[16px]">Get a free digital review</a>
        <a href={href('/process')} class="link-accent shrink-0 text-[15px]">See the full method →</a>
      </div>
    </div>
  </section>

  <!-- 05 · WHY CAREINFLOW : six things to hold us to, and who does the work -->
  <section class="section shell" aria-labelledby="why-title">
    <SectionHead
      id="why-title"
      label="Why CareInflow"
      title="A healthcare specialist, not a general agency."
      lede="A studio that builds for a restaurant one month and a clinic the next never learns either properly. These are the six things we work by, and you can hold us to every one."
    />
    <ul class="reveal-group mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {why.map((w, i) => (
        <li class="flex gap-4 rounded-2xl border border-line bg-surface p-6">
          <span class:list={['numeral shrink-0 text-[28px] leading-none', cycleAccent(i).text]}>
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="min-w-0">
            <h3 class="text-[17px] font-bold tracking-[-0.02em] text-ink">{w.title}</h3>
            <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{w.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 grid items-start gap-6 lg:grid-cols-[1fr_440px]">
      <div class="flex flex-col gap-6 rounded-3xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:gap-7 sm:p-7">
        <Image
          src={founderImage}
          alt="Jaidev Jethi, founder of CareInflow."
          widths={[140, 280]}
          sizes="140px"
          loading="lazy"
          class="h-[150px] w-[122px] shrink-0 rounded-2xl border border-line object-cover object-top"
        />
        <div>
          <p class="label-mono text-faint" style="letter-spacing:0.12em">Who does the work</p>
          <h3 class="mt-2 text-[clamp(20px,2.2vw,24px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
            You work directly with the founder, not an account manager.
          </h3>
          <p class="mt-2.5 max-w-[560px] text-[15px] leading-[1.6] text-body">
