---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import ClientCard from '@/components/ClientCard.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import HeroVisual from '@/components/visuals/HeroVisual.astro';
import ServiceVisual from '@/components/visuals/ServiceVisual.astro';
import founderImage from '@/assets/jaidev-jethi.jpg';
import heroPhoto from '@/assets/editorial/hero-founder-consult.webp';
import receptionPhoneImage from '@/assets/editorial/hero-clinic-owner.webp';
import doctorMobileImage from '@/assets/editorial/hero-doctor-mobile.webp';
import surfaceGoogleListing from '@/assets/mockups/surface-google-listing.webp';
import surfacePracticeWebsite from '@/assets/mockups/surface-practice-website.webp';
import surfaceAiAnswer from '@/assets/mockups/surface-ai-answer.webp';
import surfaceInstagram from '@/assets/mockups/social-post.webp';
import { getFaqsFor } from '@/lib/faqs';
import { BUSINESS } from '@/config/site';
import { CLIENTS } from '@/config/clients';
import { href } from '@/lib/url';
import { BUILDS, GOOGLE_CARE, rupees } from '@/config/pricing';
import { PRICE_TOKENS } from '@/lib/prices';
import { ACCENTS, cycleAccent, topicAccent } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  founderSchema,
  webSiteSchema,
  webPageSchema,
  faqSchema,
} from '@/lib/schema';

/**
 * What the studio does and where it is, in the words a doctor in Mehsana
 * types. It used to open "Gujarat's Best Healthcare Websites", which was
 * withdrawn on 2026-10-08 along with every other superlative: a claim nobody
 * can check is weaker in a search result than a place name and a service.
 */
const title = 'Clinic Websites, Content & Local SEO in Mehsana | CareInflow';
/**
 * Built from pricing.ts so the figures in the search result can never drift
 * from the figures on the page. A published number is the one thing no
 * competing result shows.
 */
const description =
  `A healthcare-only studio in Mehsana. Clinic websites from ${rupees(BUILDS[0]!.from)}, healthcare reels from ${rupees(PRICE_TOKENS.reel)}, and Google and local search care.`;

const faqs = await getFaqsFor('home');

const schema = graph(
  organizationSchema(),
  founderSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/', title, description }),
  faqSchema(faqs),
);

/*
 * THE PAGE, rebuilt 2026-10-08 around one question a doctor should be able to
 * answer in ten seconds: what does this studio do for a practice like mine?
 *
 *   hero → the five services → the practices that already trust us → the one
 *   real website, in full → all four websites → where patients look → how it
 *   works → why us → specialties → guides → questions → ask
 *
 * The services come straight after the hero, each with a picture of the work
 * and its price, and everything after them is evidence.
 *
 * PICTURES, BY KIND (design skill, "Pictures: what goes where"): the hero
 * takes a photograph, a doctor and a designer at a desk; the drawn visuals
 * explain the work in the body (the five service cards, the three-pillar
 * drawing that opens "Where patients look"); screenshots are the real work.
 *
 * KEEP THE PICTURES. The first version of this rebuild cut the portfolio row,
 * the four patient surfaces and two photographs, and the owner asked for them
 * back the same day: the images are what carry a visitor down the page, and a
 * homepage of text cards reads as dull however good the text is. Every section
 * from the services down carries a picture except the client band, which waits
 * on logos the practices have not supplied, and the questions. A change that
 * removes an image from this page needs the owner's say-so.
 */

/**
 * The five services, as the brief for this page put them: a name, one
 * sentence, a picture of the work, a price, and a door. No bullet lists — the
 * detail lives on each service's own page, which is where the card sends you.
 * Prices come from pricing.ts; the wording of each is the service's own unit.
 */
const serviceCards = [
  {
    slug: 'healthcare-content',
    name: 'Healthcare content',
    text: 'Reels, Instagram posts, carousels and clinic creatives, made from your own videos and captioned in Gujarati or English.',
    price: `From ${rupees(PRICE_TOKENS.reel)}`,
    unit: '/ reel',
    cta: 'Explore healthcare content',
    accent: ACCENTS.social,
  },
  {
    slug: 'healthcare-websites',
    name: 'Healthcare websites',
    text: 'Patient-focused websites built around your doctors, your treatments and your clinic.',
    price: `From ${rupees(BUILDS[0]!.from)}`,
    unit: 'one-time',
    cta: 'Explore websites',
    accent: ACCENTS.web,
  },
  {
    slug: 'google-business-profile',
    name: 'Google Business Profile',
    text: 'Improve and maintain how your clinic appears on Google: hours, services, photos and replies to reviews.',
    price: `From ${rupees(PRICE_TOKENS.gbpRebuild)}`,
    unit: 'one-time',
    cta: 'Explore Google profile',
    accent: ACCENTS.gbp,
  },
  {
    slug: 'local-seo',
    name: 'Local SEO',
    text: 'Build stronger local search visibility around your treatments and the areas you serve.',
    price: `From ${rupees(GOOGLE_CARE.monthly)}`,
    unit: '/ month',
    cta: 'Explore local SEO',
    accent: ACCENTS.seo,
  },
  {
    slug: 'website-care',
    name: 'Website care',
    text: 'Keep your website updated, secure and useful after launch.',
    price: 'Custom monthly plan',
    unit: '',
    cta: 'Explore website care',
    accent: ACCENTS.care,
  },
];

/** Three things about the studio a buyer can check, not three things we promise. */
const credibility = [
  { value: 'Healthcare only', caption: 'we take no other kind of client' },
  { value: 'Mehsana', caption: 'one studio, working across Gujarat' },
  { value: 'Ex-Microsoft', caption: 'the person who does the work' },
];

/** The one real website, shown in full above the row of all four. */
const caseStudy = (await getEntry('caseStudies', 'pramukh-dental'))!;

/** Every website in the portfolio, real and sample, each card saying which. */
const allCaseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

/**
 * The four places a patient checks before calling, each a photograph of that
 * screen and a door to the service that fixes it.
 */
const patientSurfaces = [
  {
    title: 'Your Google listing',
    accent: ACCENTS.gbp,
    image: surfaceGoogleListing,
    imageAlt: 'A Google Business Profile for a clinic open on a phone, showing the practice name, photographs of the clinic, and call and directions buttons.',
    imagePos: 'object-[50%_16%]',
    text: 'For many patients this is the first thing they see: the map, a few nearby practices, and their hours, photos and reviews. We rebuild the profile, and keep it right every month on Google Care.',
    link: '/services/google-business-profile',
    linkText: 'Google Business Profile',
  },
  {
    title: 'Your website',
    accent: ACCENTS.web,
    image: surfacePracticeWebsite,
    imageAlt: 'A clinic website open on a phone, showing a welcome banner, a book-appointment button and a row of treatment cards.',
    imagePos: 'object-[50%_16%]',
    text: 'Built by hand, not from a theme. A page for each treatment, written in the words patients type: the symptom and the cost, not the clinical term.',
    link: '/services/healthcare-websites',
    linkText: 'Healthcare websites',
  },
  {
    title: 'Your Instagram',
    accent: ACCENTS.social,
    image: surfaceInstagram,
    imageAlt: 'A phone on a desk showing an educational clinic post: a numbered list of early warning signs, laid out with simple illustrations.',
    imagePos: 'object-center',
    text: 'Patients who found you elsewhere often check it before they call, to see whether the practice is active and explains things clearly. We turn the videos you record into reels that do that.',
    link: '/services/healthcare-content',
    linkText: 'Healthcare content',
  },
  {
    title: 'The answer above the results',
    accent: ACCENTS.seo,
    image: surfaceAiAnswer,
    imageAlt: 'A laptop on a desk showing a search results page where an AI-written summary box sits above the ordinary blue links.',
    imagePos: 'object-center',
    text: 'Search a treatment today and Google often writes the answer itself, above every link. It builds that answer from pages it can read and quote, so the facts about your practice have to be published where it can find them.',
    link: '/services/local-seo',
    linkText: 'Local SEO',
  },
];

/**
 * Four steps, true for every service: the content route and the website route
 * only differ in what the second step reviews.
 */
const steps = [
  {
    title: 'Tell us what you need',
    text: "A WhatsApp message with your clinic's name and what you want to improve, a call, or a booked meeting.",
  },
  {
    title: 'We review where you stand',
    text: 'A free digital review of your website and Google listing, or a reply on one sample video. Useful whether or not you hire us.',
  },
  {
    title: 'We build, create or improve',
    text: 'One fixed price in writing first. Then the website, the listing or the month of content, made by the person you spoke to.',
  },
  {
    title: 'You get a clear deliverable',
    text: 'A site you own, a listing that is right, reels ready to post, and monthly care where you want it.',
  },
];

/**
 * Why a doctor would choose this studio, as six things they can hold it to.
 * Each is a description of how the studio works, none a claim about results.
 */
const why = [
  {
    title: 'Healthcare only',
    text: 'Doctors and clinics are the only clients we take, so every page and every reel is shaped around patients.',
  },
  {
    title: 'Clear scope',
    text: 'Every package says what is included and what is not, in the same plain words, before you pay.',
  },
  {
    title: 'Direct communication',
    text: 'You work with the founder, usually on WhatsApp, not with an account manager.',
  },
  {
    title: 'Fast, practical delivery',
    text: 'A reel usually in one or two working days, the free review in two, and a website on a timeline agreed at the start.',
  },
  {
    title: 'Published prices',
    text: 'Every figure is on the pricing page, and yours is fixed in writing before any work starts.',
  },
  {
    title: 'No fake guarantees',
    text: 'No promised rankings, patients or followers, and no bought reviews. Nobody can honestly promise those.',
  },
];

/**
 * Every specialty page, in its own order, each with the photograph its page
 * opens on. Cosmetic work lives on the dermatology page, which says so.
 */
const specialties = (await getCollection('specialties')).sort((a, b) => a.data.order - b.data.order);

/**
 * Three guides, one per thing a practice gets judged on: the patient's
 * decision, the website, and the listing. Named by id so the strip does not
 * change shape when a new guide is published.
 */
const GUIDE_IDS = [
  'how-patients-choose-a-clinic-online',
  'what-a-clinic-website-actually-needs',
  'google-business-profile-for-clinics',
];
const allGuides = await getCollection('resources');
const guides = GUIDE_IDS.map((id) => allGuides.find((g) => g.id === id)).filter(
  (g): g is NonNullable<typeof g> => Boolean(g),
);
const topicLabels: Record<string, string> = {
  patients: 'Patient behaviour',
  'google-business-profile': 'Google Business Profile',
  websites: 'Websites',
  'local-seo': 'Local SEO',
  performance: 'Performance',
};
---

<BaseLayout {title} {description} path="/" {schema}>
  <!-- HERO : the site's first midnight moment. It is allowed to be the
       tallest hero on the site, never taller than the viewport.
       Its picture is the photograph it has always had: a doctor and a
       designer going through a clinic's site together. Heroes take
       photographs ("Pictures: what goes where", design skill); the drawing
       of the three pillars that stood here for an afternoon now opens "Where
       patients look", where it explains rather than greets. -->
  <section class="panel-depth hero-pad">
    <div class="shell">
      <!-- Three children, ordered differently by width. On a phone the
           photograph belongs directly under the two buttons, where the visitor
           is deciding, and the three facts follow it. On a wide screen the
           photograph takes the right column and the facts sit under the copy. -->
      <div
        class="flex flex-col gap-10 lg:grid lg:grid-cols-[1fr_560px] lg:grid-rows-[auto_auto] lg:items-center lg:gap-x-16 lg:gap-y-7"
      >
        <div class="animate-rise lg:col-start-1 lg:row-start-1">
          <p class="inline-flex max-w-full items-center gap-2.5 rounded-full border border-panel-line bg-panel-card px-3.5 py-2">
            <span class="inline-block size-[7px] shrink-0 animate-live rounded-full bg-panel-accent" aria-hidden="true"></span>
            <span class="min-w-0 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text sm:tracking-[0.1em]">
              Healthcare practices only · Mehsana, Gujarat
            </span>
          </p>
          {/*
            The category first, then the three things in it. "Gujarat's best
            healthcare websites" stood here until 2026-10-08: an opinion nobody
            could check, describing one of the three things the studio does.
          */}
          <h1 class="mt-6 text-[clamp(36px,4.6vw,62px)] font-extrabold leading-[1.02] tracking-[-0.05em] text-surface">
            Digital growth for <span class="text-panel-accent">doctors and clinics.</span>
          </h1>
          <p class="mt-5 max-w-[620px] text-[17px] leading-[1.6] text-panel-text">
            From patient-friendly websites and Gujarati healthcare content to
            your Google Business Profile and local SEO, CareInflow helps
            healthcare practices build a stronger digital presence. One studio
            in Mehsana, and you work directly with the founder.
          </p>
          {/* One primary action. "Explore services" is the quieter second,
              for the visitor who wants to see the five before asking. */}
          <div class="mt-7 flex flex-wrap items-center gap-3.5">
            <a href={href('/contact')} class="btn-accent px-6 py-3.5 text-base sm:px-7 sm:py-4">
              Get a free digital review
            </a>
            <a href="#services" class="btn-on-dark px-6 py-[13px] text-base sm:py-[15px]">
              Explore services
            </a>
          </div>
        </div>

        <dl class="order-last grid max-w-[620px] gap-x-8 gap-y-5 border-t border-panel-line pt-5 sm:grid-cols-3 lg:order-none lg:col-start-1 lg:row-start-2">
          {credibility.map((c) => (
            <div>
              <dt class="sr-only">{c.caption}</dt>
              <dd class="numeral whitespace-nowrap text-[clamp(20px,2vw,26px)] text-surface">{c.value}</dd>
              <dd class="mt-1.5 font-mono text-[11px] uppercase leading-[1.5] tracking-[0.08em] text-panel-text-dim">
                {c.caption}
              </dd>
            </div>
          ))}
        </dl>

        <figure class="m-0 animate-fade lg:col-start-2 lg:row-span-2 lg:row-start-1">
          <Image
            src={heroPhoto}
            alt="A doctor in a white coat and a web designer sitting together at a desk, looking at a clinic website on a laptop while the designer points at the screen."
            widths={[560, 700, 840, 1120]}
            sizes="(min-width: 1024px) 560px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[3/2] w-full rounded-3xl border border-panel-line object-cover"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 01 · WHAT WE DO : the five services, each a door -->
  <section id="services" class="bg-canvas" aria-labelledby="services-title">
    <div class="section shell">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="services-title"
          label="What we do"
          title="How CareInflow helps your practice"
          lede="Five services, for healthcare practices only. Start with whichever you need: one is enough, and the free review says which."
        />
        <a href={href('/services')} class="prose-link whitespace-nowrap text-base">All services →</a>
      </div>

      {/*
        FIVE CARDS, AND A GRID THAT DIVIDES THEM. Five never divides into two or
        three columns, so the grid is six columns wide at lg: the first three
        cards take two each, the last two take three each and turn sideways,
        picture beside words, so the second row is not twice as tall as the
        first. At sm it is two columns and the fifth card spans both. On a
        phone they stack, picture first, because the picture is the fastest way
        to say what each service is.
      */}
      <div class="reveal-group grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
        {serviceCards.map((c, i) => {
          const wide = i >= 3;
          return (
            <article
              class:list={[
                'group card-hover card-link flex flex-col overflow-hidden rounded-3xl border border-line bg-surface',
                wide ? 'lg:col-span-3 lg:flex-row' : 'lg:col-span-2',
                i === 4 && 'sm:col-span-2',
              ]}
            >
              <div
                class:list={[
                  'shrink-0 border-b border-line p-2.5 sm:p-3',
                  wide && 'lg:flex lg:w-[52%] lg:items-center lg:border-b-0 lg:border-r',
                ]}
              >
                <ServiceVisual
                  slug={c.slug}
                  class="rounded-2xl transition-transform duration-200 ease-instrument group-hover:-translate-y-0.5"
                />
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <p class="flex items-center gap-2.5">
                  <span class:list={['accent-bar block h-1 w-6 rounded-full', c.accent.bar]} aria-hidden="true"></span>
                  <span class:list={['font-mono text-[11px] font-semibold uppercase tracking-[0.12em]', c.accent.text]}>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </p>
                <h3 class="mt-3 text-[clamp(21px,1.8vw,24px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
                  {c.name}
                </h3>
                <p class="mt-2.5 text-[16px] leading-[1.6] text-body">{c.text}</p>
                <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <span class="text-[22px] font-extrabold leading-none tracking-[-0.04em] text-ink">{c.price}</span>
                  {c.unit && (
                    <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{c.unit}</span>
                  )}
                </p>
                <p class="mt-auto pt-5">
                  <a href={href(`/services/${c.slug}`)} class="prose-link inline-flex items-center gap-1.5 text-[16px]">
                    {c.cta}
                    <span aria-hidden="true" class="inline-block transition-transform duration-200 ease-instrument group-hover:translate-x-1">→</span>
                  </a>
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 02 · TRUSTED BY : the real practices, named, with what each trusted us with
       Text marks, not logos: a logo goes up only once a practice supplies it
       for that use, and a monogram tile would read as their logo. Permission
       is secured off the page and never mentioned on it. -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="clients-title">
    <div class="section-tight shell">
      <SectionHead
        id="clients-title"
        label="Trusted by healthcare practices in Mehsana"
        title="Practices in Mehsana already work with CareInflow."
        lede="Each one trusted us with something different: a website and a Google listing, a steady run of content, a series of reels. Every card links to the work itself."
      />

      {/* Three across from lg; stacked below it, where three columns would
          wrap "Pramukh Multispeciality Dental Clinic" to four lines. */}
      <ul class="reveal-group mt-10 grid gap-4 lg:grid-cols-3 lg:gap-6">
        {CLIENTS.map((c) => <ClientCard client={c} tag="li" />)}
      </ul>
    </div>
  </section>

  <!-- 03 · REAL WORK : the one live website built for a paying practice, in full.
       The row of all four websites follows in its own section, so the real
       build gets the room here and nothing beside it is a sample. -->
  <section class="band-powder" aria-labelledby="case-title">
    <div class="section shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <figure class="relative m-0 pb-10 sm:pb-14">
          <Image
            src={caseStudy.data.cover}
            alt={caseStudy.data.coverAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1440px) 620px, (min-width: 1024px) 46vw, 92vw"
            loading="lazy"
            class="aspect-[16/10] w-full rounded-2xl border border-line bg-surface object-cover object-top shadow-card"
          />
          {caseStudy.data.coverMobile && (
            <Image
              src={caseStudy.data.coverMobile}
              alt={caseStudy.data.coverMobileAlt ?? ''}
              widths={[160, 240, 320]}
              sizes="(min-width: 640px) 160px, 110px"
              loading="lazy"
              class="absolute bottom-0 right-3 w-[110px] rounded-2xl border border-line bg-surface shadow-card-lg sm:right-6 sm:w-[160px]"
            />
          )}
        </figure>

        <div>
          <p class="flex flex-wrap gap-1.5">
            <span class="chip bg-ink text-surface">Real client project</span>
            <span class="chip border border-line bg-surface text-body-deep">{caseStudy.data.sector} · Mehsana</span>
          </p>
          <h2
            id="case-title"
            class="mt-5 text-[clamp(26px,3.2vw,38px)] font-extrabold leading-[1.1] tracking-[-0.035em] text-ink"
          >
            {caseStudy.data.client}
          </h2>
          <p class="mt-4 max-w-[560px] text-[17px] leading-[1.62] text-body">{caseStudy.data.summary}</p>
          <dl class="mt-7 grid max-w-[560px] grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6">
            {caseStudy.data.highlights.map((h) => (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-[20px] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 text-[14px] leading-[1.45] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
          <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={href('/work/pramukh-dental')} class="btn-primary px-6 py-3.5 text-[16px]">Read the case study</a>
            {caseStudy.data.url && (
              <a href={caseStudy.data.url} rel="noopener" class="prose-link text-[16px]">Open the live site →</a>
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · FOUR WEBSITES, LIVE : the whole portfolio as thumbnails.
       Restored on the owner's instruction (2026-10-08): the homepage keeps its
       pictures, because they are what carry a visitor down the page. The
       feature above tells one build in full; this row shows that all four
       exist and can be opened, each labelled "Client work" or "Sample" so the
       two are never told apart by inference. -->
  <section class="bg-surface" aria-labelledby="portfolio-title">
    <div class="section shell">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="portfolio-title"
          label="Our portfolio"
          title="Four websites, live. Open any of them."
          lede="Pramukh's, and three samples built to show a clinic exactly what it receives. Time how fast each one appears and tap its enquiry button. Every card says which is which."
        />
        <a href={href('/work')} class="prose-link whitespace-nowrap text-base">See the portfolio →</a>
      </div>
      {/*
        Four across from xl, two from sm, one on a phone. Four into four
        divides evenly. Not four at lg: Tailwind's lg is 1024, where a quarter
        is 214px, the covers shrink to 106px tall and "Pramukh Multispeciality
        Dental Clinic" wraps to three lines. Not two on a phone either: at 375
        that makes the cover 158x79 and truncates the "Non-healthcare" chip,
        and here the cover is the argument. `layout="quarter"` tells each cover
        its real width.
      */}
      <div class="reveal-group grid items-stretch gap-4 sm:grid-cols-2 sm:gap-6 xl:grid-cols-4">
        {allCaseStudies.map((cs) => (
          <CaseStudyCard study={cs} headingLevel="h3" heading="client" compact layout="quarter" />
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · WHERE PATIENTS LOOK : the four places a patient checks before calling.
       A picture of each place, because the argument is visual: these are four
       different screens, and a patient sees all of them. -->
  <section class="section shell" aria-labelledby="surfaces-title">
    {/* The drawing of the three surfaces together, beside the heading that
        names them: the website behind, the listing in front, the reel in the
        hand, three different practices, in Gujarati. The photographs of each
        follow. It moved here from the hero, which takes a photograph. */}
    <div class="mb-12 grid items-center gap-10 lg:grid-cols-[1fr_520px] lg:gap-16">
      <div>
        <SectionHead
          id="surfaces-title"
          label="Where patients look"
          title="Patients check more than one place before they call."
          lede="Your Google listing, your website, your Instagram, and now the answer Google writes above the results. A patient often sees more than one, so they all have to say the same thing, and all of it has to be right."
        />
        <p class="mt-6">
          <a href={href('/services')} class="prose-link text-base">See all services →</a>
        </p>
      </div>
      <div class="rounded-3xl bg-surgical-tint p-5 sm:p-7">
        <HeroVisual tone="light" class="mx-auto max-w-[480px]" />
      </div>
    </div>
    {/* Four surfaces, two to a row from sm up: a 2x2 keeps each picture large
        enough to read the screen in it. One band height across all four, so
        the rows stay even though two sources are portrait phones and two are
        landscape; the portraits are pulled up the frame so the band opens on
        the phone's screen rather than the space above it. */}
    <div class="reveal-group grid gap-6 sm:grid-cols-2">
      {patientSurfaces.map((s) => (
        <article class="group card-hover card-link flex flex-col overflow-hidden rounded-3xl border border-line bg-surface">
          <span class:list={['accent-bar block h-1 w-full', s.accent.bar]} aria-hidden="true"></span>
          <Image
            src={s.image}
            alt={s.imageAlt}
            widths={[420, 640, 840, 1200]}
            sizes="(min-width: 1440px) 628px, (min-width: 640px) 46vw, 92vw"
            loading="lazy"
            class:list={['h-[180px] w-full border-b border-line object-cover sm:h-[210px] lg:h-[250px]', s.imagePos]}
          />
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <h3 class="text-[clamp(21px,1.9vw,24px)] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">{s.title}</h3>
            <p class="mt-2.5 text-[16px] leading-[1.6] text-body">{s.text}</p>
            <p class="mt-auto pt-5">
              <a href={href(s.link)} class="prose-link inline-flex items-center gap-1.5 text-[16px]">
                {s.linkText}
                <span aria-hidden="true" class="inline-block transition-transform duration-200 ease-instrument group-hover:translate-x-1">→</span>
              </a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 06 · HOW IT WORKS : the page's one dark section
       Dark because it is the section that asks, and the design rule is to
       spend the dark weight on what you want clicked. The photograph is
       where the four steps end: a practice's site in a patient's hand, in the
       clinic's own reception. It sat in this page's old "Why now" band. -->
  <section class="band-panel" aria-labelledby="how-title">
    <div class="section shell">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_440px] lg:gap-16">
        <SectionHead
          id="how-title"
          dark
          label="How it works"
          title="Four steps, and you always know which one you are on."
          lede="The same for every service. Nothing is built, edited or charged before the price and the scope are in writing."
        />
        <Image
          src={receptionPhoneImage}
          alt="A phone held up in a clinic reception, showing a dental practice website with the clinic's name, opening hours, a booking button, and a call and WhatsApp bar along the bottom."
          widths={[440, 660, 880]}
          sizes="(min-width: 1024px) 440px, 92vw"
          loading="lazy"
          class="aspect-[3/2] w-full rounded-3xl border border-panel-line object-cover"
        />
      </div>
      <ol class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="flex flex-col gap-3 border-t-2 border-panel-line-alt pt-6">
            <span class="numeral text-[44px] leading-none text-panel-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[19px] font-bold leading-[1.25] tracking-[-0.02em] text-surface">{s.title}</h3>
            <p class="text-[16px] leading-[1.62] text-panel-text-dim">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-2xl border border-panel-line-alt bg-panel-card px-6 py-6 sm:px-8">
        <p class="max-w-[600px] flex-1 text-[16px] leading-[1.6] text-panel-text">
          Not sure where to start? The free digital review tells you, in two
          working days, and if the answer is "change nothing", we will say that.
        </p>
        <a href={href('/contact')} class="btn-accent shrink-0 px-6 py-3 text-[16px]">Get a free digital review</a>
        <a href={href('/process')} class="link-accent shrink-0 text-[15px]">See the full method →</a>
      </div>
    </div>
  </section>

  <!-- 07 · WHY CAREINFLOW : six things to hold us to, and who does the work.
       The photograph is the outcome rather than the studio: a doctor looking
       at their own practice's site on a phone. -->
  <section class="section shell" aria-labelledby="why-title">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_420px] lg:gap-16">
      <SectionHead
        id="why-title"
        label="Why CareInflow"
        title="A healthcare specialist, not a general agency."
        lede="A studio that builds for a restaurant one month and a clinic the next never learns either properly. These are the six things we work by, and you can hold us to every one."
      />
      <Image
        src={doctorMobileImage}
        alt="A doctor standing in a busy hospital corridor, smiling at their practice website open on a mobile phone."
        widths={[420, 630, 840]}
        sizes="(min-width: 1024px) 420px, 92vw"
        loading="lazy"
        class="h-[220px] w-full rounded-3xl border border-line object-cover object-[50%_25%] sm:h-[260px]"
      />
    </div>
    <ul class="reveal-group mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {why.map((w, i) => (
        <li class="flex gap-4 rounded-2xl border border-line bg-surface p-6">
          <span class:list={['numeral shrink-0 text-[28px] leading-none', cycleAccent(i).text]}>
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="min-w-0">
            <h3 class="text-[17px] font-bold tracking-[-0.02em] text-ink">{w.title}</h3>
            <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{w.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex max-w-[920px] flex-col gap-6 rounded-3xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
      <Image
        src={founderImage}
        alt="Jaidev Jethi, founder of CareInflow."
        widths={[160, 320]}
        sizes="160px"
        loading="lazy"
        class="h-[180px] w-[146px] shrink-0 rounded-2xl border border-line object-cover object-top"
      />
      <div>
        <p class="label-mono text-faint" style="letter-spacing:0.12em">Who does the work</p>
        <h3 class="mt-2 text-[clamp(20px,2.2vw,24px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
          You work directly with the founder, not an account manager.
        </h3>
        <p class="mt-2.5 max-w-[600px] text-[15px] leading-[1.6] text-body">
          CareInflow is run by {BUSINESS.founder}. Web development in Gujarat,
          cybersecurity study in Canada, then a year and a half at Microsoft
          before coming home to start this, in 2026. The person you message is
          the person who edits your reels and builds your site.
        </p>
        <p class="mt-3.5 flex flex-wrap gap-x-5 gap-y-1.5">
          <a href={href('/about')} class="prose-link text-[15px]">More about the studio →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 08 · SPECIALTIES : a photograph of each kind of practice, each a door.
       This was a list of chips. As pictures it does two jobs a list could
       not: it carries the eye down the page, and it shows at a glance that
       the studio is for healthcare broadly, not for one specialty. -->
  <section class="band-powder" aria-labelledby="specialties-title">
    <div class="section shell">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="specialties-title"
          label="Specialties we work with"
          title="Built around the practice you run."
          lede="What a patient needs to see before booking differs from one specialty to the next. Each of these pages says what changes for that kind of practice."
        />
        <a href={href('/specialties')} class="prose-link whitespace-nowrap text-base">All specialties →</a>
      </div>
      {/* Twelve tiles: two, three, four or six to a row, all of which divide
          twelve. The pictures are decorative here (alt=""): the name under each
          says what it is, and twelve described photographs would be read
          aloud in full before the first link. */}
      <ul class="reveal-group grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 xl:grid-cols-6">
        {specialties.map((sp) => (
          <li class="group card-hover card-link flex flex-col overflow-hidden rounded-2xl border border-line bg-surface">
            <Image
              src={sp.data.image}
              alt=""
              widths={[200, 300, 400, 600]}
              sizes="(min-width: 1440px) 197px, (min-width: 1280px) 15vw, (min-width: 1024px) 22vw, (min-width: 640px) 29vw, 44vw"
              loading="lazy"
              class="aspect-[3/2] w-full border-b border-line object-cover"
            />
            <p class="flex flex-1 items-center justify-between gap-2 px-3.5 py-3">
              <a href={href(`/specialties/${sp.id}`)} class="text-[15px] font-semibold leading-[1.3] text-ink hover:no-underline">
                {sp.data.navLabel}
              </a>
              <span aria-hidden="true" class="text-surgical transition-transform duration-200 ease-instrument group-hover:translate-x-0.5">→</span>
            </p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-[860px] text-[15px] leading-[1.6] text-muted">
        If yours is not listed, it almost certainly still fits, so ask. We work
        from Mehsana with practices in
        {' '}<a href={href('/areas/ahmedabad')} class="prose-link">Ahmedabad</a>,
        {' '}<a href={href('/areas/gandhinagar')} class="prose-link">Gandhinagar</a> and across
        {' '}<a href={href('/areas')} class="prose-link">North Gujarat</a>. One studio, no branch offices.
      </p>
    </div>
  </section>

  <!-- 09 · GUIDES : quiet, and after the evidence rather than before it.
       Each with its own lead picture, the one its article opens on. -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="guides-title">
    <div class="section-tight shell">
      <div class="mb-9 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="guides-title"
          label="Guides"
          title="Plain-language guides for clinic owners"
        />
        <a href={href('/resources')} class="prose-link whitespace-nowrap text-base">All guides →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {guides.map((g) => (
          <article class="card-hover card-link flex flex-col overflow-hidden rounded-2xl border border-line bg-canvas">
            {g.data.image && (
              <Image
                src={g.data.image}
                alt=""
                widths={[320, 480, 640, 860]}
                sizes="(min-width: 1440px) 413px, (min-width: 768px) 30vw, 92vw"
                loading="lazy"
                class="aspect-[2/1] w-full border-b border-line object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class:list={['label-mono', topicAccent(g.data.topic).text]}>{topicLabels[g.data.topic]}</p>
              <h3 class="mt-3 text-[18px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">{g.data.title}</h3>
              <p class="mt-2.5 line-clamp-3 text-[15px] leading-[1.6] text-body">{g.data.description}</p>
              <p class="mt-auto pt-4">
                <a href={href(`/resources/${g.id}`)} class="prose-link text-[15px]">Read the guide →</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions"
    title="Questions clinic owners ask us"
  />

  <CtaPanel nextStep={{ label: 'Start with what we do', href: '/services' }} />
</BaseLayout>
