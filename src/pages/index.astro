---
import { getCollection } from 'astro:content';
import { getFaqsFor } from '@/lib/faqs';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import heroImage from '@/assets/editorial/hero-clinic-owner.webp';
import founderImage from '@/assets/jaidev-jethi.jpg';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { BUSINESS, whatsappWithMessage } from '@/config/site';
import { href } from '@/lib/url';
import { BUILDS, PLANS, STANDALONE_MONTHLY, rupees } from '@/config/pricing';
import { serviceAccent, ACCENTS, cycleAccent } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  founderSchema,
  webSiteSchema,
  webPageSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Healthcare Website Design & Local SEO | CareInflow, Mehsana';
const description =
  'Healthcare websites, local SEO and Google Business Profile management for clinics in Mehsana, Ahmedabad and North Gujarat. Free written review, in two days.';

const faqs = await getFaqsFor('home');

/**
 * Healthcare only on the homepage. The non-healthcare project is real work and
 * stays on /work, labelled. But the page two lines above says we build for
 * healthcare "and nothing else", and a taxi service in the featured slot
 * undercuts that before a doctor reaches the second sentence.
 */
const allCaseStudies = (await getCollection('caseStudies')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = allCaseStudies.filter((cs) => cs.data.healthcare);
const otherWorkCount = allCaseStudies.length - featured.length;

const schema = graph(
  organizationSchema(),
  founderSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/', title, description }),
  faqSchema(faqs),
);

/** The three figures a clinic owner is actually scanning for. */
const priceHeadlines = [
  {
    name: 'A practice website',
    value: rupees(BUILDS[0]!.from),
    unit: '',
    note: `Fixed in writing before we start. Most of that figure is the writing and the enquiry path rather than the building. An established clinic with a page per treatment starts at ${rupees(BUILDS[1]!.from)}.`,
  },
  {
    name: 'Your Google listing',
    value: rupees(STANDALONE_MONTHLY.gbp),
    unit: '/ month',
    note: 'Managed properly, month to month. Or a one-time rebuild, with nothing attached.',
  },
  {
    name: 'Website + Google, together',
    value: rupees(PLANS[1]!.monthly),
    unit: '/ month',
    note: 'Both places a patient looks, maintained as one job. Month to month. You stop it by sending a message.',
  },
];

/**
 * What a clinic owner actually wants to know, in the third-most-valuable
 * position on the site. This used to read "<1.2s load target on 4G", "95+
 * Lighthouse score" and "AA accessibility standard": three measurements a
 * doctor has no way to evaluate. The engineering standards still exist and are
 * still published, on the services page where someone technical will look for
 * them.
 */
const heroStats = [
  { value: '4 weeks', caption: 'from first call to launch' },
  { value: 'Free', caption: 'written review before you pay' },
  { value: 'Fixed', caption: 'price agreed in writing' },
  { value: 'Yours', caption: 'domain, hosting and accounts' },
];

/** The value case, stated as mechanisms rather than promised results. */
const outcomes = [
  {
    title: 'Patients can find the treatment they need',
    text: 'Every treatment you offer gets its own page, written in the words patients actually search. One "Services" list cannot do that.',
  },
  {
    title: 'Your Google listing stops costing you visits',
    text: 'Correct categories. Real photographs. Hours that are right, including the festival days everyone forgets. A reply under every review, month after month.',
  },
  {
    title: 'Your site loads before patients give up',
    text: 'Built to open in under 1.2 seconds on a mid-range Android over mobile data. That is the phone your patients are holding.',
  },
  {
    title: 'Enquiries reach a person, not a form',
    text: 'A WhatsApp button that opens a message the patient only has to send. It arrives where your front desk will see it.',
  },
];

/**
 * The three places a patient checks before ringing anyone. Every row here is
 * something a doctor can judge for themselves; the block this replaced showed
 * LCP, CLS and INP with their reference ranges, which is a measurement for the
 * person building the site and means nothing to the person buying it.
 */
const patientSurfaces = [
  {
    title: 'Your Google listing',
    accent: ACCENTS.gbp,
    text: 'For most clinics this is the real homepage: three results, chosen on distance, hours, photos and the newest review. We rebuild the profile and then actually maintain it.',
    rows: [
      ['Categories and services', 'rebuilt'],
      ['Hours, holidays, photos', 'monthly'],
      ['Review replies drafted', 'weekly'],
    ],
    link: '/services/google-business-profile',
    linkText: 'Google Business Profile',
  },
  {
    title: 'Your website',
    accent: ACCENTS.web,
    text: 'Built by hand, not from a theme. A page for each treatment, written in the words patients type. Symptom and cost, not clinical terminology.',
    rows: [
      ['A page per treatment', 'written'],
      ['Opens on mobile data', 'about a second'],
      ['Enquiry from any page', 'two taps'],
    ],
    link: '/services/healthcare-websites',
    linkText: 'Healthcare websites',
  },
  {
    title: 'The answer above the results',
    accent: ACCENTS.seo,
    text: 'Search a treatment today and Google often writes the answer itself, above every link. It builds that from pages it can read and quote. Almost no clinic in India has published the facts it needs.',
    rows: [
      ['Practice and doctor details', 'published'],
      ['Treatments and what they cost', 'stated plainly'],
      ['Questions patients actually ask', 'answered'],
    ],
    link: '/services/local-seo',
    linkText: 'Local SEO groundwork',
  },
];

const protocols = [
  {
    title: 'Practice website',
    text: 'Hand-built, quick on an inexpensive phone, written for a patient who is worried.',
    link: '/services/healthcare-websites',
  },
  {
    title: 'Google Business Profile',
    text: 'Claimed, rebuilt and then maintained: categories, services, hours, photos, questions.',
    link: '/services/google-business-profile',
  },
  {
    title: 'Local SEO groundwork',
    text: 'A page per treatment and per area you serve. Consistent details everywhere.',
    link: '/services/local-seo',
  },
  {
    title: 'AI answer readiness',
    text: 'Facts, schema and plain answers a search engine can quote when it writes the summary above the results.',
    link: '/services/local-seo',
  },
  {
    title: 'Speed & Core Web Vitals',
    text: 'Measured on a mid-range Android on mobile data, not on our laptops.',
    link: '/services/healthcare-websites',
  },
  {
    title: 'Enquiry & booking flow',
    text: 'Usually WhatsApp, set up so the message lands where someone will answer it.',
    link: '/services/healthcare-websites',
  },
  {
    title: 'Maintenance & hosting',
    text: 'Security, backups, edits, new treatment pages. We do not disappear.',
    link: '/services/website-care',
  },
  {
    title: 'Quarterly review',
    text: 'Written: what patients did, what changed nearby, what to do next.',
    link: '/services/website-care',
  },
  {
    title: 'Social media content',
    text: 'Educational posts that support the website. Never a substitute for one.',
    link: '/services/social-media',
  },
];

const method = [
  {
    step: '01',
    title: 'Week 1, study',
    text: 'Your searches, your listing, your reviews, and the three clinics ranking above you. Written up, free, and yours to keep.',
  },
  {
    step: '02',
    title: 'Week 2, structure and words',
    text: 'Page order and final copy signed off before any visual work begins.',
  },
  {
    step: '03',
    title: 'Week 3, design and build',
    text: 'One careful pass on your real content, tested on mobile data first.',
  },
  {
    step: '04',
    title: 'Week 4, launch and stay',
    text: 'Measured against the published targets, then monthly upkeep and a written quarterly review.',
  },
];

/**
 * Specialties we build for. The three with a written page link to it; the rest
 * are chips, because a link that goes nowhere is worse than plain text.
 */
const SPECIALTIES: Array<{ label: string; href?: string }> = [
  { label: 'Dental', href: '/specialties/dental-clinics' },
  { label: 'Dermatology', href: '/specialties/dermatology-clinics' },
  { label: 'Physiotherapy', href: '/specialties/physiotherapy-clinics' },
  { label: 'Ophthalmology' }, { label: 'Orthopaedics' },
  { label: 'Paediatrics' }, { label: 'Gynaecology' }, { label: 'Cosmetic' },
  { label: 'Mental health' }, { label: 'ENT' }, { label: 'Cardiology' },
  { label: 'Diagnostic centres' }, { label: 'Multi-specialty' },
];

const whatsappHref = whatsappWithMessage(
  "Hi CareInflow. I would like a free written review of my practice's online presence. Clinic name: ",
);
---

<BaseLayout {title} {description} path="/" {schema}>
  <!-- HERO : the site's first midnight moment. Same rhythm as PageHero:
       it is allowed to be the tallest page, not to exceed the viewport. -->
  <section class="panel-depth hero-pad">
    <div class="shell">
      <!-- Three children, ordered differently by width. On a phone the proof
           photograph belongs directly under the two buttons, where the visitor
           is deciding, rather than after the stats where it used to sit two
           screens down. On a wide screen it returns to the right column and
           the stats sit back under the copy. -->
      <div
        class="flex flex-col gap-10 lg:grid lg:grid-cols-[1fr_560px] lg:grid-rows-[auto_auto] lg:items-center lg:gap-x-16 lg:gap-y-7"
      >
        <div class="animate-rise lg:col-start-1 lg:row-start-1">
          <p class="inline-flex max-w-full items-center gap-2.5 rounded-full border border-panel-line bg-panel-card px-3.5 py-2">
            <span class="inline-block size-[7px] shrink-0 animate-live rounded-full bg-panel-accent" aria-hidden="true"></span>
            <span class="min-w-0 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text sm:text-[11px] sm:tracking-[0.1em]">
              Healthcare practices only · Mehsana, Gujarat
            </span>
          </p>
          <h1 class="mt-6 text-[clamp(36px,4.4vw,60px)] font-extrabold leading-[1.02] tracking-[-0.05em] text-surface">
            Healthcare websites that patients <span class="text-panel-accent">find, trust and book.</span>
          </h1>
          <p class="mt-5 max-w-[640px] text-[17px] leading-[1.58] text-panel-text">
            We build the website, run the Google listing, and do the local
            search work that puts your practice in front of patients nearby.
            Only healthcare, and only from one studio in Mehsana.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <a href={whatsappHref} rel="noopener" class="btn-accent px-7 py-4 text-base">
              Message us on WhatsApp
            </a>
            <a href={href('/free-review')} class="btn-on-dark px-6 py-[15px] text-base">
              Get a free written review
            </a>
          </div>
        </div>
        <dl class="order-last grid max-w-[620px] grid-cols-2 gap-x-8 gap-y-5 border-t border-panel-line pt-5 sm:grid-cols-4 lg:order-none lg:col-start-1 lg:row-start-2">
          {heroStats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.caption}</dt>
              <dd class="numeral whitespace-nowrap text-[clamp(26px,2.6vw,34px)] text-surface">{stat.value}</dd>
              <dd class="mt-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text-dim">
                {stat.caption}
              </dd>
            </div>
          ))}
        </dl>
        <figure class="m-0 animate-fade lg:col-start-2 lg:row-span-2 lg:row-start-1">
          <!-- Height is capped and the frame cropped: at its native 3:2 this
               image pushed the hero to 76vh, past the rule that no hero fills
               the screen. -->
          <Image
            src={heroImage}
            alt="A phone held up in a clinic reception, showing a dental practice website: the clinic's name, opening hours, a headline reading Gentle dentistry close to home, a booking button, and a call and WhatsApp bar along the bottom."
            widths={[560, 840, 1120]}
            sizes="(min-width: 1024px) 560px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="h-[300px] w-full rounded-3xl border border-panel-line object-cover sm:h-[380px]"
          />
          <!-- The scene and the page on the phone are both made, so the label
               says so, and the link goes to the work that is not. Never let a
               sample interface sit here unmarked: the site is the argument. -->
          <figcaption class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 font-mono text-[11px] uppercase leading-[1.6] tracking-[0.06em] text-panel-text-faint">
            <span class="chip bg-panel-chip text-panel-accent">Illustrative</span>
            <span>A clinic page, on the phone a patient would open it on.</span>
            <a href={href('/work')} class="text-panel-accent underline underline-offset-4 hover:text-surface">
              See real work
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 01 · TRIAGE : THE THREE SURFACES -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="triage-title">
    <div class="section shell">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="triage-title"
          label="Where patients look"
          title="Where patients look for a clinic like yours"
          lede="Your Google listing. Your website. And now the summary Google writes at the top of the results, before a patient reaches either. A patient checks all three before they call anyone, so all three have to agree."
        />
        <a href={href('/services')} class="prose-link whitespace-nowrap text-base">See all services →</a>
      </div>

      <!-- Three places, one weight. The section's argument is that all three
           have to agree, so no card is allowed to shout over the other two;
           the dark panel that used to sit here pulled every eye to the one
           surface a doctor is least likely to be shopping for. Each card is a
           door to the service that fixes it. -->
      <div class="reveal-group grid gap-6 md:grid-cols-3">
        {patientSurfaces.map((s) => (
          <article class="card-hover card-link flex flex-col overflow-hidden rounded-3xl border border-line bg-surface">
            <span class:list={['accent-bar block h-1 w-full', s.accent.bar]} aria-hidden="true"></span>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-[24px] font-bold tracking-[-0.03em] text-ink">{s.title}</h3>
              <p class="mt-3 text-base leading-[1.6] text-body">{s.text}</p>
              <dl class="mt-6 rounded-xl border border-line bg-canvas p-4">
                {s.rows.map((row, i) => (
                  <div
                    class:list={[
                      'flex items-baseline justify-between gap-4 py-2 text-[13px]',
                      i < s.rows.length - 1 && 'border-b border-hairline-soft',
                    ]}
                  >
                    <dt class="text-muted">{row[0]}</dt>
                    <dd class:list={['shrink-0 font-semibold', s.accent.text]}>{row[1]}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-6">
                <a href={href(s.link)} class="prose-link text-[15px] font-semibold">{s.linkText} →</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 · PROTOCOLS : WHAT WE DO -->
  <section class="section shell" aria-labelledby="protocols-title">
    <SectionHead
      id="protocols-title"
      label="What we do"
      title="Everything we do for your clinic"
      lede="Nine of them. Each one closes a specific gap where a patient hesitates or leaves. Most practices need three to begin with, and we tell you which three in writing before you pay anything."
    />
    <!-- Nine cards, so three columns. Two or four leave a single card stranded
         on the last row, which reads as a page that ran out rather than a set
         that is complete. -->
    <div class="reveal-group mt-13 grid gap-4 md:grid-cols-3">
      {protocols.map((p) => (
        <a
          href={href(p.link)}
          class="card-hover block overflow-hidden rounded-2xl border border-line bg-surface hover:no-underline"
        >
          <span class:list={['accent-bar block h-1 w-full', serviceAccent(p.link.split('/').pop()!).bar]} aria-hidden="true"></span>
          <div class="p-6.5">
          <h3 class="text-lg font-bold tracking-[-0.02em] text-ink">{p.title}</h3>
          <p class="mt-2 text-[14px] leading-[1.55] text-muted">{p.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 03 · INDICATION : WHY HEALTHCARE ONLY (the page's one dark panel) -->
  <section class="section shell" aria-labelledby="indication-title">
    <div class="panel-depth rounded-3xl p-8 sm:p-12 lg:p-16">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_520px] lg:gap-16">
        <div>
          <SectionHead
        id="indication-title"
            dark
            label="Why healthcare only"
            title="Why we work with healthcare practices only"
            lede="A studio that builds for a restaurant one month and a clinic the next never learns either one properly. Patients arriving at your website are worried, comparing you to two other practices, and reading on a phone at an odd hour. We only take healthcare work, so that is the visitor we have learned to write for."
          />
          <div class="mt-8 flex flex-wrap gap-2.5">
            <span class="chip border border-panel-line-alt text-panel-text-dim">No ranking guarantees</span>
            <span class="chip border border-panel-line-alt text-panel-text-dim">No bought reviews</span>
            <span class="chip border border-panel-line-alt text-panel-text-dim">No templates resold as bespoke</span>
          </div>
        </div>

        <div class="rounded-3xl border border-panel-line bg-panel-card p-8">
          <h3 class="label-mono mb-5 text-panel-text-faint" style="letter-spacing:0.12em">How the work runs</h3>
          <ol>
            {method.map((m, i) => (
              <li
                class:list={[
                  'grid grid-cols-[62px_1fr] gap-4 py-5',
                  i === 0 && 'pt-0',
                  i < method.length - 1 && 'border-b border-panel-divider',
                  i === method.length - 1 && 'pb-0',
                ]}
              >
                <span class="numeral text-[34px] text-panel-accent">{m.step}</span>
                <div>
                  <h4 class="text-[17px] font-bold text-surface">{m.title}</h4>
                  <p class="mt-1 text-[14px] leading-[1.55] text-panel-text-dim">{m.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <a href={href('/process')} class="link-accent mt-6 inline-block text-[15px]">
            See the full method →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CHANGES : the value case, stated as mechanisms -->
  <section class="band-sage" aria-labelledby="outcomes-title">
    <div class="section shell">
      <div class="max-w-[760px]">
        <div class="band-rule mb-3.5 h-[7px] max-w-[200px]" aria-hidden="true"></div>
        <p class="label-mono mb-5 text-ink/90">What changes</p>
        <h2 id="outcomes-title" class="text-[clamp(30px,4.5vw,46px)] font-extrabold leading-[1.06] tracking-[-0.04em] text-ink">
          What is different once the work is done
        </h2>
        <p class="mt-4.5 text-lg leading-[1.62] text-ink/90">
          We will not promise you a number of patients. Nobody can. Here is
          what we do control, and what changes for your practice once it is
          done.
        </p>
      </div>
      <div class="reveal-group mt-13 grid gap-6 sm:grid-cols-2">
        {outcomes.map((o) => (
          <article class="rounded-2xl border border-line bg-surface p-7">
            <h3 class="text-[19px] font-bold tracking-[-0.02em] text-ink">{o.title}</h3>
            <p class="mt-2.5 text-[15px] leading-[1.62] text-body">{o.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section shell" aria-labelledby="founder-strip-title">
    <div class="reveal flex flex-col gap-7 rounded-3xl border border-line bg-surface p-7 sm:flex-row sm:items-center sm:gap-9 sm:p-9">
      <Image
        src={founderImage}
        alt="Jaidev Jethi, founder of CareInflow."
        widths={[160, 320]}
        sizes="160px"
        loading="lazy"
        class="h-[190px] w-[150px] shrink-0 rounded-2xl border border-line object-cover object-top"
      />
      <div>
        <p class="label-mono text-faint" style="letter-spacing:0.12em">Who does the work</p>
        <h2 id="founder-strip-title" class="mt-2.5 text-[clamp(22px,2.6vw,30px)] font-extrabold leading-[1.12] tracking-[-0.03em] text-ink">
          You talk to the person building your website.
        </h2>
        <p class="mt-3 max-w-[640px] text-[15px] leading-[1.65] text-body">
          CareInflow is run by {BUSINESS.founder}. Web development in
          Gujarat, cybersecurity study in Canada, then a year and a half at
          Microsoft before coming home to start this. There is no account
          manager between you and the work.
        </p>
        <a href={href('/about')} class="prose-link mt-4 inline-block text-[15px]">
          More about the studio →
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT IT COSTS -->
  <section class="band-powder" aria-labelledby="cost-title">
    <div class="section shell">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="cost-title"
          label="What it costs"
          title="Our prices are published, so you do not have to ask."
          lede="Most studios make you sit through a call before they say a number. Here are the starting points; your exact figure is fixed in writing after the free review."
        />
        <a href={href('/pricing') + '#estimate'} class="prose-link whitespace-nowrap text-base">Work out your number →</a>
      </div>
      <div class="reveal-group grid gap-4 sm:grid-cols-3">
        {priceHeadlines.map((p, i) => (
          <article class="card-hover overflow-hidden rounded-3xl border border-line bg-canvas">
            <span class:list={['accent-bar block h-1 w-full', cycleAccent(i).bar]} aria-hidden="true"></span>
            <div class="p-7">
              <h3 class="text-[17px] font-bold tracking-[-0.02em] text-ink">{p.name}</h3>
              <p class="mt-4 flex items-baseline gap-2">
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">from</span>
                <span class="text-[clamp(28px,3.2vw,36px)] font-extrabold leading-none tracking-[-0.045em] text-ink">
                  {p.value}
                </span>
                {p.unit && (
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{p.unit}</span>
                )}
              </p>
              <p class="mt-3.5 text-[14px] leading-[1.6] text-muted">{p.note}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-8 max-w-[680px] text-[15px] leading-[1.65] text-muted">
        Prices exclude GST where it applies. Domain and hosting are paid by
        you, directly, in your own name. We do not mark them up.
      </p>
    </div>
  </section>

  <!-- 04 · FINDINGS : REAL BUILDS -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="featured-title">
    <div class="section shell">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          id="featured-title"
          label="Our work"
          title="Websites we have actually built"
          lede="Not mockups. Open one on your own phone and time it yourself. We would rather hand you a working site than describe one."
        />
        <a href={href('/work')} class="prose-link whitespace-nowrap text-base">See the work →</a>
      </div>

      {featured.map((cs) => (
        <a
          href={href(`/work/${cs.id}`)}
          class="card-hover grid overflow-hidden rounded-3xl border border-line bg-canvas hover:no-underline lg:grid-cols-[1.35fr_1fr]"
        >
          <Image
            src={cs.data.cover}
            alt={cs.data.coverAlt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 780px, 92vw"
            loading="lazy"
            class="h-full w-full border-b border-line bg-surface object-cover object-top lg:border-b-0 lg:border-r"
          />
          <div class="flex flex-col justify-center p-8 sm:p-10">
            <p class="mb-4 flex flex-wrap items-center gap-2">
              <span class="chip border border-line bg-surface text-body-deep">{cs.data.sector}</span>
              <span class="chip bg-hairline-soft text-muted">{cs.data.location}</span>
            </p>
            <h3 class="text-[clamp(22px,2.4vw,28px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
              {cs.data.client}
            </h3>
            <p class="mt-3 text-[15px] leading-[1.62] text-muted">{cs.data.summary}</p>
            <dl class="mt-7 border-t border-hairline pt-5">
              {cs.data.highlights.slice(0, 3).map((h, i) => (
                <div
                  class:list={[
                    'flex items-baseline justify-between gap-6 py-2.5 text-[14px]',
                    i < 2 && 'border-b border-hairline',
                  ]}
                >
                  <dt class="text-muted">{h.label}</dt>
                  <dd class="whitespace-nowrap font-semibold text-pass">{h.value}</dd>
                </div>
              ))}
            </dl>
            <span class="prose-link mt-6 inline-block text-[15px]">Read the case study →</span>
          </div>
        </a>
      ))}

      <p class="mt-7 max-w-[720px] text-[15px] leading-[1.65] text-muted">
        One healthcare project, shown in full, rather than a portfolio padded
        out with work we did not do. {otherWorkCount > 0 && (
          <>There {otherWorkCount === 1 ? 'is' : 'are'} also {otherWorkCount} non-healthcare
          {' '}{otherWorkCount === 1 ? 'project' : 'projects'} on the
          {' '}<a href={href('/work')} class="prose-link">work page</a>, labelled as such,
          because the method is the same even when the client is not a clinic.</>
        )}
      </p>
    </div>
  </section>

  <!-- WHO WE WORK WITH -->
  <section class="band-mist" aria-labelledby="who-title">
    <div class="section shell grid items-center gap-12 lg:grid-cols-[1fr_440px] lg:gap-16">
      <div>
        <SectionHead
          id="who-title"
          label="Who we work with"
          title="Built for the practice you actually run."
        />
        <p class="mt-5 max-w-[620px] text-lg leading-[1.62] text-body">
          A single dentist and a twelve-doctor multi-specialty centre need
          very different websites. We build both. What does not change is the
          method: study first, words before visuals, and one fixed price agreed
          in writing before anything begins.
        </p>
        <p class="mt-4 max-w-[620px] text-lg leading-[1.62] text-body">
          We work from Mehsana, with practices across Gujarat and further out
          where the work suits it. Everything except the photography runs the
          same at a distance, and for photographs we come to you.
        </p>
        <p class="mt-7">
          <a href={href('/pricing')} class="prose-link text-base">See what it costs →</a>
        </p>
      </div>
      <div class="card-hover rounded-3xl border border-line bg-canvas p-8">
        <p class="label-mono text-faint" style="letter-spacing:0.12em">Specialties we build for</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {SPECIALTIES.map((s) => (
            <li>
              {s.href ? (
                <a
                  href={href(s.href)}
                  class="chip inline-flex min-h-[24px] items-center border border-surgical/40 bg-surgical-tint text-surgical hover:border-surgical hover:no-underline"
                >
                  {s.label} →
                </a>
              ) : (
                <span class="chip inline-flex min-h-[24px] items-center border border-line bg-surface text-body-deep">
                  {s.label}
                </span>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-6 border-t border-hairline pt-5 text-[14px] leading-[1.6] text-muted">
          The three linked above have a page on what changes for that
          specialty. <a href={href('/specialties')} class="prose-link">See all
          specialties</a>. If yours is not on this list at all, it almost
          certainly still fits, so ask.
        </p>
      </div>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions"
    title="Questions clinic owners ask us"
  />

  <CtaPanel nextStep={{ label: 'Start with what we do', href: '/services' }} />
</BaseLayout>
