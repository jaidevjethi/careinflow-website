---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PriceEstimator from '@/components/PriceEstimator.astro';
import SectionHead from '@/components/SectionHead.astro';
import QuoteVisual from '@/components/visuals/QuoteVisual.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import ServicePricing from '@/components/ServicePricing.astro';
import WebsitePackages from '@/components/WebsitePackages.astro';
import { href } from '@/lib/url';
import { whatsappFor } from '@/config/site';
import { ACCENTS, cycleAccent } from '@/lib/accents';
import {
  PRICE_PREFIX,
  BUILDS,
  GOOGLE_CARE,
  WEBSITE_CARE,
  ONE_TIME_ITEMS,
  CONTENT_PACKAGES,
  CONTENT_PIECES,
  CONTENT_EXCLUDES,
  CUSTOM_PROJECTS,
  GBP_REBUILD_INCLUDES,
  PRICE_MOVERS,
  WHERE_RETURN_COMES_FROM,
  NEVER_CHARGED,
  PRICE_NOTES,
  PRICE_PROMISE,
  PACKAGE_MATRIX,
  GBP_AUDIT,
  packageLabel,
  rupees,
} from '@/config/pricing';
import { PRICE_TOKENS } from '@/lib/prices';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  offerCatalogSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Clinic Website Cost in Gujarat: Prices Published';
/** Built from the config so the meta description can never drift from the page. */
const description =
  `Clinic websites from ${rupees(BUILDS[0]!.from)}, healthcare reels from ${rupees(PRICE_TOKENS.reel)}, and local SEO and Google care at ${rupees(GOOGLE_CARE.monthly)} a month. Prices published.`;

/** Counts in prose come from the array, so they cannot drift when it grows. */
const NUMBER_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
const spell = (n: number) => NUMBER_WORDS[n] ?? String(n);

const faqs = await getFaqsFor('pricing');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/pricing', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing' },
  ]),
  offerCatalogSchema({
    name: 'CareInflow published prices',
    path: '/pricing',
    offers: [
      ...BUILDS.map((b) => ({
        name: `${b.label} (${b.name})`,
        description: `${b.responsibility} ${b.suits} ${b.pages}, ${b.timeline}.`,
        from: b.from,
        unit: 'project' as const,
      })),
      // Website Care is priced to the site and has no figure, so it is not an
      // offer here: a price that is not published cannot be in the catalog.
      {
        name: GOOGLE_CARE.name,
        description: GOOGLE_CARE.summary,
        from: GOOGLE_CARE.monthly,
        unit: 'month' as const,
      },
      // The regular price, which is the one that runs. The introductory rate
      // is a rule about a client's first three months, not a separate offer.
      ...CONTENT_PACKAGES.map((p) => ({
        name: `${packageLabel(p)} (${p.name})`,
        description: `${p.reels} healthcare reels, ${p.posts} Instagram posts${p.carousels ? ` and ${p.carousels} carousel${p.carousels > 1 ? 's' : ''}` : ''} a month. ${p.suits}`,
        from: p.monthly,
        unit: 'month' as const,
      })),
      ...CONTENT_PIECES.map((o) => ({
        name: o.item,
        description: o.note,
        from: o.price,
        unit: o.unit,
      })),
      ...ONE_TIME_ITEMS.map((o) => ({
        name: o.item,
        description: o.note,
        from: o.price,
        unit: o.unit,
      })),
    ],
  }),
  faqSchema(faqs),
);

/*
 * THE PAGE, redesigned 2026-10-08 for one test from the brief: can a doctor
 * understand what CareInflow costs in thirty seconds, on a phone?
 *
 * It used to open on a stock photograph and run eighteen screens, with the
 * website packages first and everything else found by scrolling. It now
 * opens on every price at once — five cards, one per service, each linking
 * to its detail — and the detail follows in the same order as the services.
 * The long reference material (the line-by-line comparison, what moves a
 * price, where the return comes from) is still here, behind disclosures, so
 * the page reads fast and loses nothing.
 */

/** Every price on one screen: the overview the rest of the page expands. */
const overview = [
  {
    name: 'Healthcare content',
    accent: ACCENTS.social,
    target: '#content',
    caption: 'One reel, or a month of them',
    rows: [
      { label: 'A standard healthcare reel', value: rupees(PRICE_TOKENS.reel), unit: '' },
      ...CONTENT_PACKAGES.map((p) => ({ label: packageLabel(p), value: rupees(p.monthly), unit: '/ mo' })),
    ],
    note: 'Lower introductory rates for your first three billed months.',
  },
  {
    name: 'Healthcare websites',
    accent: ACCENTS.web,
    target: '#packages',
    caption: 'Starting prices, one-time',
    rows: BUILDS.map((b) => ({ label: b.label, value: `${rupees(b.from)}${b.custom ? '+' : ''}`, unit: '' })),
    note: 'Fixed in writing after the free review.',
  },
  {
    name: 'Google Business Profile',
    accent: ACCENTS.gbp,
    target: '#google',
    caption: 'Rebuilt once, then kept up',
    rows: [{ label: 'Profile rebuild', value: rupees(PRICE_TOKENS.gbpRebuild), unit: 'once' }],
    note: 'Kept up every month as part of Local SEO & Google Care. The profile stays in your name.',
  },
  {
    name: 'Local SEO & Google Care',
    accent: ACCENTS.seo,
    target: '#google',
    caption: 'Every month, month to month',
    rows: [{ label: 'Listing, local search and website', value: rupees(GOOGLE_CARE.monthly), unit: '/ mo' }],
    note: 'No ranking guarantee, from us or anyone.',
  },
  {
    name: 'Website Care',
    accent: ACCENTS.care,
    target: '#google',
    caption: 'Every month, month to month',
    rows: [{ label: 'Updates, maintenance, backups where supported', value: 'Custom', unit: '/ mo' }],
    note: 'Priced to your site after the free review.',
  },
];

/** The three website add-ons, beside the packages they extend. */
const addOns = ONE_TIME_ITEMS.filter((i) => !i.item.startsWith('Google Business Profile'));

const principles = [
  {
    title: 'Published prices, then one fixed number in writing',
    text: 'The figures on this page are real starting points, not a range invented to open a conversation. After the free review you receive a scope with one number on it, and that number does not move unless you change the scope, and then it changes in writing too.',
  },
  {
    title: 'The review is free and sometimes the answer is "change nothing"',
    text: 'If your presence is genuinely healthy, the written review says so and costs you nothing. We would rather tell you that than sell you a rebuild you do not need.',
  },
  {
    title: 'You own everything, always',
    text: 'Domain, hosting, code, content, analytics, registered in your name from day one. Stopping never costs you your website.',
  },
  {
    // This card said "We do not run offers" until 2026-10-08, when the owner
    // added an introductory rate to the content packages. It names that one
    // exception rather than quietly contradicting itself.
    title: 'One introductory rate, and no other offers',
    text: 'The content packages start at a lower rate for a new client\'s first three billed months, for every new client, whenever you start. Nothing else is ever taken off. We are not the cheapest option either: freelancers and site builders exist, and for some practices they are enough. We price for work that still looks right, loads fast and gets maintained three years later.',
  },
];

const limits = [
  {
    title: 'We do not promise a ranking',
    text: 'Nobody honestly can. What we promise is the work, and a written report every month showing what it changed.',
  },
  {
    title: 'We do not buy or reward reviews',
    text: 'We set up a way to ask patients who are already happy. We never write one, buy one, or offer anything in return for one.',
  },
  {
    title: "We do not use patients' words without consent",
    text: "A review a patient chose to leave stays where they left it: we answer it, we do not lift it onto a poster. A patient's story is only edited with their written consent, and only where the rules your council sets allow it.",
  },
  {
    title: 'We do not touch patient records',
    text: 'We never ask for access, and nothing we build or run stores them. We do not need them for any of this.',
  },
];

const check = 'M3 8.5l3.5 3.5L13 4.5';
---

<BaseLayout {title} {description} path="/pricing" {schema}>
  <!-- HERO : the picture is the written quote itself, beside the text only.
       On a phone the prices below are the picture, and they come sooner. -->
  <PageHero
    label="Pricing"
    title="Every price, published. You should not have to ask."
    lede="Websites, healthcare content, your Google listing and the care after launch: what each one costs, what it includes and what it does not. Your own figure is fixed in writing before anything starts."
    asideWide
    asideClass="hidden lg:block"
  >
    <QuoteVisual slot="aside" />
    <div class="mt-8 flex flex-wrap items-center gap-3.5">
      <a href={whatsappFor('pricing')} rel="noopener" class="btn-whatsapp px-6 py-3.5 text-[16px]">
        Get a quote in writing
      </a>
      <a href="#estimate" class="btn-on-dark px-6 py-[13px] text-[16px]">
        Work out your number
      </a>
    </div>
    <p class="mt-5 text-[15px] leading-[1.55] text-panel-text-dim">
      Month to month, no lock-in. No deadline is ever attached to a quote, and
      the free digital review costs nothing.
    </p>
  </PageHero>

  <!-- 1 · EVERY PRICE AT ONCE : five cards, one per service, each a door.
       No display heading and a tight top: the hero has just said what this
       is, so the cards start on the first screen instead of a third heading
       restating it. They are also the page's navigation, which is why there
       is no separate jump bar above them any more. -->
  <section id="overview" class="bg-surface" aria-labelledby="overview-title">
    <div class="section-tight shell">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <h2 id="overview-title" class="text-[clamp(22px,2.4vw,28px)] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">
          Five services, each priced.
        </h2>
        <p class="text-[16px] leading-[1.5] text-muted">Tap a card for what is included, and what is not.</p>
      </div>
      {/* The homepage's five-card grid: six columns at lg, three cards then
          two, so five divides evenly; two columns at sm with the fifth
          spanning both; a single stack on a phone. */}
      <div class="reveal-group mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
        {overview.map((o, i) => (
          <article
            class:list={[
              'card-hover card-link group flex flex-col overflow-hidden rounded-3xl border border-line bg-canvas',
              i < 3 ? 'lg:col-span-2' : 'lg:col-span-3',
              i === 4 && 'sm:col-span-2',
            ]}
          >
            <span class:list={['accent-bar block h-1 w-full', o.accent.bar]} aria-hidden="true"></span>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class:list={['font-mono text-[11px] font-semibold uppercase tracking-[0.12em]', o.accent.text]}>
                {o.caption}
              </p>
              <h3 class="mt-2 text-[21px] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">{o.name}</h3>
              <dl class="mt-4 border-t border-line">
                {o.rows.map((r) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-hairline py-2.5">
                    <dt class="min-w-0 text-[15px] leading-[1.4] text-body">{r.label}</dt>
                    <dd class="shrink-0 whitespace-nowrap text-right">
                      <span class="text-[18px] font-extrabold tracking-[-0.03em] text-ink">{r.value}</span>
                      {r.unit && <span class="ml-1 font-mono text-[10.5px] uppercase tracking-[0.06em] text-faint">{r.unit}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="mt-3 text-[14px] leading-[1.5] text-muted">{o.note}</p>
              <p class="mt-auto pt-4">
                <a href={o.target} class="prose-link inline-flex items-center gap-1.5 text-[15px]">
                  What is included
                  <span aria-hidden="true" class="inline-block transition-transform duration-200 ease-instrument group-hover:translate-y-0.5">↓</span>
                </a>
              </p>
            </div>
          </article>
        ))}
      </div>

      {/* The rest of the page, for the reader who knows what they want. Real
          anchors, so it works with JavaScript off. */}
      <nav aria-label="Also on this page" class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-hairline pt-5">
        <p class="label-mono text-faint">Also on this page</p>
        {[
          { label: 'Work out your number', href: '#estimate' },
          { label: 'Larger work, quoted to scope', href: '#other' },
          { label: 'How our pricing works', href: '#how' },
          { label: 'Questions about cost', href: '#faq' },
        ].map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-[24px] items-center text-[15px] text-body-deep underline underline-offset-4 hover:text-ink"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2 · HEALTHCARE CONTENT -->
  <section id="content" class="band-powder" aria-labelledby="content-title">
    <div class="section shell">
      <SectionHead
        id="content-title"
        label="Healthcare content"
        title="Reels and posts, made from your own footage."
        lede="Three monthly packages, each a fixed count of finished pieces, or any single piece on its own. You send the footage and the topics; the editing, captions, graphics and covers are ours."
      />
      <div class="mt-11">
        <ServicePricing slug="healthcare-content" />
      </div>
      <div class="mt-10 grid gap-6 rounded-3xl border border-line bg-surface p-6 sm:p-7 lg:grid-cols-[minmax(0,280px)_1fr] lg:gap-10">
        <p class="text-[17px] font-bold tracking-[-0.02em] text-ink">Not part of a content package</p>
        <ul class="grid gap-x-8 text-[15px] leading-[1.5] text-body sm:grid-cols-2">
          {CONTENT_EXCLUDES.map((line) => (
            <li class="flex gap-2.5 py-1.5">
              <span class="mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-line-strong" aria-hidden="true"></span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 max-w-[760px] text-[16px] leading-[1.65] text-muted">
        What a standard reel includes, and how to send one, is on the
        {' '}<a href={href('/services/reel-editing')} class="prose-link">reel editing page</a>; how
        testimonials and patient privacy are handled is on the
        {' '}<a href={href('/services/healthcare-content')} class="prose-link">healthcare content page</a>.
      </p>
    </div>
  </section>

  <!-- 3 · WEBSITES : the four packages, then the detail behind disclosures -->
  <section id="packages" class="bg-surface" aria-labelledby="builds-title">
    <div class="section shell">
      <SectionHead
        id="builds-title"
        label="Healthcare websites"
        title="Four website packages. Each says how much we do for you."
        lede="The difference is how much of the work we take on, not how many pages you get. Every package ships with your Google listing set up and starts with a look at it, and every price is agreed in writing before we start."
      />

      <WebsitePackages class="mt-11" />

      {/* The add-ons, beside the packages they extend. */}
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {addOns.map((item, i) => (
          <div class="flex flex-col rounded-2xl border border-line bg-canvas p-5">
            <p class="text-[15px] font-bold leading-[1.35] tracking-[-0.01em] text-ink">{item.item}</p>
            <p class="mt-2 flex items-baseline gap-1.5">
              {item.from && <span class="font-mono text-[10.5px] uppercase tracking-[0.08em] text-faint">From</span>}
              <span class:list={['text-[20px] font-extrabold tracking-[-0.03em]', cycleAccent(i).text]}>{rupees(item.price)}</span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.08em] text-faint">{item.unit === 'page' ? '/ page' : 'one-time'}</span>
            </p>
            <p class="mt-2 text-[14px] leading-[1.55] text-muted">{item.note}</p>
          </div>
        ))}
      </div>

      {/* The Google audit, as a short callout: it is part of every package,
          and the one paragraph that stops a website being read as a ranking
          promise. The sixteen checks sit behind a disclosure. */}
      <div class="mt-8 rounded-3xl border border-line bg-canvas p-6 sm:p-7">
        <p class:list={['font-mono text-[11px] font-semibold uppercase tracking-[0.12em]', ACCENTS.gbp.text]}>Before any design</p>
        <p class="mt-2 text-[19px] font-bold tracking-[-0.02em] text-ink">{GBP_AUDIT.headline}</p>
        <p class="mt-3 max-w-[820px] text-[16px] leading-[1.65] text-body-deep">{GBP_AUDIT.statement}</p>
        <details class="group mt-4">
          <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-[15px] font-semibold text-surgical [&::-webkit-details-marker]:hidden">
            See the {GBP_AUDIT.checks.length} things we check
            <svg class="shrink-0 transition-transform duration-200 ease-instrument group-open:rotate-45" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </summary>
          <ul class="mt-4 grid grid-cols-1 gap-x-10 text-[15px] leading-[1.45] text-body sm:grid-cols-2">
            {GBP_AUDIT.checks.map((c) => (
              <li class="flex gap-2.5 py-1">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-a-gbp" aria-hidden="true"></span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </details>
      </div>

      {/* The line-by-line comparison. A real table, because this is tabular
          data, inside a disclosure so it no longer costs three screens to
          scroll past. It needs ~860px to be a comparison at all, so on a
          phone it scrolls sideways inside its own box; every card above
          already lists what it adds. */}
      <details class="group mt-6 rounded-3xl border border-line bg-surface open:shadow-card">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold tracking-[-0.01em] text-ink sm:px-7 [&::-webkit-details-marker]:hidden">
          Compare the four packages, line by line
          <svg class="shrink-0 text-faint transition-transform duration-200 ease-instrument group-open:rotate-45" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </summary>
        <div class="border-t border-line">
          <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Compare the four packages, scrollable">
            <table class="w-full min-w-[860px] border-collapse text-left">
              <caption class="sr-only">What is included in each of the four website packages</caption>
              <thead>
                <tr class="border-b border-line">
                  <th scope="col" class="w-[38%] px-6 py-5 align-bottom">
                    <span class="label-mono text-faint">What you get</span>
                  </th>
                  {BUILDS.map((build, i) => (
                    <th scope="col" class="px-4 py-5 align-bottom">
                      <span class="block text-[15px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">{build.label}</span>
                      <span class:list={['mt-1.5 block font-mono text-[12px]', cycleAccent(i).text]}>
                        {build.custom ? `${PRICE_PREFIX} ` : ''}{rupees(build.from)}
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>
              {PACKAGE_MATRIX.map((group) => (
                <tbody>
                  <tr>
                    <th scope="colgroup" colspan={BUILDS.length + 1} class="border-b border-line bg-canvas px-6 py-2.5">
                      <span class="label-mono text-surgical">{group.group}</span>
                    </th>
                  </tr>
                  {group.rows.map((row) => (
                    <tr class="border-b border-hairline last:border-0">
                      <th scope="row" class="px-6 py-3 text-[15px] font-normal leading-[1.45] text-body">{row.label}</th>
                      {row.values.map((value) => (
                        <td class="px-4 py-3 text-[14px] leading-[1.4]">
                          {typeof value === 'string' ? (
                            <span class="font-semibold text-body-deep">{value}</span>
                          ) : value ? (
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="block text-surgical" role="img" aria-label="Included">
                              <path d="M4.5 12.5l5 5 10-11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          ) : (
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="block text-line-strong" role="img" aria-label="Not included">
                              <path d="M6 12h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                            </svg>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <div class="grid gap-6 border-t border-line px-6 py-6 sm:grid-cols-2 sm:px-7 xl:grid-cols-4">
            {BUILDS.map((build) => (
              <div>
                <p class="text-[15px] font-bold tracking-[-0.02em] text-ink">{build.label}: not included</p>
                <p class="mt-2 text-[14px] leading-[1.55] text-muted">{build.excludes}</p>
              </div>
            ))}
          </div>
        </div>
      </details>

      <p class="mt-7 max-w-[680px] text-[16px] leading-[1.65] text-muted">
        Not sure which one is right for your practice? That is exactly what the
        <a href={href('/contact')} class="prose-link">free digital review</a>
        tells you, and the answer is often "less than you expected". What a
        practice needs also depends on where it is: we build from Mehsana for
        practices in
        {' '}<a href={href('/areas/mehsana')} class="prose-link">Mehsana</a>,
        {' '}<a href={href('/areas/ahmedabad')} class="prose-link">Ahmedabad</a>,
        {' '}<a href={href('/areas/gandhinagar')} class="prose-link">Gandhinagar</a> and
        {' '}<a href={href('/areas')} class="prose-link">across Gujarat</a>.
      </p>
    </div>
  </section>

  <!-- 4 · GOOGLE AND MONTHLY CARE : the rebuild, and the two monthly plans -->
  <section id="google" class="band-mist" aria-labelledby="google-title">
    <span id="monthly" aria-hidden="true"></span>
    <div class="section shell">
      <SectionHead
        id="google-title"
        label="Google, and after launch"
        title="Your Google listing, and the work that keeps going."
        lede="A one-time rebuild for the listing, and two monthly plans for after launch. Both plans run month to month, with no lock-in, and every account stays in your name."
      />
      <div class="reveal-group mt-11 grid items-stretch gap-5 lg:grid-cols-3">
        <!-- The rebuild -->
        <article class="flex flex-col overflow-hidden rounded-3xl border border-line bg-surface">
          <span class:list={['accent-bar block h-1 w-full', ACCENTS.gbp.bar]} aria-hidden="true"></span>
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <p class:list={['font-mono text-[11px] font-semibold uppercase tracking-[0.12em]', ACCENTS.gbp.text]}>One-time</p>
            <h3 class="mt-2 text-[20px] font-extrabold leading-[1.25] tracking-[-0.025em] text-ink">Google Business Profile rebuild</h3>
            <p class="mt-3 flex items-baseline gap-2">
              <span class="settle numeral text-[clamp(30px,3vw,38px)] text-ink">{rupees(PRICE_TOKENS.gbpRebuild)}</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">one-time</span>
            </p>
