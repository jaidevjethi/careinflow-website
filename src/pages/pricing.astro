---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '@/components/PageHero.astro';
import PriceEstimator from '@/components/PriceEstimator.astro';
import SectionHead from '@/components/SectionHead.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Figure from '@/components/Figure.astro';
import pricingConsult from '@/assets/editorial/pricing-consult.webp';
import promiseSeal from '@/assets/mockups/pricing-promise.webp';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import CtaStrip from '@/components/CtaStrip.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import pricingMockup from '@/assets/mockups/hero.jpg';
import { href } from '@/lib/url';
import { whatsappFor, whatsappWithMessage } from '@/config/site';
import { cycleAccent } from '@/lib/accents';
import {
  PRICE_PREFIX,
  BUILDS,
  PLANS,
  STANDALONE_ITEMS,
  ONE_TIME_ITEMS,
  PRICE_MOVERS,
  WHERE_RETURN_COMES_FROM,
  NEVER_CHARGED,
  PRICE_NOTES,
  PRICE_PROMISE,
  STANDALONE_MONTHLY,
  PACKAGE_MATRIX,
  SOCIAL_ADDONS,
  GBP_AUDIT,
  rupees,
} from '@/config/pricing';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  offerCatalogSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'Clinic Website Cost in Gujarat: Prices Published';
/** Built from the config so the meta description can never drift from the page. */
const description =
  `Clinic websites starting from ${rupees(BUILDS[0]!.from)}, with local SEO and Google Business Profile care from ${rupees(PLANS[0]!.monthly)} a month. Prices published, fixed in writing.`;

/** Counts in prose come from the array, so they cannot drift when it grows. */
const NUMBER_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
const spell = (n: number) => NUMBER_WORDS[n] ?? String(n);

/**
 * A WhatsApp opening per package. The funnel keeps prefills in site.ts so the
 * message matches what the visitor was reading; here the thing they were
 * reading is one specific package, so it says which. Saves the studio a
 * round trip and saves the reader explaining themselves.
 */
const askAbout = (name: string) =>
  whatsappWithMessage(
    `Hi CareInflow. I am looking at ${name} and would like a quote in writing, starting with the free review. Clinic name: `,
  );

const faqs = await getFaqsFor('pricing');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/pricing', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing' },
  ]),
  offerCatalogSchema({
    name: 'CareInflow published prices',
    path: '/pricing',
    offers: [
      // The package names already contain "Website", so nothing is appended.
      ...BUILDS.map((b) => ({
        name: b.name,
        description: `${b.responsibility} ${b.suits} ${b.pages}, ${b.timeline}.`,
        from: b.from,
        unit: 'project' as const,
      })),
      ...PLANS.map((p) => ({
        name: p.name,
        description: p.summary,
        from: p.monthly,
        unit: 'month' as const,
      })),
      ...STANDALONE_ITEMS.map((o) => ({
        name: o.item,
        description: o.note,
        from: o.price,
        unit: o.unit,
      })),
      ...ONE_TIME_ITEMS.map((o) => ({
        name: o.item,
        description: o.note,
        from: o.price,
        unit: o.unit,
      })),
    ],
  }),
  faqSchema(faqs),
);

/** The three figures a visitor is really scanning for. */
/*
 * These read left to right under the figure, so the caption has to be a noun
 * phrase. It used to be `${label} · ${suffix}`, which rendered
 * "₹24,999 / WEBSITES, ONE-TIME · FROM" — the word "from" landing after the
 * number it qualifies. Every figure on this page is a starting point and the
 * lede above says so, so the captions just name the thing.
 */
const headline = [
  { label: 'Websites, one-time', value: rupees(BUILDS[0]!.from) },
  { label: 'Local SEO & Google, monthly', value: rupees(PLANS[0]!.monthly) },
  { label: 'Social media, monthly', value: rupees(STANDALONE_MONTHLY.social) },
];

const principles = [
  {
    title: 'Published prices, then one fixed number in writing',
    text: 'The figures on this page are real starting points, not a range invented to open a conversation. After the free review you receive a scope with one number on it, and that number does not move unless you change the scope, and then it changes in writing too.',
  },
  {
    title: 'The review is free and sometimes the answer is "change nothing"',
    text: 'If your presence is genuinely healthy, the written review says so and costs you nothing. We would rather tell you that than sell you a rebuild you do not need.',
  },
  {
    title: 'You own everything, always',
    text: 'Domain, hosting, code, content, analytics, registered in your name from day one. Stopping never costs you your website.',
  },
  {
    title: 'No discounts, honestly',
    text: 'We do not run offers, and we are not the cheapest option, freelancers and site builders exist and for some practices they are enough. We price for work that still looks right, loads fast and gets maintained three years later.',
  },
];
---

<BaseLayout {title} {description} path="/pricing" {schema}>
  <PageHero
    label="Pricing"
    title="Clinic website prices, published. You should not have to ask."
    lede="Most studios make you sit through a call before they tell you a number. Here is what things cost, what makes the price go up, and what we never charge for. Your own figure is fixed in writing after the free review."
    stats={headline.map((h) => ({ value: h.value, caption: h.label }))}
  >
    <div class="mt-7 flex flex-wrap items-center gap-3.5">
      <a href={whatsappFor('pricing')} rel="noopener" class="btn-whatsapp px-6 py-3.5 text-[16px]">
        Get a quote in writing
      </a>
      <a href="#estimate" class="btn-on-dark px-6 py-[13px] text-[16px]">
        Work out your number
      </a>
    </div>

    {/* A photograph, so it takes the plain image treatment the /contact and
        /about heroes use rather than IllustrationPanel, which exists for
        device renders. A 3:2 source in this 260px band keeps 97% of the
        height, so both faces stay in frame on the default centre crop. */}
    <Image
      slot="aside"
      src={pricingConsult}
      alt="A web designer and a doctor either side of a desk, going through a price estimate on a tablet held between them."
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 400px, 92vw"
      loading="eager"
      fetchpriority="high"
      class="h-[340px] w-full rounded-3xl border border-panel-line object-cover"
    />
  </PageHero>

  {/* Moved out of the hero, which was running to 90% of a laptop viewport
      against the design system's ~72% cap. It also belongs here: a jump nav
      is more use directly above the thing it jumps to. Real anchors, so it
      works with JavaScript off, and :root already sets scroll-margin-top so
      each target clears the sticky header. */}
  <nav aria-label="On this page" class="border-b border-hairline bg-canvas">
    <div class="shell flex flex-wrap items-center gap-x-6 gap-y-2 py-4">
      <p class="label-mono text-faint">On this page</p>
      {[
        { label: 'The four packages', href: '#packages' },
        { label: 'Monthly, after launch', href: '#monthly' },
        { label: 'The Google audit', href: '#google-audit' },
        { label: 'What we will not do', href: '#what-we-will-not-do' },
        { label: 'Bought on its own', href: '#add-ons' },
        { label: 'Work out your number', href: '#estimate' },
      ].map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-[24px] items-center text-[15px] text-body-deep underline underline-offset-4 hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>

  <!-- THE PACKAGES -->
  <!-- The decision, and only the decision. These cards used to carry their
       full inclusion list, which made each one about 1000px tall — taller than
       the viewport, so a buyer could never see one whole card, let alone hold
       two side by side. What is in each package now sits in its own block
       directly below, where four columns can be read across rather than
       scrolled through. Nothing is hidden; it is just not all in the card. -->
  <section id="packages" class="border-t border-hairline bg-surface" aria-labelledby="builds-title">
    <div class="section shell">
      <SectionHead
        id="builds-title"
        label="Websites, one-time"
        title="Four packages. Each one says how much we do for you."
        lede="The difference is how much of the work we take on, not how many pages you get. The smallest builds your website and sets it up to be found. The largest plans and builds the whole thing for a practice with several doctors or branches. Every price is agreed in writing before we start."
      />

      <div class="reveal-group mt-12 grid items-stretch gap-5 sm:grid-cols-2">
        {BUILDS.map((build, i) => (
          <article
            class:list={[
              'card-hover flex h-full flex-col overflow-hidden rounded-3xl border bg-canvas',
              build.recommended ? 'border-surgical shadow-card' : 'border-line',
            ]}
          >
            <span class:list={['accent-bar block h-1 w-full', cycleAccent(i).bar]} aria-hidden="true"></span>
            <div class="flex h-full flex-col p-5 sm:p-6">
              {/* The chip band is reserved only once the cards sit side by
                  side. Stacked on a phone there is nothing to align with, and
                  an empty 26px band above the name just reads as a gap. */}
              <div class="sm:min-h-[26px]">
                {build.recommended && (
                  <span class="chip bg-surgical-tint text-surgical">Our recommendation</span>
                )}
                {build.custom && (
                  <span class="chip border border-line bg-surface text-body-deep">Quoted</span>
                )}
              </div>

              {/*
                Two lines reserved for the name and two for the meta, from the
                breakpoint the cards line up at. "Healthcare Website + Local
                SEO" wraps where the other three do not, which pushed its price
                29px below theirs and its body 45px below — and the price row is
                the one row on a comparison grid that has to scan straight
                across. Reserving the space costs a little air on the short
                cards and buys an aligned grid.
              */}
              <h3 class="mt-2.5 text-[18px] font-bold leading-[1.35] tracking-[-0.025em] text-ink sm:min-h-[74px]">
                {build.name}
              </h3>

              <p class="mt-3 flex items-baseline gap-2">
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{PRICE_PREFIX}</span>
                <span class="settle numeral text-[clamp(28px,2.6vw,36px)] text-ink">{rupees(build.from)}</span>
              </p>
              <p class="mt-1.5 font-mono text-[11px] uppercase leading-[1.45] tracking-[0.08em] text-faint sm:min-h-[32px]">
                {build.pages} · {build.timeline}
              </p>

              {/*
                The three components every package is built from, always all
                three. The one a package does not include is dimmed and dashed
                rather than removed, because a visible gap is what makes the
                next rung read as something gained instead of something charged.
                Nothing is hidden and nothing is implied.
              */}
              <ul class="mt-3.5 grid gap-1.5 border-t border-hairline pt-3.5">
                {[
                  { icon: 'website' as const, label: build.stack.website },
                  { icon: 'listing' as const, label: build.stack.listing },
                  { icon: 'search' as const, label: build.stack.seo },
                ].map((part) => (
                  <li class="flex items-center gap-2.5">
                    <span
                      class:list={[
                        'inline-flex size-6 shrink-0 items-center justify-center rounded-md',
                        part.label ? [cycleAccent(i).tint, cycleAccent(i).text] : 'bg-canvas text-faint',
                      ]}
                    >
                      <ServiceIcon name={part.icon} />
                    </span>
                    <span
                      class:list={[
                        'text-[14px] leading-[1.35]',
                        part.label ? 'font-semibold text-ink' : 'text-faint',
                      ]}
                    >
                      {part.label ?? 'Local SEO — not in this package'}
                    </span>
                  </li>
                ))}
              </ul>

              <p class="mt-3 rounded-xl bg-canvas px-3 py-2.5 text-[14px] leading-[1.45] text-body">
                {build.seoLine}
              </p>

              <p class="mt-4 border-t border-hairline pt-4 text-[15px] font-semibold leading-[1.5] text-body-deep">
                {build.responsibility}
              </p>
              

              {/*
                What you actually get, on the card. The cards used to carry a
                responsibility line and a "suits" line and nothing else, so the
                only way to learn what was inside a package was to scroll to the
                comparison table two screens down and read across a row. A buyer
                deciding between four numbers should not have to do that.

                The first row of every package above the smallest says
                "Everything in the ... package", which is what makes the ladder
                read as one ladder rather than four unrelated products.
              */}
              <ul class="mt-4 grow border-t border-hairline pt-4">
                {build.highlights.slice(0, 3).map((h) => (
                  <li class="flex gap-2.5 py-1 text-[14px] leading-[1.45] text-body">
                    <svg
                      class:list={['mt-[3px] size-4 shrink-0', cycleAccent(i).text]}
                      viewBox="0 0 16 16" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 8.5l3.5 3.5L13 4.5" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>



              {/* A CTA in every card, so the ask is never more than a screen
                  away on a page this long, and the message names the package
                  so nobody has to explain which one they meant. */}
              <a
                href={askAbout(build.name)}
                rel="noopener"
                class:list={[
                  'mt-5 w-full justify-center px-5 py-3 text-[15px]',
                  build.recommended ? 'btn-primary' : 'btn-secondary',
                ]}
              >
                {build.custom ? 'Ask for a quote' : 'Start with this'}
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-7 max-w-[680px] text-[16px] leading-[1.65] text-muted">
        Not sure which one is right for your practice? That is exactly what the
        <a href={href('/contact')} class="prose-link">free written review</a>
        tells you, and the answer is often "less than you expected".
      </p>
    </div>
  </section>

  {/*
    The estimator sat seventh of thirteen sections, roughly twelve screens
    down a thirty-four-screen page. It is the strongest thing here: it turns
    four published starting points into one number for the practice actually
    reading, and it ends by attaching that number to a WhatsApp message.

    It belongs immediately after the four packages, which is the moment a
    reader has just asked "which of these is me". Everything below it — the
    inclusion table, the monthly plan, the audit — is detail for someone who
    has already found their shape.
  */}
  <PriceEstimator />

  <!-- WHAT IS IN EACH PACKAGE -->
  <!-- A table, because this is tabular data: one row per thing, one column per
       package, read across. It was four parallel lists, which made a reader
       hold ten lines in their head to work out what the next package added.
       A real <table> is also the right semantics — a screen reader announces
       the row and column headers with every cell, which four <ul>s cannot do.

       It needs 860px to be a comparison at all, so below lg it used to be a
       sideways-scrolling table — 3.3 screens of a phone spent on something a
       reader had to drag left and right to use, which is where phone readers
       stop. Every package card above now lists what it includes, so on a phone
       the table is duplication and the cards are the answer. From lg up, where
       the columns actually fit side by side, the table is the better tool and
       it returns. The region is focusable and labelled for keyboard use. -->
  <section class="band-powder" aria-labelledby="includes-title">
    <div class="section shell">
      <SectionHead
        id="includes-title"
        label="Side by side"
        title="What do you get in each one?"
        lede="Every package includes everything in the one before it, and each card above says what it adds. A tick means included, a dash means not, and we would rather show you that than leave it out."
      />

      <div
        class="mt-11 hidden overflow-x-auto rounded-3xl border border-line bg-surface lg:block"
        tabindex="0"
        role="region"
        aria-label="Compare the four packages, scrollable"
      >
        <table class="w-full min-w-[860px] border-collapse text-left">
          <caption class="sr-only">
            What is included in each of the four website packages
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="w-[38%] px-6 py-5 align-bottom">
                <span class="label-mono text-faint">What you get</span>
              </th>
              {BUILDS.map((build, i) => (
                <th scope="col" class="px-4 py-5 align-bottom">
                  <span class="block text-[15px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">
                    {build.name}
                  </span>
                  <span class:list={['mt-1.5 block font-mono text-[12px]', cycleAccent(i).text]}>
                    {build.custom ? `${PRICE_PREFIX} ` : ''}{rupees(build.from)}
                  </span>
                </th>
              ))}
            </tr>
          </thead>

          {PACKAGE_MATRIX.map((group) => (
            <tbody>
              <tr>
                <th
                  scope="colgroup"
                  colspan={BUILDS.length + 1}
                  class="border-b border-line bg-canvas px-6 py-2.5"
                >
                  <span class="label-mono text-surgical">{group.group}</span>
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr class="border-b border-hairline last:border-0">
                  <th scope="row" class="px-6 py-3 text-[15px] font-normal leading-[1.45] text-body">
                    {row.label}
                  </th>
                  {row.values.map((value) => (
                    <td class="px-4 py-3 text-[14px] leading-[1.4]">
                      {typeof value === 'string' ? (
                        <span class="font-semibold text-body-deep">{value}</span>
                      ) : value ? (
                        <>
                          {/* The tick carries the meaning, so it is not
                              aria-hidden — it gets a text label instead. */}
                          <svg
                            width="18" height="18" viewBox="0 0 24 24" fill="none"
                            class="block text-pass" role="img" aria-label="Included"
                          >
                            <path
                              d="M4.5 12.5l5 5 10-11"
                              stroke="currentColor" stroke-width="2.4"
                              stroke-linecap="round" stroke-linejoin="round"
                            />
                          </svg>
                        </>
                      ) : (
                        <svg
                          width="18" height="18" viewBox="0 0 24 24" fill="none"
                          class="block text-line-strong" role="img" aria-label="Not included"
                        >
                          <path d="M6 12h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                        </svg>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>

      <p class="mt-4 text-[14px] leading-[1.6] text-muted sm:hidden">
        The table scrolls sideways.
      </p>

      {/* What each price does not cover, in the same words the cards use. */}
      <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {BUILDS.map((build) => (
          <div class="border-t border-line pt-4">
            <p class="text-[15px] font-bold tracking-[-0.02em] text-ink">{build.name}</p>
            <p class="mt-2 text-[14px] leading-[1.55] text-muted">{build.excludes}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip text="Send your clinic's name and we will tell you which of these you actually need, free, in two working days." />

  <!-- MONTHLY PLANS -->
  <!-- THE ONE MONTHLY PLAN -->
  <!-- There were five monthly products here, in a three-column grid, with a
       note underneath explaining why a bundle cost less than its parts. One
       plan needs no comparison and no arithmetic, so it gets a single panel
       and the room to list what it actually does. -->
  <section id="monthly" class="band-powder" aria-labelledby="plans-title">
    <div class="section shell">
      <SectionHead
        id="plans-title"
        label="Monthly, after launch"
        title="Going live is the start. One plan keeps it working."
        lede="Month to month, no contract, stop it by sending a message. The website and every account stay in your name whatever you decide."
      />

      {PLANS.map((plan) => (
        <article class="mt-12 overflow-hidden rounded-3xl border border-surgical bg-surface shadow-card">
          <span class="accent-bar block h-1 w-full bg-a-seo-vivid" aria-hidden="true"></span>
          <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,320px)_1fr] lg:gap-14">
            <div>
              <h3 class="text-[22px] font-bold tracking-[-0.025em] text-ink">{plan.name}</h3>
              <p class="mt-2.5 text-[16px] leading-[1.6] text-muted">{plan.summary}</p>
              <p class="mt-6 flex items-baseline gap-2">
                <span class="settle text-[clamp(34px,4vw,46px)] font-extrabold leading-none tracking-[-0.045em] text-ink">
                  {rupees(plan.monthly)}
                </span>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">/ month</span>
              </p>
              <p class="mt-3 font-mono text-[11px] uppercase leading-[1.5] tracking-[0.06em] text-surgical">
                {plan.priceNote}
              </p>
              <p class="mt-5 border-t border-hairline pt-4 text-[15px] leading-[1.6] text-muted">
                {plan.suits}
              </p>
            </div>

            <ul class="grid gap-x-10 border-t border-hairline pt-4 text-[15px] leading-[1.55] text-body sm:grid-cols-2 lg:border-t-0 lg:pt-0">
              {plan.includes.map((line) => (
                <li class="flex gap-3 py-1">
                  <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-pass" aria-hidden="true"></span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}

      <div class="mt-8 max-w-[820px] rounded-2xl border border-line bg-canvas px-6 py-5 sm:px-7">
        <p class="label-mono mb-3 text-faint" style="letter-spacing:0.12em">What it does not promise</p>
        <p class="text-[16px] leading-[1.65] text-body">
          A ranking. What it does promise is steady work every month: your
          listing kept right, your reviews answered, a new page written, and a
          report saying what we did and what changed. Where you end up in the
          results is Google's decision, not ours, and we would be careful with
          anyone who tells you otherwise.
        </p>
      </div>
    </div>
  </section>

  <!-- THE AUDIT THAT STARTS EVERY PROJECT -->
  <!-- The most important section on the page. It is what stops a website
       purchase being read as a ranking promise. -->
  <section id="google-audit" class="section shell" aria-labelledby="audit-title">
    <SectionHead
      id="audit-title"
      label="Before any design"
      title={GBP_AUDIT.headline}
      lede={GBP_AUDIT.lede}
    />

    <div class="mt-11 grid gap-10 lg:grid-cols-[1fr_minmax(0,420px)] lg:gap-16">
      <ul class="grid grid-cols-2 gap-x-5 border-t border-line pt-4 text-[14px] leading-[1.45] text-body sm:gap-x-10 sm:text-[15px]">
        {GBP_AUDIT.checks.map((check) => (
          <li class="flex gap-2.5 py-1">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-a-gbp" aria-hidden="true"></span>
            <span>{check}</span>
          </li>
        ))}
      </ul>

      <aside class="rounded-3xl border border-line bg-canvas p-7 sm:p-8">
        <h3 class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What we are saying, plainly</h3>
        <p class="text-[16px] leading-[1.65] text-body-deep">{GBP_AUDIT.statement}</p>
        <p class="mt-5 border-t border-hairline pt-4 text-[15px] leading-[1.6] text-muted">
          This check is part of every package, and it costs nothing on its own
          either — it comes with the
          {' '}<a href={href('/contact')} class="prose-link">free written review</a>.
        </p>
      </aside>
    </div>
  </section>

  <!-- WHAT WE WILL NOT DO
       The site already contained every fact in this section, scattered across
       three pages and framed as humility: we do not guarantee rankings, we do
       not buy reviews, we do not resell templates. Framed that way it reads as
       a studio managing expectations downward.

       It is the opposite. A doctor advertising in India works under rules that
       do not permit guaranteed outcomes, claims that one practice is better
       than another, or patient testimonials used as adverts — and the licence
       at risk is theirs, not ours. A supplier who already works inside those
       limits is not being modest, they are being competent, and that is a
       reason to hire rather than a caveat to forgive. Same facts, correct frame. -->
  <section id="what-we-will-not-do" class="band-powder" aria-labelledby="limits-title">
    <div class="section shell">
      <div class="max-w-[760px]">
        <SectionHead
          id="limits-title"
          label="How we work"
          title="We work inside the rules you are held to."
          lede="You hold the licence, not us. The rules doctors advertise under here do not allow guaranteed outcomes, claims that one practice is better than another, or patients' words turned into adverts. We do not do those things, and we will say no if you ask us to."
        />
      </div>

      <ul class="reveal-group mt-12 grid gap-5 sm:grid-cols-2">
        {[
          {
            title: 'We do not promise a ranking',
            text: 'Nobody honestly can. What we promise is the work, and a written report every month showing what it changed.',
          },
          {
            title: 'We do not buy or reward reviews',
            text: 'We set up a way to ask patients who are already happy. We never write one, buy one, or offer anything in return for one.',
          },
          {
            title: 'We do not turn patients into adverts',
            text: 'A review a patient chose to leave stays where they left it. We answer it. We do not lift it onto a poster.',
          },
          {
            title: 'We do not touch patient records',
            text: 'We never ask for access, and nothing we build or run stores them. We do not need them for any of this.',
          },
        ].map((r, i) => (
          <li class="flex gap-4 rounded-2xl border border-line bg-surface p-6">
            <span class:list={['numeral shrink-0 text-[26px] leading-none', cycleAccent(i).text]}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              <h3 class="text-[17px] font-bold tracking-[-0.02em] text-ink">{r.title}</h3>
              <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{r.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <p class="mt-9 max-w-[760px] text-[16px] leading-[1.65] text-body-deep">
        If something you ask us for would put your registration at risk, we will
        tell you before you have to find out. That is part of what you are paying
        a healthcare-only studio for.
      </p>
    </div>
  </section>

  <!-- BOUGHT ON ITS OWN -->
  <section id="add-ons" class="section shell" aria-labelledby="separate-title">
    <SectionHead
      id="separate-title"
      label="Bought on its own"
      title="One thing at a time, if that is all you need."
      lede="You do not have to buy a website to work with us. Each of these can be bought on its own, at the price shown."
    />

    <div class="mt-9 grid gap-8 lg:grid-cols-2 lg:gap-14">
      <div>
        <h3 class="label-mono mb-4 text-surgical">Monthly</h3>
        <dl class="border-t border-line">
          {STANDALONE_ITEMS.map((item) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-hairline py-3">
              <dt class="text-[16px] font-semibold leading-[1.45] text-ink">{item.item}</dt>
              <dd class="whitespace-nowrap font-mono text-[15px] font-semibold text-pass">
                {rupees(item.price)}/mo
              </dd>
              <dd class="mt-1 w-full text-[14px] leading-[1.5] text-muted">{item.note}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div>
        <h3 class="label-mono mb-4 text-surgical">One-time</h3>
        <dl class="border-t border-line">
          {ONE_TIME_ITEMS.map((item) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-hairline py-3">
              <dt class="text-[16px] font-semibold leading-[1.45] text-ink">{item.item}</dt>
              <dd class="whitespace-nowrap font-mono text-[15px] font-semibold text-pass">
                {item.from ? `${PRICE_PREFIX} ` : ''}{rupees(item.price)}{item.unit === 'page' ? '/page' : ''}
              </dd>
              <dd class="mt-1 w-full text-[14px] leading-[1.5] text-muted">{item.note}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    {/* Ranges, not fixed figures, because the work genuinely varies. A
        seven-slide researched carousel and a static post are not the same
        production, and pricing them the same is how a content plan quietly
        stops being profitable. */}
    <div class="mt-10">
      <h3 class="label-mono mb-4 text-surgical">Social media, quoted on top</h3>
      <dl class="border-t border-line">
        {SOCIAL_ADDONS.map((item) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-hairline py-3">
            <dt class="text-[16px] font-semibold leading-[1.45] text-ink">{item.item}</dt>
            <dd class="whitespace-nowrap font-mono text-[15px] font-semibold text-pass">{item.price}</dd>
            <dd class="mt-1 w-full text-[14px] leading-[1.5] text-muted">{item.note}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 max-w-[760px] text-[15px] leading-[1.6] text-muted">
        Your advertising spend is always separate, paid by you directly, and
        never marked up by us. Full scope on the
        {' '}<a href={href('/services/social-media')} class="prose-link">social media page</a>.
      </p>
    </div>

    <div class="mt-10 max-w-[820px] rounded-3xl border border-line bg-surface p-6 sm:p-7">
      <h3 class="text-[19px] font-bold tracking-[-0.02em] text-ink">What we never charge for</h3>
      <ul class="mt-4 text-[15px] leading-[1.55] text-body">
        {NEVER_CHARGED.map((line) => (
          <li class="flex gap-3 border-b border-hairline py-2.5 last:border-0">
            <span class="mt-[10px] h-1.5 w-1.5 shrink-0 rounded-full bg-pass" aria-hidden="true"></span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- WHERE THE RETURN COMES FROM -->
  <!-- The longest page on the site ran eight sections without a single image.
       The render carries its own backdrop, so it sits on the section colour
       rather than needing a tint behind it. -->
  <section class="section shell" aria-labelledby="return-title">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_460px] lg:gap-16">
      <SectionHead
        id="return-title"
        label="Where the return comes from"
        title={WHERE_RETURN_COMES_FROM.headline}
        lede={WHERE_RETURN_COMES_FROM.lede}
      />
      <IllustrationPanel
        src={pricingMockup}
        alt="A clinic website shown on a laptop and a phone, with the treatment pages and the enquiry button visible."
        maxWidth={460}
        class="mx-auto lg:ml-auto lg:mr-0"
      />
    </div>
    {/*
      Six padded cards ran 3.4 screens on a phone, eighteen screens down a page
      whose decision is made in the first five. The content earns its place;
      the packaging did not. A ruled list carries the same six points in
      roughly half the height, and it reads differently from the card grids
      above it, which is worth having on a page this long.
    */}
    <ul class="reveal-group mt-11 grid gap-x-12 border-t border-line sm:grid-cols-2">
      {WHERE_RETURN_COMES_FROM.points.map((p, i) => (
        <li class="flex gap-4 border-b border-hairline py-5">
          <span class:list={['numeral shrink-0 text-[26px] leading-none', cycleAccent(i).text]}>
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="min-w-0">
            <h3 class="text-[17px] font-bold tracking-[-0.02em] text-ink">{p.title}</h3>
            <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-[760px] rounded-2xl border border-line bg-surface px-6 py-5 text-[16px] leading-[1.65] text-body sm:px-7">
      {WHERE_RETURN_COMES_FROM.closing}
    </p>
  </section>

  <!-- WHAT MOVES THE PRICE -->
  <section class="section shell" aria-labelledby="movers-title">
    <SectionHead
      id="movers-title"
      label="What moves the number"
      title={`What decides where your price lands? ${spell(PRICE_MOVERS.length)} things.`}
      lede="A quotation with no explanation is just a number to argue about. These are the factors we actually price against, in the order they matter."
    />
    <div class="mt-10 max-w-[900px] overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Factors that change the price of an engagement</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="label-mono py-3 pr-6 text-faint">Factor</th>
            <th scope="col" class="label-mono py-3 text-faint">What it does to the price</th>
          </tr>
        </thead>
        <tbody>
          {PRICE_MOVERS.map((m) => (
            <tr class="border-b border-hairline align-top">
              <th scope="row" class="w-[38%] py-4 pr-6 text-[16px] font-semibold leading-[1.5] text-ink">
                {m.factor}
              </th>
              <td class="py-4 text-[16px] leading-[1.6] text-body">{m.effect}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/*
      "How our pricing behaves" was its own section two screens further down,
      answering the same question this one does: why is the number what it is.
      Folded in here, and the four cards are a ruled list rather than four
      padded boxes — same four principles, about a third of the height.
    */}
    <div class="mt-14 border-t border-line pt-10">
      <h3 class="text-[clamp(22px,2.4vw,28px)] font-extrabold leading-[1.15] tracking-[-0.035em] text-ink">
        How our pricing behaves
      </h3>
      <ul class="mt-7 grid max-w-[980px] gap-x-12 sm:grid-cols-2">
        {principles.map((pr, i) => (
          <li class="flex gap-4 border-b border-hairline py-5">
            <span class:list={['numeral shrink-0 text-[28px] leading-none', cycleAccent(i).text]}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              <h4 class="text-[16px] font-bold tracking-[-0.02em] text-ink">{pr.title}</h4>
              <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{pr.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-8 max-w-[980px] rounded-2xl border border-line bg-surface px-6 py-5 sm:px-7">
        <p class="label-mono mb-3 text-faint" style="letter-spacing:0.12em">The small print, in full</p>
        <ul class="text-[15px] leading-[1.6] text-muted">
          {PRICE_NOTES.map((note) => (
            <li class="border-b border-hairline py-2.5 last:border-0 last:pb-0">{note}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaStrip text="Not sure which of these your practice actually needs? The free review will say so, honestly." />

  <!-- THE PRICE PROMISE — the page's one dark panel -->
  <section class="section shell" aria-labelledby="promise-title">
    <div class="panel-depth panel-box">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_360px] lg:gap-16">
        <div>
          <SectionHead
            dark
            id="promise-title"
            label="What the number does"
            title={PRICE_PROMISE.headline}
            lede={PRICE_PROMISE.body}
          />
          <p class="mt-7 max-w-[620px] text-[16px] leading-[1.65] text-panel-text-dim">
            You will never be asked to decide on a call. The figure, the scope
            and the exclusions arrive in writing after the free review, and
            they stay there while you think about it.
          </p>
          <p class="mt-8 flex flex-wrap gap-4">
            <a href={href('/contact')} class="btn-accent px-6 py-3.5 text-[16px]">
              Start with the free review
            </a>
            <a href={href('/services')} class="link-accent self-center text-base">
              See what each engagement includes →
            </a>
          </p>
        </div>

        <div class="rounded-3xl border border-panel-line bg-panel-card p-7">
          <p class="label-mono text-panel-text-faint" style="letter-spacing:0.12em">What is fixed</p>
          <dl class="mt-5">
            {[
              ['One number', 'agreed before work starts'],
              ['Scope and exclusions', 'listed with equal weight'],
              ['Monthly plans', 'month to month, no lock-in'],
              ['Your accounts', 'in your name from day one'],
            ].map(([term, detail], i, arr) => (
              <div class:list={['py-3', i < arr.length - 1 && 'border-b border-panel-divider']}>
                <dt class="text-[16px] font-bold text-surface">{term}</dt>
                <dd class="mt-0.5 text-[15px] leading-[1.55] text-panel-text-dim">{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
        {/* Sits under the list it illustrates rather than beside the heading:
            the four fixed things are the promise, and the seal is the picture
            of it. */}
        <Figure
          src={promiseSeal}
          alt="A printed fixed-price agreement with a seal on it, two people shaking hands out of focus behind."
          maxWidth={360}
          class="lg:col-start-2"
        />
      </div>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions about pricing"
    title="Questions about cost"
  />

  <CtaPanel prefill="pricing" nextStep={{ label: 'Start with the free review', href: '/contact' }} />
</BaseLayout>
