  <!-- 7 · HOW OUR PRICING WORKS : the rules every number follows, beside the
       things we will not do, then the reasoning behind disclosures.

       These were two sections of four numbered cards each, one after the
       other, and read as the same section twice. Side by side they read as
       what they are: the two halves of one promise.

       The second half is not modesty: a doctor advertising in India works
       under rules that do not permit guaranteed outcomes, comparative claims
       or patients' words used as adverts, and the licence at risk is theirs.
       A supplier already working inside those limits is being competent, not
       careful. -->
  <section id="how" class="band-powder" aria-labelledby="how-title">
    <div class="section shell">
      <SectionHead
        id="how-title"
        label="How our pricing works"
        title="Four rules we price by. Four things we will not do."
      />
      <div class="reveal-group mt-10 grid items-start gap-5 lg:grid-cols-2">
        <div class="rounded-3xl border border-line bg-surface p-6 sm:p-8">
          <h3 class="text-[20px] font-extrabold tracking-[-0.025em] text-ink">The rules every price follows</h3>
          <ol class="mt-5">
            {principles.map((pr, i) => (
              <li class="flex gap-4 border-t border-hairline py-4 last:pb-0">
                <span class:list={['numeral w-9 shrink-0 text-[24px] leading-none', cycleAccent(i).text]}>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <h4 class="text-[16px] font-bold leading-[1.4] tracking-[-0.015em] text-ink">{pr.title}</h4>
                  <p class="mt-1 text-[15px] leading-[1.6] text-body">{pr.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div id="what-we-will-not-do" class="rounded-3xl border border-line bg-surface p-6 sm:p-8">
          <h3 class="text-[20px] font-extrabold tracking-[-0.025em] text-ink">We work inside the rules you are held to</h3>
          <p class="mt-2 text-[15px] leading-[1.6] text-muted">
            You hold the licence, not us. The rules doctors advertise under do
            not allow guaranteed outcomes, claims that one practice is better
            than another, or patients' words turned into adverts. We will say no
            if you ask us to.
          </p>
          <ol class="mt-5">
            {limits.map((r, i) => (
              <li class="flex gap-4 border-t border-hairline py-4 last:pb-0">
                <span class:list={['numeral w-9 shrink-0 text-[24px] leading-none', cycleAccent(i + 1).text]}>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <h4 class="text-[16px] font-bold leading-[1.4] tracking-[-0.015em] text-ink">{r.title}</h4>
                  <p class="mt-1 text-[15px] leading-[1.6] text-body">{r.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="mt-5 grid gap-3.5">
        <details class="group rounded-2xl border border-line bg-surface open:shadow-card">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold tracking-[-0.01em] text-ink [&::-webkit-details-marker]:hidden">
            What decides where your price lands? {spell(PRICE_MOVERS.length)} things.
            <svg class="shrink-0 text-faint transition-transform duration-200 ease-instrument group-open:rotate-45" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </summary>
          <dl class="grid gap-x-10 px-6 pb-6 md:grid-cols-2">
            {PRICE_MOVERS.map((m) => (
              <div class="border-t border-hairline py-4">
                <dt class="text-[16px] font-semibold leading-[1.5] text-ink">{m.factor}</dt>
                <dd class="mt-1 text-[15px] leading-[1.6] text-body">{m.effect}</dd>
              </div>
            ))}
          </dl>
        </details>

        <details class="group rounded-2xl border border-line bg-surface open:shadow-card">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold tracking-[-0.01em] text-ink [&::-webkit-details-marker]:hidden">
            {WHERE_RETURN_COMES_FROM.headline}
            <svg class="shrink-0 text-faint transition-transform duration-200 ease-instrument group-open:rotate-45" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </summary>
          <div class="px-6 pb-6">
            <p class="max-w-[860px] text-[16px] leading-[1.65] text-body">{WHERE_RETURN_COMES_FROM.lede}</p>
            <ul class="mt-4 grid gap-x-10 sm:grid-cols-2">
              {WHERE_RETURN_COMES_FROM.points.map((p) => (
                <li class="border-t border-hairline py-4">
                  <h4 class="text-[16px] font-bold tracking-[-0.02em] text-ink">{p.title}</h4>
                  <p class="mt-1.5 text-[15px] leading-[1.6] text-body">{p.text}</p>
                </li>
              ))}
            </ul>
            <p class="mt-2 text-[15px] leading-[1.6] text-muted">{WHERE_RETURN_COMES_FROM.closing}</p>
          </div>
        </details>

        <details class="group rounded-2xl border border-line bg-surface open:shadow-card">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold tracking-[-0.01em] text-ink [&::-webkit-details-marker]:hidden">
            The small print, in full
            <svg class="shrink-0 text-faint transition-transform duration-200 ease-instrument group-open:rotate-45" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </summary>
          <ul class="px-6 pb-6 text-[15px] leading-[1.6] text-body">
            {PRICE_NOTES.map((note) => (
              <li class="border-t border-hairline py-3">{note}</li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </section>

  <!-- 8 · THE PRICE PROMISE — the page's one dark panel -->
  <section class="section shell" aria-labelledby="promise-title">
    <div class="panel-depth panel-box">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_360px] lg:gap-16">
        <div>
