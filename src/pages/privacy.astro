---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUSINESS } from '@/config/site';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const title = 'Privacy — what this site does and does not collect | CareInflow';
const description =
  'CareInflow\'s privacy note in plain language: this website sets no tracking cookies and runs no third-party trackers. What we keep when you contact us, and how to have it removed.';

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/privacy', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy' },
  ]),
);
---

<BaseLayout {title} {description} path="/privacy" {schema}>
  <section class="mx-auto max-w-[1440px] px-5 pb-16 pt-14 sm:px-10 sm:pt-20 xl:px-20">
    <div class="tick-rule mb-3.5" aria-hidden="true"></div>
    <p class="label-mono mb-5 text-surgical">Privacy</p>
    <h1 class="max-w-[820px] text-[clamp(32px,4.6vw,54px)] font-extrabold leading-[1.05] tracking-[-0.045em] text-ink">
      This site collects as little as we could manage.
    </h1>
  </section>

  <div class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1440px] px-5 py-14 sm:px-10 sm:py-20 xl:px-20">
      <div class="prose-ci">
        <h2>What this website collects</h2>
        <p>
          Nothing personal. This site sets no tracking cookies, runs no
          advertising pixels, and embeds no third-party trackers. It is
          static pages served from a hosting provider, which — like all web
          hosts — keeps standard technical logs (such as IP addresses) for
          security and operations.
        </p>
        <h2>When you contact us</h2>
        <p>
          If you message us on WhatsApp or email, we receive what you send —
          your number or address and the message itself. We use it to reply
          and, if you engage us, to do the work. We do not sell it, share it,
          or add you to a mailing list you did not ask for.
        </p>
        <p>
          If you would like your contact history deleted, message us and we
          will delete it and confirm.
        </p>
        <h2>Client work and patient privacy</h2>
        <p>
          When we manage a practice's online presence, we sometimes see
          patient-authored content such as public reviews. We treat it with
          the care healthcare deserves: review replies we draft never confirm
          or reveal details of anyone's treatment, and we never request
          access to patient records — we do not need it for anything we do.
        </p>
        <h2>Questions</h2>
        <p>
          Ask us directly: {BUSINESS.phoneDisplay} or {BUSINESS.email}. This
          note was last updated in July 2026 and changes only when our
          practices change.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
