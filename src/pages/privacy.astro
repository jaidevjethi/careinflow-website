---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { BUSINESS, BOOKING_URL, WHATSAPP_URL } from '@/config/site';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const title = 'Privacy, what this site does and does not collect | CareInflow';
const description =
  'Plain language: this website sets no tracking cookies and runs no third-party trackers. What we keep when you contact us, and how to remove it.';

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/privacy', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy' },
  ]),
);
---

<BaseLayout {title} {description} path="/privacy" {schema}>
  <PageHero
    compact
    label="Privacy"
    title="This site collects as little as we could manage."
    lede="Written in plain language rather than legal boilerplate, because a note nobody can read is not a disclosure. It is short because there is genuinely very little to disclose."
  />

  <div class="border-t border-hairline bg-surface">
    <div class="section shell">
      <div class="prose-ci">
        <h2>What this website collects</h2>
        <p>
          Nothing personal. This site sets no tracking cookies, runs no
          advertising pixels, and embeds no third-party trackers. It is
          static pages served from a hosting provider, which, like all web
          hosts, keeps standard technical logs (such as IP addresses) for
          security and operations.
        </p>
        <h2>When you contact us</h2>
        <p>
          WhatsApp and the phone both run through one number. When you message
          or call, we receive your number and what you send. We use it to reply
          and, if you engage us, to do the work. We do not sell it, share it,
          or add you to a mailing list. There is no mailing list.
        </p>
        <p>
          There is a third route, and it is worth being clear about because it
          is the one place a third party is involved. The
          {' '}<a href={BOOKING_URL} rel="noopener">booking link</a> in our
          footer opens Calendly, a scheduling service we do not run. Whatever
          you give it — usually a name, an email address and a time — is held
          by Calendly under their privacy policy as well as reaching us. It is
          a link, not an embed: nothing from Calendly loads on this site unless
          you choose to go there, which is why the page you are reading still
          sets no cookies. If you would rather not use it, WhatsApp reaches the
          same person.
        </p>
        <p>
          If you would like your contact history deleted, message us and we
          will delete it and confirm.
        </p>
        <h2>Client work and patient privacy</h2>
        <p>
          When we manage a practice's online presence, we sometimes see
          patient-authored content such as public reviews. We treat it with
          the care healthcare deserves: review replies we draft never confirm
          or reveal details of anyone's treatment, and we never request
          access to patient records. We do not need them for anything we do.
        </p>
        <h2>Questions</h2>
        <p>
          Ask us directly on {BUSINESS.phoneDisplay}, by
          {' '}<a href={WHATSAPP_URL} rel="noopener" class="link-whatsapp">WhatsApp</a> or
          {' '}<a href={`tel:${BUSINESS.phone}`} class="prose-link">phone</a>. This note
          was last updated in July 2026 and changes only when our practices do.
          If anything here is unclear, our
          {' '}<a href={href('/contact')} class="prose-link">contact page</a> says what
          happens after you get in touch.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
