---
import { getFaqsFor } from '@/lib/faqs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import { cycleAccent } from '@/lib/accents';
import { PLANS, STANDALONE_MONTHLY, rupees } from '@/config/pricing';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '@/lib/schema';

const title = 'The method — how a four-week build runs | CareInflow';
const description =
  'What happens if you hire CareInflow: a free written study, words signed off before any design, one build pass, then launch and ongoing care.';

const faqs = await getFaqsFor('process');

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/process', title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Method', path: '/process' },
  ]),
  faqSchema(faqs),
);

const weeks = [
  {
    step: '01',
    week: 'Week 1',
    title: 'Study',
    text: 'Before any design, we study: what patients in your area search, what your Google listing shows, what your reviews say, and what the three clinics above you are doing differently. It arrives as a written review — yours to keep, free, whether or not you hire us.',
    output: 'A written review of your current online presence',
  },
  {
    step: '02',
    week: 'Week 2',
    title: 'Structure & words',
    text: 'The page order and the actual copy come before any visuals. You sign off the words patients will read — every treatment page, every heading — so design decorates substance instead of hiding its absence.',
    output: 'Sitemap and final copy, signed off',
  },
  {
    step: '03',
    week: 'Week 3',
    title: 'Design & build',
    text: 'One careful pass, on your real content, never on placeholder text. Built by hand, tested on a mid-range Android over mobile data first — because that is the phone your patients actually hold.',
    output: 'The working website, tested on real devices',
  },
  {
    step: '04',
    week: 'Week 4 →',
    title: 'Launch, then stay',
    text: 'Launch is measured against the published targets: load time reference, accessibility, valid schema. Then the ongoing schedule begins — weekly monitoring, monthly maintenance, and a written quarterly review.',
    output: 'Launch measurements + the care schedule',
  },
];

const needFromYou = [
  { item: 'A one-hour conversation about your practice', when: 'week 1' },
  { item: 'Treatment list and how you prefer to describe costs', when: 'week 2' },
  { item: 'Sign-off on structure and words', when: 'end of week 2' },
  { item: 'Access for photos, or a visit arranged', when: 'week 3' },
  { item: 'A final yes before launch', when: 'week 4' },
];
---

<BaseLayout {title} {description} path="/process" {schema}>
  <PageHero
    label="How the work runs"
    title="Four weeks, in a fixed order, with the words before the visuals."
    lede="Most website projects go wrong in a familiar way: design first, content forever late, launch quietly missed. Our method exists to make that impossible — each week has one job and one output you can hold."
    stats={weeks.map((w) => ({ value: w.step, caption: `${w.week} — ${w.title}` }))}
  />

  <section class="border-t border-hairline bg-surface" aria-label="The four weeks">
    <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-10 sm:py-20 xl:px-20">
      <ol class="grid gap-5 lg:max-w-[920px]">
        {weeks.map((w, i) => (
          <li class:list={['card-hover grid gap-5 rounded-3xl border border-line p-8 sm:grid-cols-[110px_1fr]', cycleAccent(i).tint]}>
            <div>
              <p class:list={['numeral text-[clamp(44px,5vw,64px)]', cycleAccent(i).text]}>{w.step}</p>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.08em] text-faint">{w.week}</p>
            </div>
            <div>
              <h2 class="text-[24px] font-extrabold tracking-[-0.03em] text-ink">{w.title}</h2>
              <p class="mt-3 max-w-[640px] text-[15.5px] leading-[1.65] text-body">{w.text}</p>
              <p class="mt-4 font-mono text-[10.5px] uppercase tracking-[0.08em] text-pass">
                Output — {w.output}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 sm:py-[110px] xl:px-20" aria-labelledby="need-title">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_440px] lg:gap-20">
      <div>
        <SectionHead
          label="What we need from you"
          title="How much of your time does it take?"
          lede="Everything else is our job. The build does not stall waiting for you to write pages — writing them is part of what you are paying for."
        />
      </div>
      <div class="rounded-3xl border border-line bg-surface p-7">
        <h2 id="need-title" class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">From your side</h2>
        <dl>
          {needFromYou.map((n, i) => (
            <div
              class:list={[
                'flex items-baseline justify-between gap-6 py-3 text-[14px]',
                i < needFromYou.length - 1 && 'border-b border-hairline',
              ]}
            >
              <dt class="text-body-deep">{n.item}</dt>
              <dd class="whitespace-nowrap font-mono text-[10.5px] uppercase tracking-[0.06em] text-surgical">{n.when}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline bg-surface" aria-labelledby="after-title">
    <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-10 sm:py-20 xl:px-20">
      <SectionHead
        id="after-title"
        label="After week four"
        title="What happens after week four?"
        lede="Launch begins the maintenance schedule: weekly monitoring, monthly upkeep, and a quarterly written review of what patients did and what to do next. The full schedule is on the ongoing care page."
      />
      <p class="mt-6 max-w-[680px] text-[15.5px] leading-[1.65] text-muted">
        Care is {rupees(STANDALONE_MONTHLY.care)} a month, or
        {' '}{rupees(PLANS[1]!.monthly)} with your Google Business Profile
        managed alongside it. Month to month, no lock-in, and the website stays
        yours either way — see the <a href={href('/pricing')} class="prose-link">full price list</a>.
      </p>
      <p class="mt-7">
        <a href={href('/services/website-care')} class="btn-secondary px-6 py-3.5 text-[15px]">
          See the care schedule
        </a>
      </p>
    </div>
  </section>

  <FaqSection
    {faqs}
    label="Questions about the method"
    title="Questions about how we work"
  />

  <CtaPanel nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
