---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import CtaStrip from '@/components/CtaStrip.astro';
import { CANONICAL_HOST } from '@/config/site';
import { topicAccent } from '@/lib/accents';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  founderSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  articleSchema,
} from '@/lib/schema';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({
    params: { slug: resource.id },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);

const path = `/resources/${resource.id}`;
const title = `${resource.data.title} | CareInflow`;
const description = resource.data.description;

const schema = graph(
  organizationSchema(),
  founderSchema(),
  webSiteSchema(),
  webPageSchema({ path, title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
    { name: resource.data.title, path },
  ]),
  articleSchema({
    path,
    title: resource.data.title,
    description,
    publishDate: resource.data.publishDate,
    updatedDate: resource.data.updatedDate,
    // Google treats Article.image as required for a rich result. These guides
    // have no bespoke artwork yet, so the studio card stands in — real file,
    // real dimensions, rather than a URL that does not resolve.
    image: { url: `${CANONICAL_HOST}/og-default.png`, width: 2500, height: 1313 },
  }),
);

const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  {title}
  {description}
  {path}
  {schema}
  ogType="article"
  publishDate={resource.data.publishDate}
  updatedDate={resource.data.updatedDate}
>
  <article>
    <PageHero
      compact
      breadcrumb={{ label: 'All resources', href: href('/resources') }}
      label="Guide for clinic owners"
      title={resource.data.title}
      lede={resource.data.description}
    >
      <p class="mt-7 font-mono text-[11px] uppercase tracking-[0.1em] text-panel-text-faint">
        {dateFmt.format(resource.data.publishDate)} · {resource.data.minutesRead} min read · CareInflow
      </p>
    </PageHero>

    {/* These are the longest reads on the site and they used to be one
        unbroken white field from the hero to the footer. Setting the prose on
        a sheet over a tinted band gives the page edges and depth without
        touching the measure, which is what actually makes long copy readable.
        The topic accent runs along the top of the sheet. */}
    <div class="band-mist">
      <div class="section shell">
        <div class="mx-auto max-w-[820px] overflow-hidden rounded-3xl border border-line bg-surface">
          <span
            class:list={['accent-bar block h-1.5 w-full', topicAccent(resource.data.topic).bar]}
            aria-hidden="true"></span>
          <div class="prose-ci px-6 py-10 sm:px-12 sm:py-14">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </article>

  <CtaStrip text="Want this applied to your practice? The free review shows exactly where you stand." />

  <CtaPanel nextStep={{ label: 'See what we do', href: '/services' }} />
</BaseLayout>
