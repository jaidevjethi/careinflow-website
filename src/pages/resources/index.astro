---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import { topicAccent } from '@/lib/accents';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  itemListSchema,
} from '@/lib/schema';

const title = 'Resources for clinic owners | CareInflow';
const description =
  'Plain-language guides: how patients choose clinics online, Google Business Profile, local SEO in North Gujarat, and website speed.';

const resources = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);

const topicLabels: Record<string, string> = {
  patients: 'Patient behaviour',
  'google-business-profile': 'Google Business Profile',
  websites: 'Websites',
  'local-seo': 'Local SEO',
  performance: 'Performance',
};

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/resources', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
  ]),
  itemListSchema({
    path: '/resources',
    name: 'Guides for clinic owners',
    items: resources.map((r) => ({ name: r.data.title, path: `/resources/${r.id}` })),
  }),
);

const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout {title} {description} path="/resources" {schema}>
  <PageHero
    label="Resources"
    title="What we know, written down for clinic owners."
    lede="No gated PDFs, no email capture — just plain-language guides to how patients find and judge a practice online. Read them, apply them yourself, or ask us to. All three are fine outcomes."
    stats={[
      { value: String(resources.length), caption: 'guides, free to read' },
      { value: '0', caption: 'gated downloads' },
      { value: '0', caption: 'email capture forms' },
    ]}
  />

  <section class="border-t border-hairline bg-surface" aria-label="Articles">
    <div class="section shell grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {resources.map((r) => (
        <a
          href={href(`/resources/${r.id}`)}
          class="card-hover flex flex-col overflow-hidden rounded-3xl border border-line bg-canvas hover:no-underline"
        >
          <span class:list={['accent-bar block h-1.5 w-full', topicAccent(r.data.topic).bar]} aria-hidden="true"></span>
          <div class="flex flex-1 flex-col p-7">
          <p class="mb-4 flex items-center gap-2">
            <span class:list={['chip', topicAccent(r.data.topic).chip]}>{topicLabels[r.data.topic]}</span>
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{r.data.minutesRead} min</span>
          </p>
          <h2 class="text-[20px] font-extrabold leading-[1.2] tracking-[-0.025em] text-ink">{r.data.title}</h2>
          <p class="mt-3 text-[14px] leading-[1.6] text-body">{r.data.description}</p>
          <p class="mt-auto pt-5 font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
            {dateFmt.format(r.data.publishDate)}
          </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaPanel />
</BaseLayout>
