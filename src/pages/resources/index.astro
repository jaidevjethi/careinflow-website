---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const title = 'Resources — how patients find and judge clinics online | CareInflow';
const description =
  'Plain-language guides for clinic owners: how patients choose clinics online, Google Business Profile, local SEO in North Gujarat, website speed, and what a clinic website actually needs.';

const resources = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);

const topicLabels: Record<string, string> = {
  patients: 'Patient behaviour',
  'google-business-profile': 'Google Business Profile',
  websites: 'Websites',
  'local-seo': 'Local SEO',
  performance: 'Performance',
};

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/resources', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
  ]),
);

const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout {title} {description} path="/resources" {schema}>
  <section class="mx-auto max-w-[1440px] px-5 pb-14 pt-14 sm:px-10 sm:pt-20 xl:px-20">
    <div class="tick-rule mb-3.5" aria-hidden="true"></div>
    <p class="label-mono mb-5 text-surgical">Resources — teach first</p>
    <h1 class="max-w-[820px] text-[clamp(34px,5vw,62px)] font-extrabold leading-[1.04] tracking-[-0.045em] text-ink">
      What we know, written down for clinic owners.
    </h1>
    <p class="mt-6 max-w-[680px] text-lg leading-[1.62] text-body">
      No gated PDFs, no email capture — just plain-language guides to how
      patients find and judge a practice online. Read them, apply them
      yourself, or ask us to. All three are fine outcomes.
    </p>
  </section>

  <section class="border-t border-hairline bg-surface" aria-label="Articles">
    <div class="mx-auto grid max-w-[1440px] gap-5 px-5 py-16 sm:grid-cols-2 sm:px-10 sm:py-20 xl:grid-cols-3 xl:px-20">
      {resources.map((r) => (
        <a
          href={href(`/resources/${r.id}`)}
          class="card-hover flex flex-col rounded-3xl border border-line bg-canvas p-7 hover:no-underline"
        >
          <p class="mb-4 flex items-center gap-2">
            <span class="chip border border-line bg-surface text-body-deep">{topicLabels[r.data.topic]}</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-faint">{r.data.minutesRead} min</span>
          </p>
          <h2 class="text-[21px] font-extrabold leading-[1.2] tracking-[-0.025em] text-ink">{r.data.title}</h2>
          <p class="mt-3 text-[14.5px] leading-[1.6] text-body">{r.data.description}</p>
          <p class="mt-auto pt-5 font-mono text-[10px] uppercase tracking-[0.08em] text-faint">
            {dateFmt.format(r.data.publishDate)}
          </p>
        </a>
      ))}
    </div>
  </section>

  <CtaPanel />
</BaseLayout>
