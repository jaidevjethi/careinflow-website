---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import CtaStrip from '@/components/CtaStrip.astro';
import type { PrefillKey } from '@/config/site';
import { rupees, unitLabel } from '@/config/pricing';
import { SERVICE_PRICES, resolvePrices } from '@/lib/prices';
import { resolveFaqs } from '@/lib/faqs';
import ServiceDiagram from '@/components/diagrams/ServiceDiagram.astro';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
  faqSchema,
} from '@/lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const related = allServices.filter((s) => service.data.related.includes(s.id));

/**
 * Reel editing sits under healthcare content. It keeps a page of its own,
 * because "reel editing for doctors" is a different search from "social media
 * for doctors", but its breadcrumb runs through its parent so the site still
 * reads as five services with one way into the first.
 */
const parent = service.data.parent
  ? allServices.find((s) => s.id === service.data.parent)
  : undefined;

const path = `/services/${service.id}`;
const title = `${service.data.seoTitle ?? service.data.title} | CareInflow`;
/** Tokens resolved, so a description can quote a price without carrying one. */
const description = resolvePrices(service.data.description);

const prefillByService: Record<string, PrefillKey> = {
  'healthcare-websites': 'website',
  'local-seo': 'seo',
  'google-business-profile': 'gbp',
  'website-care': 'care',
  'social-media': 'content',
  'reel-editing': 'reel',
};
const prefill = prefillByService[service.id] ?? 'default';

/**
 * The two content pages close on the sample-video offer rather than the free
 * written review. A doctor who arrived to have a reel edited does not want a
 * five-page audit of their website; they want to know what their video would
 * become and what it costs. Every other service keeps the review.
 */
const isContent = service.id === 'social-media' || service.data.parent === 'social-media';

/** Resolved from `pricing.ts` via the frontmatter key — never from the MDX. */
const pricing = service.data.pricing;
const price = pricing?.ref ? SERVICE_PRICES[pricing.ref] : undefined;
const priceNote = pricing ? resolvePrices(pricing.note) : undefined;
const faqs = resolveFaqs(service.data.faqs);

const nextStep = isContent
  ? service.id === 'reel-editing'
    ? { label: 'See the monthly content packages', href: '/pricing#content' }
    : { label: 'See what one reel includes', href: '/services/reel-editing' }
  : { label: 'See the portfolio first', href: '/work' };

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path, title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    ...(parent ? [{ name: parent.data.navLabel, path: `/services/${parent.id}` }] : []),
    { name: service.data.navLabel, path },
  ]),
  serviceSchema({
    id: service.id,
    name: service.data.navLabel,
    description,
    path,
    ...(price ? { offer: price } : {}),
  }),
  faqSchema(faqs),
);
---

<BaseLayout {title} {description} {path} {schema} {prefill} offer={isContent ? 'content' : 'review'}>
  <article>
    <PageHero
      breadcrumb={parent
        ? { label: parent.data.navLabel, href: href(`/services/${parent.id}`) }
        : { label: 'All services', href: href('/services') }}
      label={service.data.navLabel}
      title={service.data.title}
      lede={service.data.summary}
    >
      <IllustrationPanel
        slot="aside"
        src={service.data.illustration}
        alt={service.data.illustrationAlt}
        eager
        maxWidth={400}
      />
    </PageHero>

    <!-- BODY + DELIVERABLES -->
    <div class="band-mist">
      <div class="section shell grid items-start gap-14 lg:grid-cols-[1fr_400px] lg:gap-20">
        <div>
          <div class="prose-ci">
            <Content />
          </div>
          <ServiceDiagram slug={service.id} class="reveal mt-12" />
        </div>

        <aside class="top-24 rounded-3xl border border-line bg-canvas p-7 lg:sticky">
          <h2 class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What you receive</h2>
          <dl>
            {service.data.deliverables.map((d, j) => (
              <div
                class:list={[
                  'flex items-baseline justify-between gap-6 py-2.5 text-[15px]',
                  j < service.data.deliverables.length - 1 && 'border-b border-hairline',
                ]}
              >
                <dt class="text-muted">{d.item}</dt>
                <dd class="whitespace-nowrap font-semibold text-pass">{d.status}</dd>
              </div>
            ))}
          </dl>
          {price && (
            <div class="mt-6 border-t border-line pt-5">
              <p class="label-mono mb-3 text-faint" style="letter-spacing:0.12em">Starts at</p>
              <p class="flex items-baseline gap-2">
                <span class="text-[32px] font-extrabold leading-none tracking-[-0.045em] text-ink">
                  {rupees(price.from)}
                </span>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                  {unitLabel(price.unit)}
                </span>
              </p>
              <p class="mt-3 text-[14px] leading-[1.6] text-muted">{priceNote}</p>
              <a href={href(isContent ? '/pricing#content' : '/pricing')} class="prose-link mt-3 inline-block text-[15px]">
                See the full price list →
              </a>
            </div>
          )}
          {pricing?.custom && (
            <div class="mt-6 border-t border-line pt-5">
              <p class="label-mono mb-3 text-faint" style="letter-spacing:0.12em">Priced to your site</p>
              <p class="text-[22px] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
                A custom monthly plan
              </p>
              <p class="mt-3 text-[14px] leading-[1.6] text-muted">{priceNote}</p>
              <a href={href('/pricing#monthly')} class="prose-link mt-3 inline-block text-[15px]">
                See both monthly plans →
              </a>
            </div>
          )}
          <p class="mt-5 border-t border-line pt-4 text-[14px] leading-[1.6] text-muted">
            {isContent ? (
              <>
                Send one sample video and we confirm what it involves and what it
                costs before we start.
              </>
            ) : (
              <>
                Your exact figure is fixed in writing after the
                <a href={href('/contact')} class="prose-link">free review</a>.
              </>
            )}
          </p>
        </aside>
      </div>
    </div>

    {related.length > 0 && (
      <section class="section shell" aria-label="Related services">
        <h2 class="label-mono mb-6 text-faint">Works best with</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:max-w-[880px]">
          {related.map((r) => (
            <a href={href(`/services/${r.id}`)} class="card-hover block rounded-2xl border border-line bg-surface p-6.5 hover:no-underline">
              <h3 class="text-lg font-bold tracking-[-0.02em] text-ink">{r.data.navLabel}</h3>
              <p class="mt-2 text-[15px] leading-[1.55] text-muted">{r.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  {isContent ? (
    <CtaStrip
      text="Have a video already recorded? Send the topic and one clip, and we will tell you what the reel would involve."
      href="/contact#content"
      linkText="Send one sample video"
    />
  ) : (
    <CtaStrip />
  )}

  <FaqSection
    {faqs}
    label="Questions"
    title="Asked about this service"
  />

  <CtaPanel {prefill} offer={isContent ? 'content' : 'review'} {nextStep} />
</BaseLayout>
