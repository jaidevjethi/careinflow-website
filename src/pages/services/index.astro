---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import { serviceAccent } from '@/lib/accents';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import { BUILDS, ONE_TIME_ITEMS, PLANS, STANDALONE_MONTHLY, rupees } from '@/config/pricing';
import { SERVICE_PRICES } from '@/lib/prices';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
} from '@/lib/schema';

const title = 'Services for clinics — websites, local SEO, Google | CareInflow';
const description =
  'Healthcare website design, local SEO, Google Business Profile management, ongoing care and social media content — for clinics across North Gujarat.';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/services', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]),
  ...services.map((s) =>
    serviceSchema({
      id: s.id,
      name: s.data.navLabel,
      description: s.data.description,
      path: `/services/${s.id}`,
      ...(s.data.pricing ? { offer: SERVICE_PRICES[s.data.pricing.ref] } : {}),
    }),
  ),
);

const targets = [
  { value: '<1.2s', caption: 'load reference, measured on 4G' },
  { value: '95+', caption: 'Lighthouse score' },
  { value: 'AA', caption: 'accessibility on every build' },
  { value: 'Valid', caption: 'schema on every page' },
];

const glossary = [
  {
    term: 'Google Business Profile (GBP)',
    def: "The free Google listing with your map pin, rating, photos and hours — for most clinics, the first thing a patient sees.",
  },
  {
    term: 'NAP',
    def: 'Name, Address, Phone. Search engines cross-check these everywhere you appear; mismatches quietly cost local visibility.',
  },
  {
    term: 'Core Web Vitals',
    def: "Google's measurements of how fast a page loads, how quickly it responds to taps, and whether it jumps while loading.",
  },
  {
    term: 'Schema markup',
    def: 'Machine-readable labels on your pages that tell search engines and AI assistants exactly what your practice is and offers.',
  },
  {
    term: 'AEO (AI answer readiness)',
    def: 'Publishing your practice facts so AI assistants can quote you when patients ask them for clinic recommendations.',
  },
];

const maintenance = [
  { cadence: 'Weekly', items: 'Uptime and performance monitoring · review activity checked' },
  { cadence: 'Monthly', items: 'Security updates · backups · content edits · profile photos and hours refreshed' },
  { cadence: 'Quarterly', items: 'Speed re-measured against reference · written review: what patients did, what to do next' },
];

const engagements = [
  {
    name: 'Start with the website',
    price: `From ${rupees(BUILDS[0]!.from)}, one-time`,
    scope: 'A complete practice website with a page per treatment, WhatsApp enquiry flow, and launch measurement.',
    excludes: 'Excludes: ongoing GBP management and content beyond the agreed page list.',
    suits: 'Suits practices whose listing is healthy but whose site is old, slow or generic.',
  },
  {
    name: 'Start with Google',
    price: `${rupees(ONE_TIME_ITEMS[0]!.price)} once, or ${rupees(STANDALONE_MONTHLY.gbp)} a month`,
    scope: 'Google Business Profile rebuilt and maintained, citations corrected, review flow set up.',
    excludes: 'Excludes: website changes — though the audit will say honestly if your site is the real problem.',
    suits: 'Suits practices with a decent website that patients simply cannot find.',
  },
  {
    name: 'The full system',
    price: `From ${rupees(BUILDS[1]!.from)}, then ${rupees(PLANS[2]!.monthly)} a month`,
    scope: 'Website, Google Business Profile, local SEO groundwork and AI answer readiness, built as one system, then maintained.',
    excludes: 'Excludes: nothing that affects how a patient finds and judges you online.',
    suits: 'Suits practices that want the whole first impression handled by one accountable team.',
  },
];
---

<BaseLayout {title} {description} path="/services" {schema}>
  <PageHero
    label="What we do"
    title="Four core services, plus the support work around them."
    lede="We do a small number of things for healthcare practices and hold them to measurable standards. If a service is not on this page, we do not sell it — and we will say so."
    stats={targets}
  />

  <!-- SERVICE DETAILS — alternating rows -->
  <section class="border-t border-hairline bg-surface" aria-label="The four core services">
    <div class="section shell flex flex-col gap-20">
      {services.map((service, i) => (
        <article class="grid items-start gap-10 lg:grid-cols-2 lg:gap-20">
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <p class="mb-4 flex flex-wrap items-center gap-2.5">
              <span class:list={['chip', serviceAccent(service.id).chip]}>{service.data.code}</span>
              {service.data.order > 4 && (
                <span class="chip bg-hairline-soft text-muted">Support service</span>
              )}
            </p>
            <h2 class="text-[clamp(26px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink">
              {service.data.title}
            </h2>
            <p class="mt-4 max-w-[520px] text-[17px] leading-[1.65] text-body">{service.data.description}</p>
            <a href={href(`/services/${service.id}`)} class="prose-link mt-5 inline-block text-base">
              Read about {service.data.navLabel.toLowerCase()} →
            </a>

            {service.data.pricing && (
              <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-[26px] font-extrabold leading-none tracking-[-0.04em] text-ink">
                  From {rupees(SERVICE_PRICES[service.data.pricing.ref].from)}
                </span>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                  {SERVICE_PRICES[service.data.pricing.ref].unit === 'month' ? 'a month' : 'one-time'}
                </span>
              </p>
            )}

            <div class="card-hover mt-8 rounded-3xl border border-line bg-canvas p-7">
              <p class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What you receive</p>
              <dl>
                {service.data.deliverables.map((d, j) => (
                  <div
                    class:list={[
                      'flex items-baseline justify-between gap-6 py-2.5 text-[14px]',
                      j < service.data.deliverables.length - 1 && 'border-b border-hairline',
                    ]}
                  >
                    <dt class="text-muted">{d.item}</dt>
                    <dd class="whitespace-nowrap font-semibold text-pass">{d.status}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <div class:list={['lg:sticky lg:top-24', i % 2 === 1 && 'lg:order-1']}>
            <IllustrationPanel
              src={service.data.illustration}
              alt={service.data.illustrationAlt}
              maxWidth={620}
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ENGAGEMENTS — the page's one dark panel -->
  <section class="section shell" aria-labelledby="engagements-title">
    <div class="panel-depth rounded-[28px] p-8 sm:p-12 lg:p-16">
      <SectionHead
        id="engagements-title"
        dark
        label="Where to start"
        title="Most clinics need three of our nine services to begin. These are the usual starting points."
        lede="Every engagement is a fixed price agreed in writing after the free review — no hourly billing, no surprise invoices. Exclusions are stated with the same weight as inclusions."
      />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {engagements.map((e) => (
          <article class="rounded-[20px] border border-panel-line bg-panel-card p-7">
            <h3 class="text-xl font-bold tracking-[-0.02em] text-surface">{e.name}</h3>
            <p class="mt-2.5 font-mono text-[12px] uppercase leading-[1.5] tracking-[0.06em] text-panel-accent">
              {e.price}
            </p>
            <p class="mt-3 text-[14.5px] leading-[1.6] text-panel-text">{e.scope}</p>
            <p class="mt-3 text-[13.5px] leading-[1.6] text-panel-text-faint">{e.excludes}</p>
            <p class="mt-4 border-t border-panel-divider pt-4 text-[13.5px] leading-[1.6] text-panel-text-dim">{e.suits}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text-faint">
        Published starting prices · fixed in writing after the review · see the full <a href={href('/pricing')} class="link-accent">price list</a>
      </p>
    </div>
  </section>

  <!-- AFTER LAUNCH -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="after-launch-title">
    <div class="section shell">
      <SectionHead
        id="after-launch-title"
        label="After launch"
        title="The objection no one answers: what happens after launch. Here is our answer, as a table."
      />
      <div class="mt-10 max-w-[880px] overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Maintenance schedule by cadence</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="label-mono py-3 pr-6 text-faint">Cadence</th>
              <th scope="col" class="label-mono py-3 text-faint">What happens</th>
            </tr>
          </thead>
          <tbody>
            {maintenance.map((row) => (
              <tr class="border-b border-hairline align-top">
                <th scope="row" class="whitespace-nowrap py-4 pr-6 font-mono text-[12px] uppercase tracking-[0.08em] text-surgical">
                  {row.cadence}
                </th>
                <td class="py-4 text-[15.5px] leading-[1.6] text-body">{row.items}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 max-w-[680px] text-[15.5px] leading-[1.65] text-muted">
        The full schedule, ownership terms and month-to-month structure are on
        the <a href={href('/services/website-care')} class="prose-link">ongoing website care</a> page.
      </p>
    </div>
  </section>

  <!-- PLAIN WORDS -->
  <section class="section shell" aria-labelledby="glossary-title">
    <SectionHead
      id="glossary-title"
      label="Jargon, translated"
      title="Five terms you will hear from any agency, in one honest line each."
    />
    <dl class="mt-10 grid max-w-[880px] gap-3.5">
      {glossary.map((g) => (
        <div class="rounded-2xl border border-line bg-surface px-6 py-5">
          <dt class="text-[16px] font-bold tracking-[-0.01em] text-ink">{g.term}</dt>
          <dd class="mt-1.5 text-[15px] leading-[1.6] text-body">{g.def}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- COMPLEMENTARY -->
  <section class="border-t border-hairline bg-surface" aria-labelledby="complementary-title">
    <div class="section shell">
      <h2 id="complementary-title" class="text-xl font-bold tracking-[-0.02em] text-ink">
        Support services, when they help
      </h2>
      <p class="mt-3 max-w-[680px] text-[15.5px] leading-[1.65] text-body">
        Alongside the core four we offer
        <a href={href('/services/social-media')} class="prose-link">social media content for clinics</a>,
        plus basic branding assets, content uploads and digital consultation.
        These support the main work rather than replacing it, and we will not
        sell them to a practice that does not need them.
      </p>
    </div>
  </section>

  <CtaPanel nextStep={{ label: 'See the work first', href: '/work' }} />
</BaseLayout>
