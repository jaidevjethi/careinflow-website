---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import ServiceVisual from '@/components/visuals/ServiceVisual.astro';
import deviceSuite from '@/assets/mockups/services-device-suite.webp';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import FaqSection from '@/components/FaqSection.astro';
import { getFaqsFor } from '@/lib/faqs';
import { href } from '@/lib/url';
import { BUILDS, GOOGLE_CARE, PLANS, rupees, type PriceUnit } from '@/config/pricing';
import { PRICE_TOKENS, SERVICE_PRICES, resolvePrices } from '@/lib/prices';
import {
  graph,
  faqSchema,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
} from '@/lib/schema';

const title = 'Clinic Websites, Content, Google & Local SEO | CareInflow';
const description =
  'Healthcare websites, healthcare content, Google Business Profile, local SEO and ongoing care, from a studio in Mehsana that works only with clinics.';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

/**
 * Five services. Reel editing has a page of its own but sits under healthcare
 * content, so it appears inside that row as the single-piece way in rather
 * than as a sixth row of its own.
 */
const topLevel = services.filter((s) => !s.data.parent);
const childrenOf = (id: string) => services.filter((s) => s.data.parent === id);

/*
 * The service count in the hero stat comes from the collection. It was
 * hand-written as "Nine" — the homepage's count of capability cards — above
 * five priced services, on a page whose own H1 then said four. Three numbers
 * on one screen, two of them wrong for the thing a reader was looking at.
 */

const faqs = await getFaqsFor('services');

/** The price as a row reads it: "From ₹5,499 a month", "From ₹699 each". */
const unitWords = (unit: PriceUnit) =>
  ({ month: 'a month', piece: 'each', page: 'a page', once: 'one-time', project: 'one-time' })[unit];

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/services', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]),
  // Every service with a page, the reel included: its price is shown in the
  // content row, so its Service node describes something on this page.
  ...services.map((s) =>
    serviceSchema({
      id: s.id,
      name: s.data.navLabel,
      description: resolvePrices(s.data.description),
      path: `/services/${s.id}`,
      ...(s.data.pricing?.ref ? { offer: SERVICE_PRICES[s.data.pricing.ref] } : {}),
    }),
  ),
  faqSchema(faqs),
);

/**
 * What the buyer gets, not what the build scores. A Lighthouse number and a
 * schema validity flag belong in the work, and in the written review; they
 * are not four things a doctor can weigh in the first ten seconds of a page.
 *
 * The second stat used to say three services is "what most clinics start
 * with" — a claim about other practices with nothing behind it. What is true,
 * and more useful, is that any one of the five is a place to start.
 */
const targets = [
  { value: String(topLevel.length), caption: 'services, each priced on this page' },
  { value: 'One', caption: 'is enough to start with' },
  { value: 'Fixed', caption: 'price, agreed before we start' },
  { value: 'Free', caption: 'written review before you pay' },
];

const glossary = [
  {
    term: 'Google Business Profile (GBP)',
    def: 'The free Google listing carrying your map pin, rating, photos and hours. For most clinics it is the first thing a patient ever sees.',
  },
  {
    term: 'NAP',
    def: 'Name, Address, Phone. Search engines cross-check these everywhere you appear; mismatches quietly cost local visibility.',
  },
  {
    term: 'Core Web Vitals',
    def: "Google's measurements of how fast a page loads, how quickly it responds to taps, and whether it jumps while loading.",
  },
  {
    term: 'Schema markup',
    def: 'Machine-readable labels on your pages that tell a search engine exactly what your practice is, where it is, and what it treats.',
  },
  {
    term: 'AEO (AI answer readiness)',
    def: 'Google now writes a summary above the search results for many treatment questions, built from pages it can quote. This is publishing your practice facts in a form it can use.',
  },
];

/**
 * After launch, as the two plans rather than a cadence. The table used to
 * promise weekly uptime monitoring and a quarterly written review; neither is
 * in either plan, so the rows now come from pricing.ts and say exactly what
 * each plan covers.
 */
const afterLaunch = PLANS.map((p) => ({
  name: p.name,
  price: p.monthly ? `${rupees(p.monthly)} a month` : 'Priced to your site',
  items: p.includes.join(' · '),
  link: p.custom ? '/services/website-care' : '/services/local-seo',
}));

const engagements = [
  {
    name: 'Start with content',
    price: `${rupees(PRICE_TOKENS.reel)} a reel, or from ${rupees(PRICE_TOKENS.contentStarter)} a month`,
    scope: 'Send the videos you record and get back publish-ready reels, posts and carousels: one reel at a time, or a monthly package.',
    excludes: 'Excludes filming, posting, ads and replying to messages.',
    suits: 'Suits a doctor who already explains things well on camera and wants it to reach patients.',
  },
  {
    name: 'Start with the website',
    price: `${rupees(BUILDS[0]!.from)}, one-time`,
    scope: 'A Foundation Website up to five pages, with the local-search foundation under it and your Google listing set up and audited.',
    excludes: 'Excludes monthly management of the listing, and a page for every treatment.',
    suits: 'Suits a doctor or small clinic that needs a professional starting website.',
  },
  {
    name: 'Website and Google together',
    price: `${rupees(BUILDS[1]!.from)}, one-time`,
    scope: 'A Practice Website up to ten pages with a page per treatment, plus your Google Business Profile rebuilt, aligned to the site and handed over working. Ninety days of support.',
    excludes: 'Excludes ongoing management after the 90 days, Gujarati, and more than one location.',
    suits: 'Suits the practice that wants a website and wants patients to find it. It is the one we recommend for most practices.',
  },
  {
    name: 'Then keep it working',
    price: `${rupees(GOOGLE_CARE.monthly)} a month`,
    scope: 'Local SEO & Google Care: the listing maintained, every review answered, local search watched, one new treatment page a month, and a written report.',
    excludes: 'Excludes any promise about rankings, Maps position, enquiries or patients. What it promises is the work, every month.',
    suits: 'Suits any practice that wants the work to continue after launch. Month to month, no lock-in.',
  },
];
---

<BaseLayout {title} {description} path="/services" {schema}>
  <PageHero
    label="What we do"
    title="Five services, for healthcare practices only."
    lede="Websites, healthcare content, your Google listing, local search and the care after launch. The specialisation is the client, not the medium: doctors and clinics, and nobody else. If a service is not on this page we do not sell it, and we will say so rather than take the work."
    stats={targets}
  >
    {/* 340 rather than the 400 the other heroes use: this is the one portrait
        aside on the site, and at 400 it stands 500px tall and pushes the hero
        past the 72%-of-viewport rule on a laptop. */}
    <IllustrationPanel
      slot="aside"
      src={deviceSuite}
      alt="A laptop, tablet and phone side by side, each showing part of the same clinic's setup: an appointments dashboard, a Google Business Profile, and the practice website."
      eager
      maxWidth={340}
      class="mx-auto"
    />
  </PageHero>

  <!-- SERVICE DETAILS : alternating rows -->
  <section class="border-t border-hairline bg-surface" aria-label="What we do for clinics">
    <div class="section shell flex flex-col gap-20">
      {topLevel.map((service, i) => {
        const pricing = service.data.pricing;
        const price = pricing?.ref ? SERVICE_PRICES[pricing.ref] : undefined;
        return (
          <article class="grid items-start gap-10 lg:grid-cols-2 lg:gap-20">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <h2 class="text-[clamp(26px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink">
                {service.data.title}
              </h2>
              <p class="mt-4 max-w-[520px] text-[17px] leading-[1.65] text-body">
                {resolvePrices(service.data.description)}
              </p>
              <a href={href(`/services/${service.id}`)} class="prose-link mt-5 inline-block text-base">
                Read about {service.data.navLabel.toLowerCase()} →
              </a>

              {price && (
                <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-[24px] font-extrabold leading-none tracking-[-0.04em] text-ink">
                    From {rupees(price.from)}
                  </span>
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                    {unitWords(price.unit)}
                  </span>
                </p>
              )}
              {pricing?.custom && (
                <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-[24px] font-extrabold leading-none tracking-[-0.04em] text-ink">
                    Custom monthly plan
                  </span>
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                    priced to your site
                  </span>
                </p>
              )}
              {childrenOf(service.id).map((child) => {
                const childPrice = child.data.pricing?.ref ? SERVICE_PRICES[child.data.pricing.ref] : undefined;
                return (
                  <p class="mt-3 text-[16px] leading-[1.55] text-body">
                    Or one at a time:{' '}
                    <a href={href(`/services/${child.id}`)} class="prose-link">
                      {child.data.navLabel.toLowerCase()}
                      {childPrice && `, ${rupees(childPrice.from)} ${unitWords(childPrice.unit)}`} →
                    </a>
                  </p>
                );
              })}

              <div class="card-hover mt-8 rounded-3xl border border-line bg-canvas p-7">
                <p class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What you receive</p>
                <dl>
                  {service.data.deliverables.map((d, j) => (
                    <div
                      class:list={[
                        'flex items-baseline justify-between gap-6 py-2.5 text-[15px]',
                        j < service.data.deliverables.length - 1 && 'border-b border-hairline',
                      ]}
                    >
                      <dt class="text-muted">{d.item}</dt>
                      <dd class="whitespace-nowrap font-semibold text-pass">{d.status}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>

            {/* The same picture the homepage card and the service's own hero
                use, from one map, so a service is drawn one way everywhere. */}
            <div class:list={['lg:sticky lg:top-24', i % 2 === 1 && 'lg:order-1']}>
              <ServiceVisual slug={service.id} class="mx-auto max-w-[580px]" />
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- ENGAGEMENTS : the page's one dark panel -->
  <section class="section shell" aria-labelledby="engagements-title">
    <div class="panel-depth panel-box">
      <SectionHead
        id="engagements-title"
        dark
        label="Where to start"
        title="Where can a practice start?"
        lede="Anywhere. Content is the quickest way in, a website is the larger project, and the Google work is what keeps going after launch. Every job has one fixed price, agreed in writing, and what it does not cover is written as plainly as what it does."
      />
      {/* Four into two columns, from sm up. Three columns stranded the fourth
          card alone on a row once content became a place to start. */}
      <div class="reveal-group mt-12 grid gap-5 sm:grid-cols-2">
        {engagements.map((e) => (
          <article class="rounded-3xl border border-panel-line bg-panel-card p-6 sm:p-7">
            <h3 class="text-xl font-bold tracking-[-0.02em] text-surface">{e.name}</h3>
            <p class="mt-2.5 font-mono text-[12px] uppercase leading-[1.5] tracking-[0.06em] text-panel-accent">
              {e.price}
            </p>
            <p class="mt-3 text-[15px] leading-[1.6] text-panel-text">{e.scope}</p>
            <p class="mt-3 text-[14px] leading-[1.6] text-panel-text-faint">{e.excludes}</p>
            <p class="mt-4 border-t border-panel-divider pt-4 text-[14px] leading-[1.6] text-panel-text-dim">{e.suits}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text-faint">
        Published starting prices · fixed in writing before we start · see the full <a href={href('/pricing')} class="link-accent">price list</a>
      </p>
    </div>
  </section>

  <!-- AFTER LAUNCH -->
  <section class="band-powder" aria-labelledby="after-launch-title">
    <div class="section shell">
      <SectionHead
        id="after-launch-title"
        label="After launch"
        title="The objection no one answers: what happens after launch. Here is our answer, as a table."
      />
      <div class="mt-10 max-w-[880px] overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">The two monthly plans after launch, and what each covers</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="label-mono py-3 pr-6 text-faint">Plan</th>
              <th scope="col" class="label-mono py-3 text-faint">What it covers</th>
            </tr>
          </thead>
          <tbody>
            {afterLaunch.map((row) => (
              <tr class="border-b border-hairline align-top">
                <th scope="row" class="py-4 pr-6 text-left align-top">
                  <a href={href(row.link)} class="prose-link block text-[16px]">{row.name}</a>
                  <span class="mt-1 block whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.08em] text-surgical">
                    {row.price}
                  </span>
                </th>
                <td class="py-4 text-[16px] leading-[1.6] text-body">{row.items}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 max-w-[680px] text-[16px] leading-[1.65] text-muted">
        Both run month to month, with no lock-in, and the website and every
        account stay in your name whatever you decide. A practice on Local SEO
        & Google Care does not usually need Website Care as well: website
        updates are already part of it.
      </p>
    </div>
  </section>

  <!-- PLAIN WORDS -->
  <section class="section shell" aria-labelledby="glossary-title">
    <SectionHead
      id="glossary-title"
      label="Jargon, translated"
      title="Five terms you will hear from any agency, in one honest line each."
    />
    <dl class="reveal-group mt-10 grid max-w-[880px] gap-3.5">
      {glossary.map((g) => (
        <div class="rounded-2xl border border-line bg-surface px-6 py-5">
          <dt class="text-[16px] font-bold tracking-[-0.01em] text-ink">{g.term}</dt>
          <dd class="mt-1.5 text-[16px] leading-[1.6] text-body">{g.def}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/*
    "Support services, when they help" stood here: social media as an extra,
    plus branding assets, content uploads and digital consultation. Healthcare
    content is now one of the five services above rather than a support act,
    and the other three were never things a practice could buy from a page, so
    the section went with the positioning it described.
  */}

  <FaqSection
    {faqs}
    label="Questions"
    title="What practices ask before choosing"
  />

  <CtaPanel nextStep={{ label: 'See the portfolio first', href: '/work' }} />
</BaseLayout>
