---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import IllustrationPanel from '@/components/IllustrationPanel.astro';
import deviceSuite from '@/assets/mockups/services-device-suite.webp';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import { BUILDS, PLANS, rupees } from '@/config/pricing';
import { SERVICE_PRICES } from '@/lib/prices';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
} from '@/lib/schema';

const title = "Gujarat's best clinic websites & local SEO | CareInflow";
const description =
  "Healthcare website design, local SEO, Google Business Profile management and ongoing care, from Gujarat's healthcare-only web studio. Clinics only.";

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

/*
 * The service count in the hero stat comes from the collection. It was
 * hand-written as "Nine" — the homepage's count of capability cards — above
 * five priced services, on a page whose own H1 then said four. Three numbers
 * on one screen, two of them wrong for the thing a reader was looking at.
 */

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/services', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]),
  ...services.map((s) =>
    serviceSchema({
      id: s.id,
      name: s.data.navLabel,
      description: s.data.description,
      path: `/services/${s.id}`,
      ...(s.data.pricing ? { offer: SERVICE_PRICES[s.data.pricing.ref] } : {}),
    }),
  ),
);

/**
 * What the buyer gets, not what the build scores. A Lighthouse number and a
 * schema validity flag belong in the work, and in the written review; they
 * are not four things a doctor can weigh in the first ten seconds of a page.
 */
const targets = [
  { value: String(services.length), caption: 'services, each priced on this page' },
  { value: 'Three', caption: 'is what most clinics start with' },
  { value: 'Fixed', caption: 'price, agreed before we start' },
  { value: 'Free', caption: 'written review before you pay' },
];

const glossary = [
  {
    term: 'Google Business Profile (GBP)',
    def: 'The free Google listing carrying your map pin, rating, photos and hours. For most clinics it is the first thing a patient ever sees.',
  },
  {
    term: 'NAP',
    def: 'Name, Address, Phone. Search engines cross-check these everywhere you appear; mismatches quietly cost local visibility.',
  },
  {
    term: 'Core Web Vitals',
    def: "Google's measurements of how fast a page loads, how quickly it responds to taps, and whether it jumps while loading.",
  },
  {
    term: 'Schema markup',
    def: 'Machine-readable labels on your pages that tell a search engine exactly what your practice is, where it is, and what it treats.',
  },
  {
    term: 'AEO (AI answer readiness)',
    def: 'Google now writes a summary above the search results for many treatment questions, built from pages it can quote. This is publishing your practice facts in a form it can use.',
  },
];

const maintenance = [
  { cadence: 'Weekly', items: 'Uptime and performance monitoring · review activity checked' },
  { cadence: 'Monthly', items: 'Security updates · backups · content edits · profile photos and hours refreshed' },
  { cadence: 'Quarterly', items: 'Speed re-measured against reference · written review: what patients did, what to do next' },
];

const engagements = [
  {
    name: 'Start with the website',
    price: `${rupees(BUILDS[0]!.from)}, one-time`,
    scope: 'A practice website up to five pages, with the local-search foundation under it and an audit of your Google listing.',
    excludes: 'Excludes: month-to-month management of the listing, and a treatment-by-treatment content strategy.',
    suits: 'Suits a solo doctor or small practice in a straightforward local market.',
  },
  {
    name: 'Website and Google together',
    price: `${rupees(BUILDS[1]!.from)}, one-time`,
    scope: 'Up to ten pages with a page per treatment, plus your Google Business Profile rebuilt, aligned to the site and handed over working. Ninety days of support.',
    excludes: 'Excludes ongoing management after the 90 days, Gujarati, and more than one location.',
    suits: 'Suits the practice that wants a website and wants patients to find it. Most people start here.',
  },
  {
    name: 'Then keep it working',
    price: `${rupees(PLANS[0]!.monthly)} a month`,
    scope: 'The listing managed, every review answered, local search monitored, one new treatment page a month, and a written report.',
    excludes: 'Excludes any promise about rankings. What it promises is continuous improvement and maintenance.',
    suits: 'Suits any practice that wants the work to continue after launch. Month to month, no lock-in.',
  },
];
---

<BaseLayout {title} {description} path="/services" {schema}>
  <PageHero
    label="What we do"
    title="Five services, built for healthcare practices and nothing else."
    lede="Five things, done for clinics only and each held to a standard we publish. Doing one kind of work again and again is how it gets genuinely good, and it is why practices across Gujarat come to a studio this specialised. If a service is not on this page we do not sell it, and we will say so rather than take the work."
    stats={targets}
  >
    {/* 340 rather than the 400 the other heroes use: this is the one portrait
        aside on the site, and at 400 it stands 500px tall and pushes the hero
        past the 72%-of-viewport rule on a laptop. */}
    <IllustrationPanel
      slot="aside"
      src={deviceSuite}
      alt="A laptop, tablet and phone side by side, each showing part of the same clinic's setup: an appointments dashboard, a Google Business Profile, and the practice website."
      eager
      maxWidth={340}
      class="mx-auto"
    />
  </PageHero>

  <!-- SERVICE DETAILS : alternating rows -->
  <section class="border-t border-hairline bg-surface" aria-label="What we do for clinics">
    <div class="section shell flex flex-col gap-20">
      {services.map((service, i) => (
        <article class="grid items-start gap-10 lg:grid-cols-2 lg:gap-20">
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <p class="mb-4 flex flex-wrap items-center gap-2.5">
              {service.data.order > 4 && (
                <span class="chip bg-hairline-soft text-muted">Sold on its own too</span>
              )}
            </p>
            <h2 class="text-[clamp(26px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink">
              {service.data.title}
            </h2>
            <p class="mt-4 max-w-[520px] text-[17px] leading-[1.65] text-body">{service.data.description}</p>
            <a href={href(`/services/${service.id}`)} class="prose-link mt-5 inline-block text-base">
              Read about {service.data.navLabel.toLowerCase()} →
            </a>

            {service.data.pricing && (
              <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-[24px] font-extrabold leading-none tracking-[-0.04em] text-ink">
                  From {rupees(SERVICE_PRICES[service.data.pricing.ref].from)}
                </span>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                  {SERVICE_PRICES[service.data.pricing.ref].unit === 'month' ? 'a month' : 'one-time'}
                </span>
              </p>
            )}

            <div class="card-hover mt-8 rounded-3xl border border-line bg-canvas p-7">
              <p class="label-mono mb-4 text-faint" style="letter-spacing:0.12em">What you receive</p>
              <dl>
                {service.data.deliverables.map((d, j) => (
                  <div
                    class:list={[
                      'flex items-baseline justify-between gap-6 py-2.5 text-[15px]',
                      j < service.data.deliverables.length - 1 && 'border-b border-hairline',
                    ]}
                  >
                    <dt class="text-muted">{d.item}</dt>
                    <dd class="whitespace-nowrap font-semibold text-pass">{d.status}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <div class:list={['lg:sticky lg:top-24', i % 2 === 1 && 'lg:order-1']}>
            <IllustrationPanel
              src={service.data.illustration}
              alt={service.data.illustrationAlt}
              maxWidth={620}
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ENGAGEMENTS : the page's one dark panel -->
  <section class="section shell" aria-labelledby="engagements-title">
    <div class="panel-depth panel-box">
      <SectionHead
        id="engagements-title"
        dark
        label="Where to start"
        title="Where most practices actually start, and what comes after."
        lede="Each website package does more for you than the one before it. Every job is one fixed price, agreed in writing after the free review, and what it does not cover is written as plainly as what it does."
      />
      <div class="reveal-group mt-12 grid gap-5 lg:grid-cols-3">
        {engagements.map((e) => (
          <article class="rounded-3xl border border-panel-line bg-panel-card p-6 sm:p-7">
            <h3 class="text-xl font-bold tracking-[-0.02em] text-surface">{e.name}</h3>
            <p class="mt-2.5 font-mono text-[12px] uppercase leading-[1.5] tracking-[0.06em] text-panel-accent">
              {e.price}
            </p>
            <p class="mt-3 text-[15px] leading-[1.6] text-panel-text">{e.scope}</p>
            <p class="mt-3 text-[14px] leading-[1.6] text-panel-text-faint">{e.excludes}</p>
            <p class="mt-4 border-t border-panel-divider pt-4 text-[14px] leading-[1.6] text-panel-text-dim">{e.suits}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.08em] text-panel-text-faint">
        Published starting prices · fixed in writing after the review · see the full <a href={href('/pricing')} class="link-accent">price list</a>
      </p>
    </div>
  </section>

  <!-- AFTER LAUNCH -->
  <section class="band-powder" aria-labelledby="after-launch-title">
    <div class="section shell">
      <SectionHead
        id="after-launch-title"
        label="After launch"
        title="The objection no one answers: what happens after launch. Here is our answer, as a table."
      />
      <div class="mt-10 max-w-[880px] overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Maintenance schedule by cadence</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="label-mono py-3 pr-6 text-faint">Cadence</th>
              <th scope="col" class="label-mono py-3 text-faint">What happens</th>
            </tr>
          </thead>
          <tbody>
            {maintenance.map((row) => (
              <tr class="border-b border-hairline align-top">
                <th scope="row" class="whitespace-nowrap py-4 pr-6 font-mono text-[12px] uppercase tracking-[0.08em] text-surgical">
                  {row.cadence}
                </th>
                <td class="py-4 text-[16px] leading-[1.6] text-body">{row.items}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 max-w-[680px] text-[16px] leading-[1.65] text-muted">
        The full schedule, ownership terms and month-to-month structure are on
        the <a href={href('/services/website-care')} class="prose-link">ongoing website care</a> page.
      </p>
    </div>
  </section>

  <!-- PLAIN WORDS -->
  <section class="section shell" aria-labelledby="glossary-title">
    <SectionHead
      id="glossary-title"
      label="Jargon, translated"
      title="Five terms you will hear from any agency, in one honest line each."
    />
    <dl class="reveal-group mt-10 grid max-w-[880px] gap-3.5">
      {glossary.map((g) => (
        <div class="rounded-2xl border border-line bg-surface px-6 py-5">
          <dt class="text-[16px] font-bold tracking-[-0.01em] text-ink">{g.term}</dt>
          <dd class="mt-1.5 text-[16px] leading-[1.6] text-body">{g.def}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- COMPLEMENTARY -->
  <section class="band-mist" aria-labelledby="complementary-title">
    <div class="section shell">
      <h2 id="complementary-title" class="text-xl font-bold tracking-[-0.02em] text-ink">
        Support services, when they help
      </h2>
      <p class="mt-3 max-w-[680px] text-[16px] leading-[1.65] text-body">
        Alongside the core four we offer
        <a href={href('/services/social-media')} class="prose-link">social media content for clinics</a>,
        plus basic branding assets, content uploads and digital consultation.
        These support the main work rather than replacing it, and we will not
        sell them to a practice that does not need them.
      </p>
    </div>
  </section>

  <CtaPanel nextStep={{ label: 'See the work first', href: '/work' }} />
</BaseLayout>
