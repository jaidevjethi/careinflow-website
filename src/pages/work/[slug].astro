---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { getImage } from 'astro:assets';
import { CANONICAL_HOST } from '@/config/site';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  caseStudySchema,
} from '@/lib/schema';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.id },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);

const path = `/work/${cs.id}`;
const title = `${cs.data.client}, case study | CareInflow`;
const description = cs.data.description;

/**
 * The real screenshot doubles as the share card and the Article image, so a
 * case study previews as the site it is about rather than the default card.
 */
const share = await getImage({ src: cs.data.cover, width: 1200, format: 'jpg' });
const shareImage = {
  url: new URL(share.src, CANONICAL_HOST).href,
  width: Number(share.attributes.width ?? 1200),
  height: Number(share.attributes.height ?? 630),
  alt: cs.data.coverAlt,
};

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path, title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: cs.data.client, path },
  ]),
  caseStudySchema({
    path,
    title: cs.data.title,
    description,
    client: cs.data.client,
    year: cs.data.year,
    image: shareImage,
    demo: cs.data.demo,
    ...(cs.data.url ? { liveUrl: cs.data.url } : {}),
  }),
);
---

<BaseLayout
  {title}
  {description}
  {path}
  {schema}
  image={shareImage.url}
  imageAlt={cs.data.coverAlt}
>
  <article>
    <PageHero
      breadcrumb={{ label: 'All work', href: href('/work') }}
      label={`${cs.data.sector} · ${cs.data.year}`}
      title={cs.data.title}
      lede={cs.data.summary}
      stats={cs.data.highlights.slice(0, 4).map((h) => ({ value: h.value, caption: h.ref ? `${h.label}, ${h.ref}` : h.label }))}
    >
      <p class="mt-6 text-base font-semibold text-panel-text">
        {cs.data.client} · {cs.data.location}
      </p>
      {/*
        The demo says what it is before anything else on the page, and says it
        about the *content* rather than only about the client. A visitor who
        reads "sample" as "unbuilt mockup" has the wrong idea; one who reads
        the copy as our recommended medical claims has a worse one.

        Deliberately not a `.chip`. Chips are `white-space: nowrap` with
        `text-overflow: ellipsis`, which is right for a location label and
        exactly wrong here — the sentence overflowed its column and then
        truncated, so on a phone the disclaimer trailed off before reaching
        the word "invented". A note that wraps cannot lose its own ending.

        Demos only. The non-healthcare project carried a matching chip, but
        its lede already opens "Not a clinic. Included honestly…" and at this
        size the note restated that line almost verbatim, three lines below
        it. The card on /work still labels it.
      */}
      {cs.data.demo && (
        <p class="mt-5 max-w-[520px] rounded-xl border border-panel-accent/45 bg-panel-chip px-4 py-3 font-mono text-[11px] uppercase leading-[1.65] tracking-[0.06em] text-panel-accent">
          A sample site. The practice, the doctor and every number in it are invented.
        </p>
      )}
      {cs.data.url && (
        <p class="mt-7">
          <a href={cs.data.url} rel="noopener" class="btn-accent px-6 py-3.5 text-[16px]">
            {cs.data.demo ? 'Open the sample site ↗' : 'Visit the live site ↗'}
          </a>
        </p>
      )}

      <figure slot="aside" class="m-0">
        <Image
          src={cs.data.cover}
          alt={cs.data.coverAlt}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 400px, 92vw"
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-3xl border border-panel-line bg-panel-card"
        />
        <figcaption class="mt-3 font-mono text-[11px] uppercase leading-[1.6] tracking-[0.06em] text-panel-text-faint">
          The live site: not a mockup.
        </figcaption>
      </figure>
    </PageHero>

    {cs.data.problem && (
      <section class="band-powder" aria-labelledby="problem-title">
        <div class="section shell grid gap-10 lg:grid-cols-[280px_1fr] lg:gap-20">
          <p class="label-mono text-surgical" style="letter-spacing:0.12em">Before the build</p>
          <div class="max-w-[720px]">
            <h2
              id="problem-title"
              class="text-[clamp(26px,3.4vw,38px)] font-extrabold leading-[1.12] tracking-[-0.035em] text-ink"
            >
              {cs.data.problem.heading}
            </h2>
            <p class="mt-5 text-[18px] leading-[1.7] text-ink/90">{cs.data.problem.body}</p>
          </div>
        </div>
      </section>
    )}

    <div class="band-mist">
      <div class="section shell grid items-start gap-14 lg:grid-cols-[1fr_360px] lg:gap-20">
        <div class="prose-ci">
          <Content />
        </div>
        <aside class="top-24 rounded-3xl border border-line bg-canvas p-7 lg:sticky">
          <h2 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">Chart, key figures</h2>
          <dl class="grid gap-5">
            {cs.data.highlights.map((h) => (
              <div class="border-b border-hairline pb-4 last:border-b-0 last:pb-0">
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-[24px] font-extrabold tracking-[-0.04em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </div>

    {/* Screenshots with the reasoning attached. A gallery of pretty pages
        proves nothing on its own; what a clinic owner is buying is the
        thinking, so every shot carries the decision it illustrates. */}
    {cs.data.gallery && cs.data.gallery.length > 0 && (
      <section class="section shell" aria-labelledby="gallery-title">
        <SectionHead
          id="gallery-title"
          label="Inside the build"
          title="Three decisions, and what they look like"
          lede="Every screenshot below is the live site. The note beside each one is why it was built that way rather than the obvious way."
        />
        <div class="reveal-group mt-13 grid gap-14">
          {cs.data.gallery.map((shot, i) => (
            <figure
              class:list={[
                'm-0 grid items-center gap-8 lg:gap-14',
                shot.phone ? 'lg:grid-cols-[260px_1fr]' : 'lg:grid-cols-[1.35fr_1fr]',
                i % 2 === 1 && 'lg:[&>figcaption]:order-first',
              ]}
            >
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={shot.phone ? [260, 520] : [640, 960, 1280]}
                sizes={shot.phone ? '260px' : '(min-width: 1024px) 760px, 92vw'}
                loading="lazy"
                class:list={[
                  'w-full rounded-2xl border border-line bg-surface',
                  /* A full phone capture is twice as tall as it is wide, which
                     leaves the row half empty beside a three-line caption.
                     Cropping to the top keeps the part that carries the point. */
                  shot.phone && 'max-h-[420px] object-cover object-top',
                ]}
              />
              <figcaption>
                <h3 class="text-[22px] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">
                  {shot.title}
                </h3>
                <p class="mt-3 text-[16px] leading-[1.7] text-body">{shot.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>

  <CtaPanel prefill="work" nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
