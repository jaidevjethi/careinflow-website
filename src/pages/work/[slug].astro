---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { getImage } from 'astro:assets';
import { CANONICAL_HOST } from '@/config/site';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  caseStudySchema,
} from '@/lib/schema';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.id },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);

const path = `/work/${cs.id}`;
const title = `${cs.data.client} — case study | CareInflow`;
const description = cs.data.description;

/**
 * The real screenshot doubles as the share card and the Article image, so a
 * case study previews as the site it is about rather than the default card.
 */
const share = await getImage({ src: cs.data.cover, width: 1200, format: 'jpg' });
const shareImage = {
  url: new URL(share.src, CANONICAL_HOST).href,
  width: Number(share.attributes.width ?? 1200),
  height: Number(share.attributes.height ?? 630),
  alt: cs.data.coverAlt,
};

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path, title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: cs.data.client, path },
  ]),
  caseStudySchema({
    path,
    title: cs.data.title,
    description,
    client: cs.data.client,
    year: cs.data.year,
    image: shareImage,
    ...(cs.data.url ? { liveUrl: cs.data.url } : {}),
  }),
);
---

<BaseLayout
  {title}
  {description}
  {path}
  {schema}
  image={shareImage.url}
  imageAlt={cs.data.coverAlt}
>
  <article>
    <PageHero
      breadcrumb={{ label: 'All work', href: href('/work') }}
      label={`${cs.data.sector} · ${cs.data.year}`}
      title={cs.data.title}
      lede={cs.data.summary}
      stats={cs.data.highlights.slice(0, 4).map((h) => ({ value: h.value, caption: h.ref ? `${h.label} — ${h.ref}` : h.label }))}
    >
      <p class="mt-6 text-base font-semibold text-panel-text">
        {cs.data.client} · {cs.data.location}
      </p>
      {!cs.data.healthcare && (
        <p class="mt-4">
          <span class="chip border border-panel-line bg-panel-card text-panel-text">
            Not a clinic — included honestly, to show the same method elsewhere
          </span>
        </p>
      )}
      {cs.data.url && (
        <p class="mt-7">
          <a href={cs.data.url} rel="noopener" class="btn-accent px-6 py-3.5 text-[15px]">
            Visit the live site ↗
          </a>
        </p>
      )}

      <figure slot="aside" class="m-0">
        <Image
          src={cs.data.cover}
          alt={cs.data.coverAlt}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 400px, 92vw"
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-3xl border border-panel-line bg-panel-card"
        />
        <figcaption class="mt-3 font-mono text-[11px] uppercase leading-[1.6] tracking-[0.06em] text-panel-text-faint">
          The live site — not a mockup.
        </figcaption>
      </figure>
    </PageHero>

    <div class="band-mist">
      <div class="section shell grid items-start gap-14 lg:grid-cols-[1fr_360px] lg:gap-20">
        <div class="prose-ci">
          <Content />
        </div>
        <aside class="top-24 rounded-3xl border border-line bg-canvas p-7 lg:sticky">
          <h2 class="label-mono mb-5 text-faint" style="letter-spacing:0.12em">Chart — key figures</h2>
          <dl class="grid gap-5">
            {cs.data.highlights.map((h) => (
              <div class="border-b border-hairline pb-4 last:border-b-0 last:pb-0">
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-[24px] font-extrabold tracking-[-0.04em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </div>
  </article>

  <CtaPanel prefill="work" nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
