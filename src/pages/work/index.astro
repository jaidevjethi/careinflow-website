---
import { getCollection } from 'astro:content';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ClientCard from '@/components/ClientCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { CONTENT_CLIENTS } from '@/config/clients';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  itemListSchema,
} from '@/lib/schema';

const title = 'Clinic Website Examples and Healthcare Content | CareInflow';
const description =
  'Work for three Mehsana practices: a live bilingual dental clinic website and Google listing, and reels and posts for two clinics. Plus three labelled samples.';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const realBuilds = caseStudies.filter((cs) => !cs.data.demo);
const samples = caseStudies.filter((cs) => cs.data.demo);

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/work', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Portfolio', path: '/work' },
  ]),
  itemListSchema({
    path: '/work',
    name: 'CareInflow case studies',
    items: caseStudies.map((cs) => ({ name: cs.data.title, path: `/work/${cs.id}` })),
  }),
);
---

<BaseLayout {title} {description} path="/work" {schema}>
  <PageHero
    label="Portfolio"
    title="The work is live. Open it yourself."
    lede="Three practices in Mehsana work with CareInflow: one website we built and keep up, with its Google listing, and two Instagram accounts we make reels and posts for. Below them are three sample websites, built to show a clinic what it receives. Each sample says so at the top of its own page."
    stats={[
      { value: 'Live', caption: 'open every one on your own phone' },
      { value: 'Healthcare', caption: 'the only work this studio takes' },
      { value: 'Fixed', caption: 'price agreed before anything starts' },
    ]}
  />

  {/*
    REAL WORK AND SAMPLES ARE NEVER MIXED. They were four equal cards in one
    grid, one real and three samples, told apart only by a chip. Now each has
    its own section: the real work first and larger, the samples after it,
    smaller and introduced as what they are.

    The real build's full card sits beside the two content clients' text
    cards. Text, because a content client's work is their own Instagram, and a
    screenshot of someone else's account is not ours to publish until they
    say so (docs/context/proof-library.md).
  */}
  <section class="band-powder" aria-labelledby="clients-title">
    <div class="section shell">
      <SectionHead
        id="clients-title"
        label="Client work"
        title="Three practices in Mehsana, and what each trusted to us."
        lede="A website and its Google listing for one. Reels and posts for the other two. Every card links to the work itself."
      />
      <div class="mt-10 grid items-stretch gap-6 lg:grid-cols-[1.35fr_1fr]">
        {realBuilds.map((cs) => (
          <CaseStudyCard study={cs} headingLevel="h3" layout="feature" />
        ))}
        <div class="grid gap-6 lg:grid-rows-2">
          {CONTENT_CLIENTS.map((c) => <ClientCard client={c} />)}
        </div>
      </div>
    </div>
  </section>

  {/*
    THE SAMPLES, AS THUMBNAILS. Three columns from lg because there are three:
    the column count has to divide the item count (CLAUDE.md), and a fourth
    sample means revisiting it. Stacked below lg, where a third of the width is
    narrower than a cover and a name survive. `layout="third"` is what tells
    the cover its real width.
  */}
  <section class="bg-surface" aria-labelledby="samples-title">
    <div class="section shell">
      <SectionHead
        id="samples-title"
        label="Samples"
        title="Three sample websites you can open."
        lede="No business is behind any of them. Each was invented in full and built to show a clinic exactly what it receives, and each says so at the top of its own page. One is deliberately not healthcare."
      />
      <div class="reveal-group mt-10 grid items-stretch gap-6 lg:grid-cols-3">
        {samples.map((cs) => (
          <CaseStudyCard study={cs} compact heading="client" headingLevel="h3" layout="third" />
        ))}
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="max-w-[720px] rounded-3xl border border-line bg-canvas p-8">
      <h2 class="label-mono mb-4 text-faint">What would yours involve?</h2>
      <p class="text-[16px] leading-[1.65] text-body">
        Every website build runs the same way: one fixed price agreed in writing
        before anything starts, the person building your site on the other end
        of WhatsApp, and a written record when it launches. Content is simpler
        still: send one sample video and we reply with what the edit involves,
        how long it takes and what it costs. The
        <a href={href('/process')} class="prose-link">method page</a> shows how a
        four-week build runs, the
        <a href={href('/services/healthcare-content')} class="prose-link">healthcare content page</a>
        how a month of reels does, and the
        <a href={href('/about')} class="prose-link">about page</a> who is behind both.
      </p>
    </div>
  </section>

  <CtaPanel prefill="work" nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
