---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  itemListSchema,
} from '@/lib/schema';

const title = 'Work, real projects, shown honestly | CareInflow';
const description =
  'Selected work by CareInflow: a bilingual dental clinic website in Mehsana and a search-focused services site. Real projects only: no padded portfolio.';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/work', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
  ]),
  itemListSchema({
    path: '/work',
    name: 'CareInflow case studies',
    items: caseStudies.map((cs) => ({ name: cs.data.title, path: `/work/${cs.id}` })),
  }),
);
---

<BaseLayout {title} {description} path="/work" {schema}>
  <PageHero
    label="Our work"
    title="A short portfolio, shown honestly."
    lede="A short page, and everything on it is real, no padded portfolio, no screenshots of work we did not do. As new practices launch, we publish what happened for each one, including what did not work."
    stats={[
      { value: String(caseStudies.length), caption: 'projects, all of them real' },
      { value: String(caseStudies.filter((c) => c.data.healthcare).length), caption: 'in healthcare' },
      { value: '0', caption: 'mockups presented as clients' },
    ]}
  />

  {/* The healthcare work leads at full width; the non-healthcare project sits
      under it, narrower. Side by side and identically sized, a visitor counting
      cards saw half the portfolio outside healthcare, three lines under a
      homepage that says we do healthcare and nothing else. It is still here and
      still labelled, just no longer weighted like the flagship. */}
  <section class="band-powder" aria-label="Case studies">
    <div class="section shell grid gap-8">
      {caseStudies.map((cs) => (
        <a
          href={href(`/work/${cs.id}`)}
          class:list={[
            'card-hover flex flex-col overflow-hidden rounded-3xl border border-line bg-canvas hover:no-underline',
            !cs.data.healthcare && 'lg:max-w-[760px]',
          ]}
        >
          <Image
            src={cs.data.cover}
            alt={cs.data.coverAlt}
            widths={[520, 780, 1040]}
            sizes="(min-width: 1024px) 620px, 92vw"
            loading="lazy"
            class="w-full border-b border-line bg-surface"
          />
          <div class="flex flex-1 flex-col p-8">
          <p class="mb-5 flex flex-wrap items-center gap-2">
            <span class="chip border border-line bg-surface text-body-deep">{cs.data.sector}</span>
            {!cs.data.healthcare && <span class="chip bg-hairline-soft text-muted">Non-healthcare</span>}
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{cs.data.year}</span>
          </p>
          <h2 class="text-[clamp(22px,2.4vw,28px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-ink">
            {cs.data.title}
          </h2>
          <p class="mt-2 text-[15px] font-semibold text-muted">{cs.data.client} · {cs.data.location}</p>
          <p class="mt-4 text-[16px] leading-[1.65] text-body">{cs.data.summary}</p>
          <dl class="mt-auto grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 sm:grid-cols-4">
            {cs.data.highlights.map((h) => (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-lg font-extrabold tracking-[-0.03em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
          <p class="prose-link mt-6 text-[16px]">Read the case study →</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section shell">
    <div class="max-w-[680px] rounded-3xl border border-line bg-surface p-8">
      <h2 class="label-mono mb-4 text-faint">How we work</h2>
      <p class="text-[16px] leading-[1.65] text-body">
        Every engagement runs the same way: a fixed price in writing, direct
        access to the person doing the work, and a published record
        afterwards. The <a href={href('/about')} class="prose-link">about page</a>
        explains who is behind the work, and the
        <a href={href('/process')} class="prose-link">method page</a> shows how a
        four-week build runs.
      </p>
    </div>
  </section>

  <CtaPanel prefill="work" nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
