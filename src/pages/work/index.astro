---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { href } from '@/lib/url';
import {
  graph,
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  itemListSchema,
} from '@/lib/schema';

const title = 'Clinic websites we have built, live and open | CareInflow';
const description =
  'Healthcare websites built by CareInflow: a bilingual dental clinic in Mehsana, a dermatology sample, and a services site. Open each one and time it yourself.';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const schema = graph(
  organizationSchema(),
  webSiteSchema(),
  webPageSchema({ path: '/work', title, description, type: 'CollectionPage' }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
  ]),
  itemListSchema({
    path: '/work',
    name: 'CareInflow case studies',
    items: caseStudies.map((cs) => ({ name: cs.data.title, path: `/work/${cs.id}` })),
  }),
);
---

<BaseLayout {title} {description} path="/work" {schema}>
  <PageHero
    label="Our work"
    title="Open the work. Do not take our word for any of it."
    lede="Every site on this page is live right now. Open one on your phone, time how long it takes to appear, tap the WhatsApp button and watch where the message goes. Two were built for real practices. The third is a sample, built to show a clinic exactly what it receives, and it says so on its own page."
    stats={[
      { value: 'Live', caption: 'open every one on your own phone' },
      { value: 'Healthcare', caption: 'the only work this studio takes' },
      { value: 'Fixed', caption: 'price agreed before anything starts' },
    ]}
  />

  {/*
    Three identical cards in three columns.

    Two earlier arrangements were wrong in the same way. Giving the flagship
    full width and the others `max-w-[760px]` left ~500px of dead ground down
    the page; pairing two under a full-width lead fixed the ragged edge but
    still sized the cards by how important we consider each project, which is
    a judgement a visitor has not asked for. Equal cards let the work argue
    for itself, and the eye can compare three things at one size.

    Three into three columns divides evenly, which is the grid rule here — the
    alternative of two columns would strand the third on its own row and read
    as a page that ran out. Below lg they stack; three columns at tablet width
    leaves ~210px per card, which is narrower than this content can survive.

    Card heights match because the grid stretches every item in a row and each
    card is a flex column with `mt-auto` on the measurements, so the numbers
    and the link sit on a shared baseline however long a summary runs.
  */}
  <section class="band-powder" aria-label="Case studies">
    <div class="section shell grid items-stretch gap-6 lg:grid-cols-3">
      {caseStudies.map((cs) => (
        <a
          href={href(`/work/${cs.id}`)}
          class="card-hover flex flex-col overflow-hidden rounded-3xl border border-line bg-canvas hover:no-underline"
        >
          {/*
            `sizes` has to describe the box the image actually fills. It once
            said 620px while the card rendered it at 1263px, so the browser
            fetched a 620px variant and stretched it 2.04x — the portfolio's
            most important screenshot served at half resolution. One card width
            now means one honest `sizes` for all three.
          */}
          <Image
            src={cs.data.cover}
            alt={cs.data.coverAlt}
            widths={[420, 640, 840]}
            sizes="(min-width: 1024px) 405px, 92vw"
            loading="lazy"
            class="h-[230px] w-full border-b border-line bg-surface object-cover object-top"
          />
          <div class="flex flex-1 flex-col p-6 sm:p-7">
          <p class="mb-4 flex flex-wrap items-center gap-2">
            <span class="chip border border-line bg-surface text-body-deep">{cs.data.sector}</span>
            {cs.data.demo && (
              <span class="chip border border-surgical/40 bg-surgical-tint text-surgical">Sample</span>
            )}
            {/* No separate "Non-healthcare" chip: the sector chip beside it
                already reads "Travel services (non-healthcare)", so the row
                said it twice and wrapped to two lines, dropping that card's
                headline 36px below the other two. Measured, not guessed. */}
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{cs.data.year}</span>
          </p>
          <h2 class="text-[clamp(20px,1.7vw,23px)] font-extrabold leading-[1.18] tracking-[-0.03em] text-ink">
            {cs.data.title}
          </h2>
          <p class="mt-2 text-[14px] font-semibold text-muted">{cs.data.client} · {cs.data.location}</p>
          <p class="mt-3.5 text-[15px] leading-[1.6] text-body">{cs.data.summary}</p>
          <dl class="mt-auto grid grid-cols-2 gap-x-5 gap-y-4 border-t border-line pt-6">
            {cs.data.highlights.map((h) => (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{h.label}</dt>
                <dd class="mt-1 text-[17px] font-extrabold leading-[1.2] tracking-[-0.03em] text-ink">{h.value}</dd>
                {h.ref && <dd class="mt-0.5 font-mono text-[11px] uppercase leading-[1.5] tracking-[0.06em] text-muted">{h.ref}</dd>}
              </div>
            ))}
          </dl>
          <p class="prose-link mt-6 text-[16px]">Read the case study →</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section shell">
    <div class="max-w-[680px] rounded-3xl border border-line bg-surface p-8">
      <h2 class="label-mono mb-4 text-faint">What yours would involve</h2>
      <p class="text-[16px] leading-[1.65] text-body">
        Every build runs the same way: one fixed price agreed in writing before
        anything starts, the person building your site on the other end of
        WhatsApp, and a written record when it launches. Four weeks, and the
        study in the first week is free whether or not you go ahead.
        The <a href={href('/about')} class="prose-link">about page</a>
        explains who is behind the work, and the
        <a href={href('/process')} class="prose-link">method page</a> shows how a
        four-week build runs.
      </p>
    </div>
  </section>

  <CtaPanel prefill="work" nextStep={{ label: 'See what it costs', href: '/pricing' }} />
</BaseLayout>
